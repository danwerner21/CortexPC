bc.o: bc.c
	${CC} -D${MODEL} ${DEBUG} -I../../v6 -c bc.c
dc.o: dc.c dc.h
	${CC} -D${MODEL} ${DEBUG} -I../../v6 -c dc.c

bc.c: bc.y
	${YACC} bc.y
	cp y.tab.c bc.c
	rm y.tab.c

egrep.c: egrep.y
	${YACC} egrep.y
	cp y.tab.c egrep.c
	rm y.tab.c

find.o: find.c
grep.o: grep.c
icheck.o: icheck.c
idate.o: idate.c
kill.o: kill.c
ln.o: ln.c
login.o: login.c
ls.o: ls.c
mail.o: mail.c
man.o: man.c
mkdir.o: mkdir.c
mv.o: mv.c
ncheck.o: ncheck.c
newgrp.o: newgrp.c
nice.o: nice.c
nm.o: nm.c

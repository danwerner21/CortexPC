MODEL	= TI990

CC	= cc
CFLAGS	= -O -D${MODEL} ${DEBUG} -I../../v6
YACC	= yacc

EXES = ac basename bc cal cat chgrp chk chmod chown clri cmp col comm cp date \
	dcheck dd df diff du echo ed egrep fgrep file find grep icheck idate \
	kill ln login ls mail man mkdir mv ncheck newgrp nice nm od passwd \
	pr prof ps pwd reloc rev rm rmdir sh size sleep sort split strip \
	stty sum sync tail tar tee time touch tr tty uname uniq wc who

all: ${EXES}

clean:
	/bin/rm -f *.o ${EXES}

ac: ac.o
	${CC} ${DEBUG} -o ac ac.o
basename: basename.o
	${CC} ${DEBUG} -o basename basename.o
bc: bc.o
	${CC} ${DEBUG} -o bc bc.o
cal: cal.o
	${CC} ${DEBUG} -o cal cal.o
cat: cat.o
	${CC} ${DEBUG} -o cat cat.o

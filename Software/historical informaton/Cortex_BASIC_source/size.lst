             80  *
             81  * MOVE STRING ROUTINES - NULL TERMINATOR
             82  *
             83  *       BL @MOVEB       MOVE INTO IOB
             84  *       BL @MOVEL       MOVE INTO R7
             85  *
             86  *       IN  0(11) = STRING
             87  *              R7 = OBC
             88  *       OUT    R7 = UPDATED OBC
             89  *
008A C1E0    90  MOVEB  MOV  @IOB,R7           GET BUFFER ADR
008C 002C'
008E DDFB    91  MOVEL  MOVB *R11+,*R7+        MOVE CHARACTER
0090 16FE    92         JNE  $-2               UNTIL NULL
0092 0607    93  NTERM  DEC  R7                BACKUP OVER NULL
             94  *
             95  * FORCE THE RETURN ADDRESS TO AN EVEN WORD BOUNDARY
             96  *
0094 058B    97  EVENRT INC  R11
0096 024B    98         ANDI R11,>FFFE
0098 FFFE 
009A 045B    99         RT
            100  *
            101  * MOVE STRING ROUTINES  - NULL/NEGATED CHARACTER TERMINATION
            102  *
            103  *       BL @MOVEBN      MOVE INTO IOB
            104  *       BL @MOVELN      MOVE INTO R7
            105  *
            106  *       IN  0(11) = STRING
            107  *              R7 = OBC
            108  *       OUT    R7 = UPDATED OBC
            109  *
009C C1E0   110  MOVEBN MOV  @IOB,R7           GET BUFFER ADR
009E 008C'
00A0 DDFB   111  MOVELN MOVB *R11+,*R7+        MOVE CHARACTER
00A2 13F7   112         JEQ  NTERM             NULL, TERMINATE
00A4 15FD   113         JGT  MOVELN            +VE, CONTINUE COPY
            114  * R7 NOW POINTS TO THE BYTE AFTER THE STRING END
00A6 C80B   115         MOV  R11,@RTSTOR       SAVE R11
00A8 0000 
00AA 04CB   116         CLR  R11               READY R11
00AC D2E7   117         MOVB @-1(R7),R11       GET BACK THE CHARACTER
00AE FFFF 
00B0 050B   118         NEG  R11               NEGATE IT TO GET REAL VALUE
00B2 D9CB   119         MOVB R11,@-1(R7)       RE-STORE IT
00B4 FFFF 
00B6 C2E0   120         MOV  @RTSTOR,R11       GET RETURN ADDRESS
00B8 00A8'
00BA 10EC   121         JMP  EVENRT            EXIT
            122         END

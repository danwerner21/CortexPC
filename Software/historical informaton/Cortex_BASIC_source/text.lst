            152  ***********************************************************
            153  ***********************************************************
            154  ***********************************************************
            155  ***                                                     ***
            156  ***                   W A R N I N G                     ***
            157  ***                 =================                   ***
            158  ***                                                     ***
            159  ***  THE AREA BETWEEN 'TMPBUF' AND 'TBEND' IS USED      ***
            160  ***  DURING NORMAL PROGRAM EXECUTION. ACCESS TO THIS    ***
            161  ***  AREA MUST THEREFORE BE MADE WITH THE EPROM TURNED  ***
            162  ***  ON.                                                ***
            163  ***                                                     ***
            164  ***********************************************************
            165  ***********************************************************
            166  ***********************************************************
            167  *
     0131'  168  TMPBUF EQU  $                 <====== START OF SCRATCH AREA
            169  *
0132 0000   170  PTRTBL DATA P$IOB,P$EUS,P$FNS,P$GSS,P$UFT
            171  ************************************************************
            172  *                                                          *
            173  *                 SYSTEM COLDSTART                         *
            174  *                                                          *
            175  ************************************************************
            176  *
            177  *    THIS ROUTINE MUST :-
            178  *      1.   CHECKSUM THE EPROMS TO MAKE SURE THEY ARE OK
            179  *      2.   COPY THE EPROMS INTO RAM AND TURN THEM OFF
            180  *      3.   RESET THE KEYBOARD INTERRUPT LATCH
            181  *      4.   INITIALISE THE MEMORY MAPPER REGISTERS
            182  *      5.   AUTOSIZE THE RAM
            183  *
            184  *
            185  ************************************************************
            186  *                                                          *
            187  *      CHECKSUM THE EPROMS AND GENERATE A SYSTEM           *
            188  *      CRASH IF THIS FAILS. THIS ALSO COPIES THE           *
            189  *      EPROMS INTO RAM.                                    *
            190  *                                                          *
            191  ************************************************************
     013C'  192  START  EQU  $                 RESET ENTRY POINT
013C 04C1   193         CLR  R1                START FROM 0
013E 0202   194         LI   R2,CHKWRD         POINT TO THE CHECKWORD
0140 016E'
0142 C002   195         MOV  R2,R0             INITIALISE CHECKSUM
0144 C101   196  L0     MOV  R1,R4             SAVE THE COPY POINTER
0146 0244   197         ANDI R4,>FFFE          KILL LS BIT
0148 FFFE 
014A 8084   198         C    R4,R2             ARE WE AT THE CHECKWORD?
014C 1305   199         JEQ  L2                Y, DONT ADD IT IN
014E B811   200         AB   *R1,@WP10L        ADD INTO R0 LSB
0150 0000 
0152 1C01   201         JOP  L1                ODD PARITY, MODIFY CHECKWORD
0154 2801   202         XOR  R1,R0             MODIFY THE CHECKSUM
0156 0B00   203  L1     SRC  R0,0              FRIG THE CHECKWORD
0158 DC51   204  L2     MOVB *R1,*R1+          COPY THE ROM WORD INTO RAM
015A 0281   205         CI   R1,>6000          DONE?
015C 6000 
015E 1AF2   206         JL   L0                N, LOOP
0160 04C1   207         CLR  R1
ASM990 2.4.6     TEXT                       Sun Aug 10 23:07:36 2025 Page 0008
TEXT & CONSTANTS - CORTEX BASIC REV. 1.1

            208X        ASMIF PIO
            209X        LI   R12,2*PIO         POINT TO PARALLEL I/O
            210         ASMELS
0162 04CC   211         CLR  R12
            212         ASMEND
0164 8480   213         C    R0,*R2            DOES IT MATCH?
0166 1304   214         JEQ  RAMST             Y, GO TURN ROM OFF <<<<<<<
0168 1D06   215         SBO  BELLON-PIO        N, TURN THE BELL ON
016A 0460   216         B    @CRASH$               GO DIE!!!!
016C 0000 
016E 1B70   217  CHKWRD DATA >1B70             REV 1.1  CHECSUM WORD
            218  ************************************************************
            219  *                                                          *
            220  *      RESET THE I/O  AND TURN THE ROMS OFF                *
            221  *                                                          *
            222  ************************************************************
0170 0200   223  RAMST  LI   R0,>0360               R0='RSET'
0172 0360 
0174 0201   224         LI   R1,>1D00+(KBDACK-PIO)  R1='SBO KBDACK-PIO'
0176 1D01 
0178 0202   225         LI   R2,>1D00+(ROMON-PIO)   R2='SBO ROMON-PIO'
017A 1D05 
017C 0203   226         LI   R3,>045B               R3='RT'
017E 045B 
0180 0680   227         BL   R0                TURN OFF EPROMS
            228  ************************************************************
            229  *                                                          *
            230  *      NOW INITIALISE THE MAPPER & SET CONFIG FLAGS        *
            231  *                                                          *
            232  ************************************************************
0182 0207   233         LI   R7,>0001          SET FOR MAPPER PRESENT
0184 0001 
0186 020C   234         LI   R12,MAPPER        POINT TO THE MAPPER
0188 F100 
018A 0708   235         SETO R8                FUDGE FOR NEXT INSTRUCTION
018C 0588   236  SETMAP INC  R8                NEXT REGISTER
018E CF08   237         MOV  R8,*R12+          INIT. REGISTER
0190 06C8   238         SWPB R8                TEST JUST IT'S MSB
0192 922C   239         CB   @-1(12),R8        WAS IT WRITTEN OK?
0194 FFFF 
0196 1301   240         JEQ  MAPOK             Y, LEAVE MAPPER FLAG
0198 04C7   241         CLR  R7                N, RESET MAPPER FLAG
019A 06C8   242  MAPOK  SWPB R8                RESTORE R8
019C 028C   243         CI   R12,M$REGF        HAVE WE DONE WITH THE MAPPER?
019E F11E 
01A0 12F5   244         JLE  SETMAP            N, LOOP
01A2 C807   245  NOPOP  MOV  R7,@CONFIG        SETUP CONFIGURATION FLAGS
01A4 0000 
            246  ************************************************************
            247  *                                                          *
            248  *                     AUTO-SIZE RAM                        *
            249  *                                                          *
            250  ************************************************************
01A6 02A2   251         STWP R2                GET START OF AUTOSIZE
01A8 0204   252         LI   R4,>AAAA          SET TEST PATTERN
01AA AAAA 
01AC 0205   253         LI   R5,PRAM           SET PRAM POINTER
01AE 0000 
01B0 0642   254  START1 DECT R2                BACKUP POINTER
01B2 C484   255         MOV  R4,*R2            WRITE
ASM990 2.4.6     TEXT                       Sun Aug 10 23:07:36 2025 Page 0009
TEXT & CONSTANTS - CORTEX BASIC REV. 1.1

01B4 8484   256         C    R4,*R2            O.K. ?
01B6 1605   257         JNE  START6            N, END OF RAM
01B8 04D2   258         CLR  *R2               CLEAR RAM
01BA 0282   259         CI   R2,BRAM           DOWN TO INTERPRETER
01BC 0000 
01BE 1BF8   260         JH   START1            N, CONTINUE
01C0 0642   261         DECT R2
            262  ************************************************************
            263  *                                                          *
            264  *                 INITIALIZE SYSTEM POINTERS               *
            265  *                                                          *
            266  ************************************************************
            267  *
            268  *       R2=BRAM-2
            269  *       R5=PRAM
            270  *
01C2 0201   271  START6 LI   R1,IOB            GET POINTER
01C4 0000 
01C6 0205   272         LI   R5,PTRTBL         REF THE SYSTEM PTR TABLE
01C8 0132'
01CA C802   273         MOV  R2,@MEMSIZ         ;SAVE MEMORY SIZE
01CC 0000 
01CE 0222   274         AI   R2,1024            ;RESERVE ROOM FOR HEADER BLOC
01D0 0400 
            275  *                                    AND USER AREA
01D2 CC75   276         MOV  *R5+,*R1+          ;SAVE IOB
01D4 CC75   277         MOV  *R5+,*R1+          ;SAVE EUS
01D6 CC75   278         MOV  *R5+,*R1+          ;SAVE FNS
01D8 CC75   279         MOV  *R5+,*R1+          ;SAVE GSS
01DA CC55   280         MOV  *R5,*R1+           ;SAVE UFT
01DC CC42   281         MOV  R2,*R1+            ;SAVE BUS
01DE CC42   282         MOV  R2,*R1+            ;SAVE EORBUS
            283  ************************************************************
            284  *                                                          *
            285  *      INITIALISE ALL 9902'S FOR 300 BAUD OPERATION        *
            286  *                                                          *
            287  ************************************************************
01E0 0207   288         LI   R7,DEVTBL         REF. DEVICE TABLE
01E2 0000 
01E4 0202   289         LI   R2,>04D0          SET TO 300 BAUD
01E6 04D0 
            290  *
01E8 0287   291  NXTDEV CI   R7,DTEND          DONE ALL ENTRIES
01EA 0000 
01EC 140E   292         JHE  SETUP             Y, SET SYSTEM POINTERS
01EE C337   293         MOV  *R7+,R12          N,GET ENTRY
01F0 2320   294         COC  @C1,R12           LS BIT SET?
01F2 0000 
01F4 16F9   295         JNE  NXTDEV            N, NOT A 9902
01F6 024C   296         ANDI R12,>7FFE         KILL OFF LS & MS BITS
01F8 7FFE 
01FA 1F12   297         TB   18                IS IT INSTALLED
01FC 1303   298         JEQ  NODEV             N, DELETE TABLE ENTRY
01FE 06A0   299         BL   @SRATE            Y, INITIALISE IT
0200 0000 
0202 10F2   300         JMP  NXTDEV            DO NEXT DEVICE
            301  *
0204 04E7   302  NODEV  CLR  @-2(R7)           DELETE TABLE ENTRY
0206 FFFE 
0208 10EF   303         JMP  NXTDEV            DO NEXT DEVICE

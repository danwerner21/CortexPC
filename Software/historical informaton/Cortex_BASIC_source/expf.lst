EXP FUNCTION - CORTEX BASIC REV. 1.1

              2         IDT  'EXPF'
              3  *
              4  *       EXPF            ;EXPONENTIAL FUNCTION
              5  *
              6         REF  FUNFX             ;FIXES ARGUMENT
              7         REF  PLYX,PLYXX        ;EVALUATE POLYNOMIALS
              8         REF  FUNBK             ;BREAK FP #
              9         REF  GETP2             ;GET POWER OF 2
             10         REF  FPAC              ;FLOATING POINT ACCUMULATOR
             11         REF  TEMP              ;3 WRD TEMPORARY STORAGE
             12         REF  DS1               ;3 WRD TEMPORARY STORAGE
             13         REF  DS                ;3 WRD TEMPORARY STORAGE
             14         DEF  EXPF
             15  *
             16         DXOP LOADF,0           ;LOAD FPAC
             17         DXOP STORE,1           ;STORE FPAC
             18         DXOP FADD,2            ;ADD TO FPAC
             19         DXOP FSUB,3            ;SUBTRACT FROM FPAC
             20         DXOP FMUL,4            ;MULTIPLY FPAC
             21         DXOP FDIV,5            ;DIVIDE FPAC
     2F80    22  ERROR  EQU  >2F80             ;XOP XX,14  (ERROR CALL)
     2FA0    23  ERROR2 EQU  ERROR+>20

ASM990 2.4.6     RUN                        Sun Aug 10 23:07:35 2025 Page 0001
RUN COMMAND - CORTEX BASIC REV 1.1

              2         IDT  'RUN'
              3  *
              4  * THIS MODULE CAUSES THE STORED BASIC PROGRAM TO BE
              5  * INTERPRETED. ON ENTRY IT CAUSES THE USER VARIABLE
              6  * SPACE TO BE CLEARED.
              7  *
              8  * A LIST OF ALL BASIC STATEMENT ENTRY POINTS IS MAINTAINED
              9  * IN THIS MODULE.
             10  *
             11  * ALSO CONTAINED ARE THE ROUTINES: CLRV (CLEAR USER VARIABLE
             12  * SPACE), REST (RESET THE DLC AND DDM SYSTEM POINTERS) AND
             13  * THE BASIC STATEMENT HANDLER 'ELSE'.
             14  *
             15         DEF  LINE,LINE0,LINE2,LINE5
             16         DEF  NLIN,NLIN0,RUNP,RUNP1,CLRV,REST
             17         DEF  NXTXB,DATXB
             18         REF  B2E,PLF,ESCFLG,POPY,ENTERY
             19         REF  MAGY,LST,BAUD,GOTY
             20         REF  EXTNDY
             21         REF  SLN,RENUMS,BASY,BITY,CLLY,CRBY
             22         REF  SGETY,SPUTY,CRFY,DEFY,DIMY
             23         REF  SPRITY,SHAPEY,ERRY,ESCY,FORY
             24         REF  BOOTY,GOSY,IFY,INPY,LDPY
             25         REF  SWAPY,LETY,MEMY,NEWY,NOEY
             26         REF  NXTY,ONY,PRTY
             27         REF  RANY,RDDY,RNWY,RTNY
             28         REF  SAVY,STPY,TIMY,UNTY
             29         REF  MOTORY,RANDS
             30         REF  NUMY,PLOTY,UPLOTY,COLORY
             31         REF  GRAPHY,TEXTY,WAITY,LDCSY
             32         REF  CRLF,TYPC$,STPYA,MWDY
             33         REF  NVS,GSS,VNT,VDT,DDM,DLC,GSC
             34         REF  BUS,DLIM,MODE,PLC,SLT,ELSF
             35         REF  PURGY,STACNT,IOB,R8STOR,TRAFLG
             36         REF  TOFY,TONY,TYPBE$,MOVEB,MOVEL
             37         REF  F$WHO
             38  *
             39  * XOP EQUATES
             40  *
     2F80    41  ERROR  EQU  >2F80
     2FA0    42  ERROR2 EQU  ERROR+>20
             43         DXOP OUTINT,13

             45  *
             46  * CLRV - CLEAR R1 THRU EUS
             47  *
0000 C820    48  CLRV   MOV  @IOB,@NVS         ;SET NVS TO IOB POINTER
0002 0000 
0004 0000 
0006 C820    49         MOV  @GSS,@GSC         ;RESET GOSUB STACK
0008 0000 
000A 0000 
000C 04F1    50         CLR  *R1+              ;CLEAR MEMORY
000E 0281    51         CI   R1,RANDS          ;REACHED EUS YET?
0010 0000 
0012 1AFC    52         JL   $-6               ;N - BACK FOR NEXT WORD
0014 04E0    53         CLR  @R8STOR           ;CLEAR ENTER'S R8 STORE
0016 0000 
             54  *
             55  * REST - RESET DATA PTR
             56  *
0018 C820    57  REST   MOV  @VNT,@DLC         ;RESET DLC TO VNT
001A 0000 
001C 0000 
001E 04E0    58         CLR  @DDM              ;ZERO DDM
0020 0000 
0022 045B    59         RT
ASM990 2.4.6     RUN                        Sun Aug 10 23:07:35 2025 Page 0003

             61  *
             62  * RUN STATEMENT
             63  *
0024 0000    64  RUNP   DATA TYPC$             ;OUT CRLF
             65  *
0026 0720    66  RUNP1  SETO @MODE             ;SET MODE TO RUN
0028 0000 
002A 04E0    67         CLR  @ESCFLG           ;ENABLE ESCAPE
002C 0000 
002E 04E0    68         CLR  @PLF              ;FLAG AS NOT LOAD/SAVE
0030 0000 
0032 C820    69         MOV  @VNT,@PLC         ;SET PLC TO START
0034 001A'
0036 0000 
0038 C060    70         MOV  @VDT,R1           ;CLEAR VDT THRU EUS
003A 0000 
003C 06A0    71         BL   @CLRV
003E 0000'
0040 1013    72         JMP  LINE
             73  *
             74  * MULTIPLEXOR
             75  *
0042 0280    76  NLIN1  CI   R0,>3C00          ;':' ?
0044 3C00 
0046 1603    77         JNE  NLIN1A            ;N, TRY OTHER DELIMITERS
0048 05A0    78         INC  @STACNT           ;Y, COUNT
004A 0000 
004C 1021    79         JMP  LINE2             ;GET REST OF LINE
004E 0280    80  NLIN1A CI   R0,>3B00          ;'THEN' ?
0050 3B00 
0052 131E    81         JEQ  LINE2             ;Y, GET REST OF LINE
0054 0280    82         CI   R0,>4700          ;'!' ?
0056 4700 
0058 1307    83         JEQ  LINE              ;Y, NEW LINE
             84  *
005A 2FA0    85  ERR37  DATA ERROR2,37         ;N - ILLEGAL DELIMITER
             86  *
             87  * NEXT LINE OR ":
             88  *
005E D838    89  NLIN0  MOVB *R8+,@DLIM        ;SAVE & SKIP DELIMITER
0060 0000 
             90  *
0062 C020    91  NLIN   MOV  @DLIM,R0          ;LOOK AT DELIMITER
0064 0060'
0066 16ED    92         JNE  NLIN1             ;NOT EOL, CHECK IT
             93  *
             94  * NEXT LINE
             95  *
0068 C020    96  LINE   MOV  @MODE,R0          ;LOOK AT MODE
006A 0028'
006C 133F    97         JEQ  LINE3             ;IDLE - THEN FINISHED
     006E'   98  LINE5  EQU  $
006E C220    99         MOV  @PLC,R8           ;GET PROGRAM LINE COUNTER
0070 0036'
0072 0228   100         AI   R8,-4             ;MOVE TO NEXT LINE
0074 FFFC 
0076 8808   101         C    R8,@SLT           ;ANY MORE STATEMENTS?
0078 0000 
007A 1A3A   102         JL   LINE4             ;N
007C C808   103  LINE0  MOV  R8,@PLC           ;Y - UPDATE PLC

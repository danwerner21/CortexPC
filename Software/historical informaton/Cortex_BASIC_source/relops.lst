             51  * ABSTRACT:
             52  *
             53  *       PERFORM AN 'OR' OPERATION ON THE
             54  *       2 OPERANDS AND RETURN A VALUE OF
             55  *       1 FOR TRUE AND 0 FOR FALSE.
             56  *
             57  * CALLING SEQUENCE:
             58  *
             59  *       BL @ORF
             60  *
             61  *       IN (R1) = OPERAND 1
             62  *          (R2) = OPERAND 2
             63  *
             64  *       OUT (R2) = 1 OR 0 IN FPAC
             65  *
             66  *      NORMAL EXIT - RETURN
             67  *
             68  *
             69  *OR OPERATOR
             70  *
001C 2E00    71  ORF    CLEAR 0                ;CLEAR FPAC
001E C0F1    72         MOV  *R1+,R3
0020 16F8    73         JNE  ANDF2             ;RESULT=1
0022 C0D1    74         MOV  *R1,R3
0024 16F6    75         JNE  ANDF2
0026 C0F2    76         MOV  *R2+,R3
0028 16F4    77         JNE  ANDF2             ;RESULT=1
002A C0D2    78         MOV  *R2,R3
002C 16F2    79         JNE  ANDF2
002E 10F3    80         JMP  ANDF3             ;RESULT=0
ASM990 2.4.6     RELOPS                     Sun Aug 10 23:07:35 2025 Page 0004

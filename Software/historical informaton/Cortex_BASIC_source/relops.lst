             32  *
             33  *AND OPERATOR
             34  *
0000 2E00    35  ANDF   CLEAR 0                ;CLEAR FPAC
0002 C0F1    36         MOV  *R1+,R3           ;INTEGER?
0004 1602    37         JNE  ANDF1             ;N
0006 C0D1    38         MOV  *R1,R3            ;Y, GET INTEGER
0008 1306    39         JEQ  ANDF3             ;0, RESULT=0
             40  *

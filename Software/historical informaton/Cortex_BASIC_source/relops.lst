0032 C0F1    97         MOV  *R1+,R3
0034 16F0    98         JNE  ANDF3
0036 C0D1    99         MOV  *R1,R3
0038 13EC   100         JEQ  ANDF2
003A 10ED   101         JMP  ANDF3
            102         END

            178  *       CKEX IS CALLED TO SEE IF AN EXPRESSION
            179  *       COULD OCCUR NEXT.  THE EXCEPTION WOULD
            180  *       OCCUR IF A DELIMITER WAS THE NEXT ITEM.
            181  *
            182  * CALLING SEQUENCE:
            183  *
            184  *       BL @CKEX
            185  *         NO EXPRESSION
            186  *       EXPRESSION
            187  *
            188  *       IN  R8 = PBC
            189  *
003E D818   190  CKEX   MOVB *R8,@DLIM
0040 0000 
0042 1307   191         JEQ  CKEX2             ;EOL
0044 9818   192         CB   *R8,@B38          ;FUNCTION?
0046 0568'
0048 1A03   193         JL   CKEX1             ;Y
004A 9818   194         CB   *R8,@B4C          ;OPERATOR OR VARIABLE?
004C 056C'
004E 1A01   195         JL   CKEX2             ;N, TAKE ERROR RETURN
            196  *
0050 05CB   197  CKEX1  INCT R11
0052 045B   198  CKEX2  RT

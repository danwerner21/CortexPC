             97  *       EVSD EVALUATES FOR A STRING CONSTANT OR VARIABLE
             98  *       BEGINNING AT THE PBC (R8).  MULTIPLE RETURNS ARE
             99  *       USED ACCORDING TO WHAT IS FOUND.  IF NO STRING
            100  *       OR VARIABLE IS FOUND, THE PBC (PROGRAM BYTE COUNTER)
            101  *       IS LEFT UNCHANGED.
            102  *
            103  * CALLING SEQUENCE:
            104  *
            105  *       BLWP @EVSDZ
            106  *         STRING CONSTANT RETURN ("---")
            107  *         STRING VARIABLE RETURN ($VAR)
            108  *       NEITHER
            109  *
            110  *       IN  R8 = PBC (PROGRAM BYTE COUNTER)
            111  *       OUT R0 = DLIM (DELIMITER
            112  *           R2 = PTR TO STRING
            113  *           R8 = PBC UPDATED
            114  *
            115  * EXCEPTIONS AND CONDITIONS:
            116  *
            117  *       ERRORS INCLUDE EXPECTING VARIABLE, SYNTAX ERROR,
            118  *       UNDEFINED FUNCTION, ILLEGAL DELIMITER, STORAGE
            119  *       OVERFLOW, UNDEFINED VARIABLE, EXPRESSION TOO
            120  *       COMPLEX, SUBSCRIPT ERROR, TOO MANY SUBSCRIPTS,
            121  *       UNDIMENSIONED VARIABLE, AND ALL ARITHMETIC ERRORS.
ASM990 2.4.6     EVAL                       Sun Aug 10 23:07:35 2025 Page 0004
EVAL - CORTEX BASIC REV. 1.1

0000 0000   123  EVSDZ  DATA WPR2,EVSD
            124  *
0004 C22D   125  EVSD   MOV  @16(13),R8        ;GET PBC
0006 0010 
0008 9818   126         CB   *R8,@B43          ;$?
000A 0569'
000C 130C   127         JEQ  EVSD2             ;Y
000E 1A09   128         JL   EVSD1             ;NOT STRING
0010 9838   129         CB   *R8+,@B45         ;" OR '?
0012 056A'
0014 1B06   130         JH   EVSD1             ;N
0016 C088   131         MOV  R8,R2             ;Y
            132  *
0018 D038   133         MOVB *R8+,R0           ;LOOK FOR "0
001A 16FE   134         JNE  $-2
            135  *
001C 04C0   136         CLR  R0
001E D038   137         MOVB *R8+,R0           ;RETURN DELIMITER
0020 101D   138         JMP  EVER1
            139  *
0022 8FBE   140  EVSD1  C    *R14+,*R14+       ;NOT STRING, RETURN 4(14)
0024 0380   141         RTWP
            142  *
0026 05CE   143  EVSD2  INCT R14
0028 05AD   144         INC  @16(13)           ;SKIP $
002A 0010 

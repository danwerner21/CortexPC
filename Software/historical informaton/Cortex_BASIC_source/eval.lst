0092 13F6   347         JEQ  ERR38             ;NOT DEFINED, ERROR
0094 C053   348         MOV  *R3,R1            ;GET COUNT
0096 132C   349         JEQ  EVAFN5            ;NO ARGUMENTS
0098 C0E0   350         MOV  @VDT,R3
009A 0000 

ASM990 2.4.6     SQRF                       Sun Aug 10 23:07:36 2025 Page 0001
SQUARE ROOT FUNCTION - CORTEX BASIC REV. 1.1

              2         IDT  'SQRF'
              3  *
              4  *
              5  *
              6         REF  FUNFX             ;FIXES ARGUMENT
              7         DXOP LOADF,0           ;LOAD FPAC
              8         DXOP STORE,1           ;STORE FPAC
              9         DXOP FADD,2            ;ADD TO FPAC
             10         DXOP FMUL,4            ;MULTIPLY FPAC
             11         DXOP FDIV,5            ;DIVIDE FPAC
     2F80    12  ERROR  EQU  >2F80             ;XOP XX,14 (ERROR CALL)
             13         REF  FPAC              ;FLOATING POINT ACCUMULATOR
             14         REF  TEMP              ;3 WRD TEMPORARY STORAGE
             15         REF  DS                ;3 WRD TEMPORARY STORAGE
             16         REF  EVSFR             ;EXIT ADDRESS
             17         REF  C8000
             18  *
     0004    19  SQRI   EQU  4                 ;# OF NEWTON ITERATIONS
             20  * ABSTRACT:
             21  *
             22  *      COMPUTE THE SQUARE ROOT OF N (R2) USING A
             23  *      NEWTON ITERATION DEFINED AS FOLLOWS:
             24  *
             25  *           X(I+1) = [X(I) + N / X(I)] / 2
             26  *
             27  *      ITERATE FOR SQRI TIMES.  3 ITERATIONS =
             28  *      6 DIGITS, 4 ITERATION = 11 DIGITS.
             29  *
             30  * CALLING SEQUENCE:
             31  *
             32  *      B @SQRF
             33  *
             34  *      IN  (R0) = 3 WRD FLOATING POINT #
             35  *      OUT (R2) = 3 WRD FLOATING POINT ROOT OF #
             36  *
             37  *      NORMAL EXIT IS TO @EVSFR
             38  *      ERROR EXIT IS THRU XOP XX.14
             39  *
             40  * EXCEPTIONS AND CONDITIONS:
             41  *
             42  *      USES R0-R4,R11
             43  *
             44  *      ERROR 25 = SQUARE ROOT OF NEGATIVE NUMBER
             45  *
             46  SQRF   DEF  SQRF              ;ENTRY POINT
0000 06A0    47         BL   @FUNFX            ;MOVE INTO FPAC
0002 0000 
0004 1022    48         JMP  SQRF3             ;ZERO, DONE
0006 C0C3    49         MOV  R3,R3             ;NEGATIVE?
0008 1626    50         JNE  ERR25             ;Y, ERROR
             51  *******
             52  * NEWTON'S ITERATION HAS QUADRADIC CONVERGENCE GIVEN
             53  * A GOOD FIRST GUESS.  PUT FIRST GUESS IN FPAC.
             54  *******
000A 2C60    55         STORE @DS              ;MOVE INTO DS
000C 0000 
000E 0200    56         LI   R0,>4000          ;GET 16^0 EXPONENT
0010 4000 
0012 6040    57         S    R0,R1             ;UNBIAS OLD EXPONENT
0014 D800    58         MOVB R0,@FPAC          ;LOAD EXPONENT
ASM990 2.4.6     SQRF                       Sun Aug 10 23:07:36 2025 Page 0002
SQUARE ROOT FUNCTION - CORTEX BASIC REV. 1.1

0016 0000 
0018 2D20    59         FMUL @SQRC1            ;FPAC=N*C1
001A 0058'
001C 2CA0    60         FADD @SQRC2
001E 005E'
0020 0991    61         SRL  R1,9              ;ODD EXPONENT?
0022 1702    62         JNC  SQRF1             ;N
0024 2D20    63         FMUL @FP4              ;Y, MULTIPLY BY 4
0026 006A'
             64  *
     0028'   65  SQRF1  EQU  $
0028 06C1    66         SWPB R1                ;POSITION EXPONENT
002A B801    67         AB   R1,@FPAC          ;ADJUST EXPONENT
002C 0016'
002E 0201    68         LI   R1,SQRI           ;DO SQRI ITERATIONS
0030 0004 
             69  *
             70  *******
             71  * ITERATION LOOP FOLLOWS.
             72  * DO X(I+1) = [X(I) + N / X(I)] / 2
             73  *******
     0032'   74  SQRF2  EQU  $
0032 2C60    75         STORE @TEMP            ;MOVE FPAC TO TEMP
0034 0000 
0036 2C20    76         LOADF @DS
0038 000C'
003A 2D60    77         FDIV @TEMP             ;DIVIDE..N/X(I)
003C 0034'
003E 2CA0    78         FADD @TEMP             ;ADD TEMP..X(I)+N/X(I)
0040 003C'
0042 2D20    79         FMUL @SQRC3            ;X 0.5
0044 0064'
0046 0601    80         DEC  R1                ;SQRI TIMES?
0048 16F4    81         JNE  SQRF2             ;N
             82  *******
             83  * GET ADDRESS OF RESULT AND RETURN TO EVAL
             84  *******
     004A'   85  SQRF3  EQU  $
004A 0202    86         LI   R2,FPAC           ;Y, RETURN
004C 002C'
004E 44A0    87         SZC  @C8000,*R2        SQR(0.0625) GIVES -VE VALUES
0050 0000 
0052 0460    88         B    @EVSFR
0054 0000 
             89  *
0056 2F99    90  ERR25  DATA ERROR+25          ;SQUARE ROOT OF NEGATIVE NUMBER
             91  *
0058 40E4    92  SQRC1  DATA >40E4,>F92A,>F9A8 ;0.894 427
005E 4039    93  SQRC2  DATA >4039,>3E4E,>F028 ;0.223 607
0064 4080    94  SQRC3  DATA >4080,>0000,>0000 ;0.5
006A 4140    95  FP4    DATA >4140,>0000,>0000 ;4.0
             96         END

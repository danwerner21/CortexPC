              2         IDT 'CRUF'
              3  *
              4  *       BASY            ;BASE COMMAND
              5  *       CRBY            ;CRB COMMAND
              6  *       CRBF            ;CRB FUNCTION
              7  *       CRFY            ;CRF COMMAND
              8  *       CRFF            ;CRF FUNCTION
              9  *
             10  * THIS MODULE ALSO CONTAINS THE SYSTEM CRASH ROUTINE.
             11  *
             12          REF FIX         ;INTEGER FIX
             13          REF EVSFR$      ;EXIT TO EVALUATOR WITH R2 RELOAD.
             14          REF NLIN        ;ENTRY EXIT TO MULTIPLEXOR
             15          REF GPRM        ;GET PARAMETER
             16          REF FPAC2       ;FLOATING POINT ACCUMULATOR
             17          REF BCRU        ;BASE CRU INDEX
             18  *
             19          DEF CRFY         ;CRF STATEMENT ENTRY POINT
             20          DEF CRBY         ;CRB STATEMENT ENTRY POINT
             21          DEF CRFF         ;CRF FUNCTION ENTRY POINT
             22          DEF CRBF         ;CRB FUNCTION ENTRY POINT
             23          DEF  BASY         ;BASE STATEMENT ENTRY POINT
             24  *
             25         DEF  CRASH$   <<< SYSTEM CRASH ROUTINE >>>
             26  *
             27          DXOP OUTINT,13          ;OUT INTEGER
             28          DXOP EVFIX,11           ;EVALUATE AND FIX
             29  *
             30  ************************************************************
             31  *                                                          *
             32  *               SET USER CRU BASE.                         *
             33  *                                                          *
             34  ************************************************************
0000 2EE0    35  BASY   EVFIX @BCRU            ;SAVE IN BCRU
0002 0000 
0004 101A    36         JMP  CRUXIT            ;EXIT TO NLIN
     2F80    37  ERROR  EQU >2F80              ;XOP XX,14  (ERROR CALL)

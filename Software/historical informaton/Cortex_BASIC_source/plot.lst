PLOT/UNPLOT ROUTINES - CORTEX BASIC REV. 1.1

0000 070D    41  UPLOTY SETO R13               FLAG AS 'UNPLOT'
0002 1001    42         JMP  PLOTE
0004 04CD    43  PLOTY  CLR  R13               FLAG AS 'PLOT'
             44  *
0006 0000    45  PLOTE  DATA FGM$              FORCE GRAPH MODE
0008 06A0    46         BL   @JMPR0A           Y, GET BYTE & CHECK IT
000A 0000 
000C 18      47  EOLTST BYTE PLTO-EOLTST/2,>38 'TO' - PLOT LINE
000E 16      48         BYTE PLTE-EOLTST/2,>00 NULL - EXIT
0010 16      49         BYTE PLTE-EOLTST/2,>3C ':'  - EXIT
0012 16      50         BYTE PLTE-EOLTST/2,>47 '!'  - EXIT
0014 0000    51         DATA 0
             52  *
             53  *     NO LEADING 'TO' - MUST BE AN XY PAIR
             54  *
0016 0608    55         DEC  R8                BACKUP CODE PTR
0018 06A0    56         BL   @GETXY            GET X,Y PAIR
001A 005E'
001C D80F    57         MOVB R15,@XLOC         SET CURSOR X
001E 0000 
0020 D80E    58         MOVB R14,@YLOC         SET CURSOR Y
0022 0000 
0024 0280    59         CI   R0,>3800          'TO' ?
0026 3800 
0028 1309    60         JEQ  PLTO              Y, LINE
002A C34D    61         MOV  R13,R13           N, PIXEL SET ?
002C 1303    62         JEQ  SETIT             Y,
002E 0420    63         BLWP @PIXOFF           N, TURN PIXEL OFF
0030 0000 
0032 1002    64         JMP  PLTE              AND QUIT
             65  *
0034 0420    66  SETIT  BLWP @PIXON            TURN PIXEL ON
0036 0000 
0038 0460    67  PLTE   B    @NLIN             EXIT TO NLIN
003A 0000 
             68  *
             69  *
003C 06A0    70  PLTO   BL   @GETXY            'TO' FOUND - GET X,Y PAIR
003E 005E'
0040 D80F    71         MOVB R15,@NXLOC        SET STOP X
0042 0000 
0044 D80E    72         MOVB R14,@NYLOC        SET STOP Y
0046 0000 
0048 C34D    73         MOV  R13,R13           PLOT ?
004A 1606    74         JNE  UNPLT             N, DO UNPLOT LINE
004C 0420    75         BLWP @PLOT             Y, CALL PLOT LINE
004E 0080'
             76  *
             77  *      CHECK FOR FOLLOWING 'TO'
             78  *
0050 0280    79  LOOKTO CI   R0,>3800          'TO' FOLLOWING ?
0052 3800 
0054 13F3    80         JEQ  PLTO              Y, CONTINUE
0056 10F0    81         JMP  PLTE              N, EXIT
             82  *
0058 0420    83  UNPLT  BLWP @UNPLOT           CALL UNPLOT LINE
005A 0076'
005C 10F9    84         JMP  LOOKTO            CHECK FOR 'TO'
             85  *
             86  *      GET A FOLLOWING  X,Y PAIR AND STORE THEM IN THE

              2          IDT 'LOGF'
              3  *
              4  * ROUTINE LIST:
              5  *
              6  *       LOGF            ;NATURAL LOG FUNCTION
              7  *
              8          REF FUNFX       ;FIX ARGUMENT
              9          REF PLYX,PLYXX  ;EVALUATE POLYNOMIAL
             10          REF GETP2       ;GET POWER OF 2
             11         REF FPAC         ;FLOATING POINT ACCUMULATOR
             12         REF TEMP         ;3 WRD TEMPORARY STORAGE
             13         REF DS,DS1       ;3 WRD TEMPORARY STORAGE

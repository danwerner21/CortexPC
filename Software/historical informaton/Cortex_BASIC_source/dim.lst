DIM STATEMENT - CORTEX BASIC REV. 1.1

              2         IDT  'DIM'
              3  *
              4  *       DIMY            ;DIMENSION COMMAND
              5  *
              6         REF  EVAL,EVALS2       ;RECURSIVE EVALUATOR
              7         REF  EVARZ             ;EVALUATE VARIABLE
              8         REF  FIX               ;FIX ARGUMENT
              9         REF  NLIN              ;EXIT TO MULTIPLEXOR
             10         REF  VDT               ;VARIABLE DEFINITION TABLE INDEX
             11         REF  NVS               ;NEXT VARIABLE STORAGE
             12         REF  NVD               ;NEXT VARIABLE DEFINITION
             13         REF  DLIM              ;PROGRAM DELIMITER
             14         REF  C6                ;CONSTANT 6
             15         DEF  DIMY
             16  *
     2F80    17  ERROR  EQU  >2F80             ;XOP XX,14  (ERROR CALL)
     2FA0    18  ERROR2 EQU  ERROR+>20
             19  *
     0004    20  NRV    EQU  4                 ;NUMBER OF RESERVED WORDS
ASM990 2.4.6     DIM                        Sun Aug 10 23:07:32 2025 Page 0002
DIM STATEMENT - CORTEX BASIC REV. 1.1

             22  *
             23  *       DIMENSION A VARIABLE.  A DIMENSIONED
             24  *       VARIABLE IS INDICATED IN THE VDT BY A
             25  *       NEGATIVE VALUE.  THE VARIABLE
             26  *       DEFINITION POINT TO THE INFORMATION
             27  *       VECTOR.
             28  *
             29  *INFORMATION VECTOR FORMAT:
             30  *
             31  *       D1,X1,D2,X2,...DN,-1,...DATA...
             32  *
             33  *WHERE  D1,D2,...DN = DIMENSIONS
             34  *       X1,X2,...   = MULTIPLIERS
             35  *
             36  *       X1 = D2+1 X D3+1 X ... DN+1
             37  *       X2 = D3+1 X D4+1 X ... DN+1
             38  *       ...
             39  *       XN = 1
             40  *
             41  * CALLING SEQUENCE:
             42  *
             43  *       B @DIMY
             44  *
             45  * EXCEPTIONS AND CONDITIONS:
             46  *
             47  *       EVALUATION ERRORS, STORAGE OVERFLOW
             48  *       EXPECTING DIMENSIONED VARIABLE
             49  *       INVALID DELIMITER
             50  *
ASM990 2.4.6     DIM                        Sun Aug 10 23:07:32 2025 Page 0003
DIM STATEMENT - CORTEX BASIC REV. 1.1

0000 04C0    52  DIMY   CLR  R0                ;READY R0
0002 D038    53         MOVB *R8+,R0           ;GET BYTE
0004 0280    54         CI   R0,>4300          ;'$' ?
0006 4300 
0008 1601    55         JNE  TSTVAR            ;N, CHECK IF ITS A VARIABLE
000A D038    56         MOVB *R8+,R0           ;Y, GET THE VARIABLE NAME BYTE

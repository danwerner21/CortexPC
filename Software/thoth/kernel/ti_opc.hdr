
\ machine dependent PD offsets

#SAVE_WP = 12        \ save location for wp register
#SAVE_PC = 13        \ save location for pc
#SAVE_ST = 14        \ save location for status register
#STACK_START = 15    \ pointer to start of stack

\ manifests used in conjunction with template

#STACK_PTR = SAVE_WP     \ wp also points to stack

#DEBUG = 1

#START_ADDR = 16

#PD_SIZE = (15 + DEBUG) \ size of PD

\ TI990 opcodes

#.A.         = $a000
#.AB.        = $b000
#.ABS.       = $0740

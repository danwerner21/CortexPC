             43  *
             44  * INTEGER PART FUNCTION
             45  *
0024 C052    46  INTF   MOV  *R2,R1            INTEGER ALREADY?
0026 130F    47         JEQ  INPF3             Y
0028 2C12    48         LOADF *R2              N - LOAD FPAC
             49  *
             50  * IF NUMBER => SCALING FACTOR  GET FLOATING PT OVERFLOW
             51  *
002A 0241    52         ANDI R1,>7F00          MASK OUT ALL BUT EXPONENT
002C 7F00 
002E 8801    53         C    R1,@C4A00         => SCALING FACTOR?
0030 0000 
0032 1407    54         JHE  INPF2
0034 2DA0    55         SCALE @C4A00           N - SCALE OFF FRACTION
0036 0030'
0038 2DC0    56         NORMAL 0
003A 1003    57         JMP  INPF2
             58  *
003C 2E00    59  INPF1  CLEAR 0                SAVE #
003E C801    60         MOV  R1,@FPAC2
0040 0000 
0042 0202    61  INPF2  LI   R2,FPAC           RETURN ADDRESS
0044 0000 
0046 0460    62  INPF3  B    @EVSFR            RETURN
0048 0000 
             63  *
             64  *ABSOLUTE FUNCTION
             65  *
004A 2C12    66  ABSF   LOADF *R2              ;LOAD FPAC
004C C052    67         MOV  *R2,R1            ;CHECK SIGN
004E 1303    68         JEQ  ABSF1             ;INTEGER
0050 15FA    69         JGT  INPF3             ;+, RT
0052 2E40    70         NEGATE 0               ;-, NEGATE
0054 10F6    71         JMP  INPF2             ;RETURN
             72  *
0056 0760    73  ABSF1  ABS  @FPAC2            ;INTEGER, TAKE ABS
0058 0040'
005A 19F3    74         JNO  INPF2             ;NO OVERFLOW
005C 0200    75         LI   R0,>4480          ;OVERFLOW, LOAD 32768 (FP)
005E 4480 
0060 04C2    76         CLR  R2
0062 2C00    77         LOADF R0               ;LOAD R0,R1,R2
0064 10EE    78         JMP  INPF2
             79  *
             80  *NKY FUNCTION
             81  *
0066 0000    82  NKYF   DATA GETC$             ;CHARACTER?
0068 10EC    83         JMP  INPF2             ;N - RETURN 0
006A 1000    84         NOP                    ;Y - NORMAL CHARACTER
006C 06C0    85         SWPB R0                ;Y - ESCAPE CHARACTER
006E 06A0    86         BL   @FIX              ;FIX ARGUMENT
0070 0002'
0072 C041    87         MOV  R1,R1             ;ARG=0?
0074 1302    88         JEQ  NKYF1             ;Y, RETURN LEC

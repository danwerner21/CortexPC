            118  *
            119  *              MOD FUNCTION
            120  *             ==============
            121  *
            122  *      FORMAT :-
            123  *           A = MOD [ ARG 1 , ARG 2 ]
            124  *
            125  *      THIS FUNCTION PROVIDES AN INTEGER MOD OF ARG 1
            126  *      THE MOD # IS GIVEN BY ARG 2.
            127  *         EG. A=MOD(9,7)   RETURNS A VALUE FOR A OF 2
            128  *
            129  *     *R1 CONTAINS ARG 2, *R2 CONTAINS ARG 1
            130  *     R3,R10 ARE SPARE
            131  *     EXIT IS VIA RT.
            132  *
00AC C0C1   133  MODF   MOV  R1,R3             SAVE ARG 2
00AE 1501   134         JGT  MODF1             +VE, OK
00B0 2F9E   135  ERR30  DATA ERROR+30          RANGE ERROR
            136  *
00B2 06A0   137  MODF1  BL   @FIX              FIX PARAMETER
00B4 0070'
00B6 C001   138         MOV  R1,R0             COPY INTO R0
00B8 08F0   139         SRA  R0,15             FILL WITH SIGN BIT
            140  * R0,R1 NOW CONTAINS ARG 1
00BA 0183   141         DIVS R3                DO DIVIDE
00BC C041   142         MOV  R1,R1             TEST SIGN BIT
00BE 15BE   143         JGT  INPF1             +VE, OK
00C0 13BD   144         JEQ  INPF1             0,   OK
00C2 A043   145         A    R3,R1             -VE, ADJUST !
00C4 10BB   146         JMP  INPF1
            147         END

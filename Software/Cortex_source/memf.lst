MEMORY ROUTINES - CORTEX BASIC REV. 1.1

              2          IDT 'MEMF'
              3  *
              4  *       MEMY            ;MEM COMMAND
              5  *       MEMF            ;MEM FUNCTION
              6  *       ASCF            ;ASC FUNCTION
              7  *
              8          REF EVERZ       ;EVALUATE EXPRESSION
              9          REF PFIX        ;FIX 16 BIT NUMBER
             10          REF GPRM2       ;GET PARAMETERS
             11          REF FPAC,FPAC2  ;FLOATING POINT ACCUMULATOR
             12          REF B4A         ;>4A
             13          REF NLIN        ;EXIT ENTRY TO MULTIPLEXOR
             14          REF EVSFR$      ;EXIT TO EVAL WITH R2 ='FPAC'
             15          DXOP STORE,1    ;STORE FPAC
             16          DXOP CLEAR,8    ;CLEAR FPAC
             17          DXOP EVFIX,11   ;EVALUATE AND FIX
             18          DXOP OUTFP,12   ;OUT FLOATING POINT #
     2F80    19  ERROR   EQU >2F80               ;XOP XX,14  (ERROR CALL)

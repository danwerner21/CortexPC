             46          DEF MEMY
             47  *
0000 9838    48  MEMY    CB *R8+,@B4A    ;LEFT BRACKET?
0002 0000 
0004 160A    49            JNE ERR1      ;N, ERROR
0006 0420    50          BLWP @EVERZ     ;GET ADDRESS
0008 0000 
000A 06A0    51          BL @PFIX        ;GET INTEGER
000C 0000 
000E 06A0    52          BL @GPRM2       ;CHECK PARAMETERS
0010 0000 
0012 06C3    53          SWPB R3         ;LEFT JUSTIFY
0014 D443    54          MOVB R3,*R1     ;STORE BYTE IN MEMORY
0016 0460    55          B @NLIN
0018 0000 
             56  *
001A 2F81    57  ERR1    DATA ERROR+1
             58  *
             59  *READ MEMORY
             60  *
             61  * ENTRY POINT:
             62  *
             63          DEF MEMF
             64  *
001C 06A0    65  MEMF    BL @PFIX         ;GET PARAMETER
001E 000C'
0020 D051    66          MOVB *R1,R1      ;GET BYTE
0022 0981    67  MEMF1   SRL R1,8         ;RIGHT JUSTIFY
0024 2E00    68          CLEAR 0          ;CLEAR FPAC
0026 C801    69          MOV R1,@FPAC2    ;SAVE
0028 0000 
002A 0460    70         B @EVSFR$
002C 0000 

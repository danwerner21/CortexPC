LET STATEMENT - CORTEX BASIC REV. 1.1

              2          IDT 'LET'
              3  *
              4  * ROUTINE LIST:
              5  *
              6  *       LETY            ;LET COMMAND
              7  *
              8          REF EVARZ       ;EVALUATE VARIABLE
              9          REF EVERZ       ;EVALUATE EXPRESSION
             10          REF EVSDZ       ;EVALUATE STRING
             11          REF CKEX        ;CHECK FOR EXPRESSION
             12          REF CVDIFZ      ;CONVERT DECIMAL TO INTEGER/FP
             13          REF NLIN        ;EXIT ENTRY TO MULTIPLEXOR
             14          REF FFLG        ;FORMATTING FLAG
             15          REF IOB         ;I/O BUFFER PTR
             16          DXOP LOADF,0    ;LOAD FPAC
             17          DXOP STORE,1    ;STORE FPAC
             18          DXOP SCALE,6    ;SCALE FPAC
             19          DXOP NORMAL,7   ;NORMALIZE FPAC
             20          DXOP EVFIX,11   ;EVALUATE AND FIX
             21          DXOP OUTFP,12   ;OUT FLOATING POINT #
             22          DXOP OUTINT,13  ;OUT INTEGER
     2F80    23  ERROR   EQU >2F80       ;XOP XX,14  (ERROR CALL)
ASM990 2.4.6     LET                        Sun Jul 20 19:28:49 2025 Page 0002
LET STATEMENT - CORTEX BASIC REV. 1.1

             25  * ABSTRACT:
             26  *
             27  *       THE LET COMMAND IS THE ASSIGNMENT STATEMENT
             28  *       AND CAN HAVE ANY OF THE FOLLOWING FORMS:
             29  *
             30  *       A[-]=B[-]               NUMERIC ASSIGNMENT
             31  *       $A[-]=$B[-]             ASSIGNMENT
             32  *       $A[-]=$B[-],N           PICK
             33  *       $A[-]=$B[-];N           REPLACE
             34  *       $A[-]=$B[-]+$C[0]       CONCATENATE
             35  *       $A[-]=/N                DELETE
             36  *       $A[-]=/$B[-]            INSERT
             37  *       $A[-]=N                 CONVERT # TO ASCII
             38  *       $A[-]=#$B[-],N          CONVERT # TO ASCII FORMATTED
             39  *       $A[-]=%N                CONVERT BYTE
             40  *       N=$A[-],E               CONVERT ASCII TO #
             41  *
             42  * CALLING SEQUENCE:
             43  *
             44  *       B @LETY
             45  *
             46  *       EXIT TO NLIN
             47  *
             48  * EXCEPTIONS AND CONDITIONS:
             49  *
             50  *       MISSING ASSIGNMENT OPERATOR
             51  *       EVALUATION ERRORS
             52  *
ASM990 2.4.6     LET                        Sun Jul 20 19:28:49 2025 Page 0003
LET STATEMENT - CORTEX BASIC REV. 1.1

             54  * ENTRY POINT:
             55  *
             56         DEF LETY
             57  *
0000 0420    58  LETY    BLWP @EVSDZ
0002 0000 
0004 2F81    59            DATA ERROR+1  ;"
0006 101A    60            JMP LET3      ;$
0008 0420    61          BLWP @EVARZ     ;EVALUATE VARIABLE
000A 0000 
000C 0280    62          CI R0,>5600     ;=?
000E 5600 
0010 1618    63            JNE ERR36     ;N, ERROR
0012 C0C2    64          MOV R2,R3
0014 06A0    65          BL @CKEX        ;CHECK FOR EXPRESSION
0016 0000 
0018 1007    66            JMP LET1      ;PROBLEM
001A 0420    67          BLWP @EVERZ     ;EVALUATE
001C 0000 
             68  *
             69  *  [VAR]=[EXP]
             70  *
001E CCF2    71          MOV *R2+,*R3+   ;STORE RESULTS
0020 CCF2    72          MOV *R2+,*R3+
0022 C4D2    73          MOV *R2,*R3
0024 0460    74  LETR    B @NLIN         ;GOTO NEXT LINE
0026 0000 
             75  *
             76  *  [VAR]=_
             77  *
0028 0420    78  LET1    BLWP @EVSDZ     ;LOOK FOR STRING
002A 0002'
002C 1002    79            JMP LET2      ;"
002E 1001    80            JMP LET2      ;$
0030 2F81    81          DATA ERROR+1    ;SYNTAX ERROR
             82  *
             83  *  [VAR]=[$VAR]_
             84  *
0032 C102    85  LET2    MOV R2,R4       ;SAVE ADR
0034 0280    86          CI R0,>3F00     ;,?
0036 3F00 
0038 1353    87            JEQ LET6      ;Y, CONVERT ASCII TO BINARY
             88  *
003A 2F87    89  ERR7    DATA ERROR+7    ;N, EXPECTING OPERATER
             90  *
             91  *  $_           STRING ENTRY
             92  *
003C 0280    93  LET3    CI R0,>5600     ;=?
003E 5600 
0040 1309    94            JEQ LET3A     ;Y
0042 2FA0    95  ERR36   DATA ERROR+>20  ;MISSING ASSIGNMENT OPERATER
0044 0024    96            DATA 36

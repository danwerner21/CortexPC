            148  *ASSIGN,PICK,REPLACE,CONCATENATE
            149  *
            150  *       $A[-]=$B[-]
            151  *       $A[-]=$B[-],N
            152  *       $A[-]=$B[-];N
            153  *       $A[-]=$B[-]+$C[-]
            154  *
0098 0705   155  LET4    SETO R5         ;NO NULL
009A 0280   156          CI R0,>4000     ;;?
009C 4000 
009E 1305   157            JEQ LET4A     ;Y, REPLACEMENT
00A0 04C5   158          CLR R5          ;SET TO NULL
00A2 0280   159          CI R0,>3F00     ;,?
00A4 3F00 
00A6 1605   160            JNE LET4B     ;N, DIRECT ASSIGNMENT
00A8 0585   161          INC R5
            162  *
00AA 2EC1   163  LET4A   EVFIX R1        ;EVALUATE COUNT
00AC C041   164          MOV   R1,R1     ;CHECK CONDITION
00AE 1505   165          JGT   LET4C     ; >0 THEN DO PICK
00B0 10B9   166          JMP   LETR      ;ELSE IGNORE
            167  *
00B2 C060   168  LET4B   MOV @IOB,R1      ;GET MAX MOVE
00B4 0000 
00B6 6047   169          S R7,R1
00B8 0601   170          DEC  R1
            171  *
00BA C0C7   172  LET4C   MOV R7,R3       ;MARK
            173  *
00BC D132   174  LET4D   MOVB *R2+,R4    ;MOVE
00BE 1602   175            JNE LET4I     ;CHARACTER
00C0 C145   176          MOV R5,R5       ;NULL, ASSIGNMENT?
00C2 1307   177            JEQ LET4F     ;Y
00C4 DDC4   178  LET4I   MOVB R4,*R7+
00C6 81C2   179          C R2,R7         ;IS S<D?
00C8 1402   180            JHE LET4E     ;N
00CA 80C2   181          C R2,R3         ;Y, IS S>=D0?
00CC 1402   182            JHE LET4F     ;Y, ABORT
00CE 0601   183  LET4E   DEC R1          ;DONE?
00D0 16F5   184            JNE LET4D     ;N
            185  *
00D2 0915   186  LET4F   SRL R5,1        ;DONE, NEED NULL?
00D4 1601   187            JNE LET4G     ;N
00D6 75D7   188          SB *R7,*R7      ;Y
            189  *
00D8 0280   190  LET4G   CI R0,>5D00     ;+?
00DA 5D00 
00DC 1632   191            JNE LETRR     ;N, RETURN
00DE 10BB   192          JMP LET3E       ;Y, GET STRING

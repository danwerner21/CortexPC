0058 002A'
005A 101E   115            JMP LET4      ;"
005C 101D   116            JMP LET4      ;$
005E D038   117          MOVB *R8+,R0    ;GET BYTE
0060 0280   118          CI R0,>4200     ;%?
0062 4200 
0064 13F0   119            JEQ LET11     ;Y
0066 0280   120          CI R0,>5E00     ;/?
0068 5E00 
006A 134B   121            JEQ LET12     ;Y, INSERT
006C 0280   122          CI R0,>3E00     ;#?
006E 3E00 
0070 160B   123            JNE LET3C     ;N
            124  *
            125  *CONVERT NUMBER TO ASCII
            126  *
            127  *       $A[-]=N
            128  *       $A[-]=#$B[-],N

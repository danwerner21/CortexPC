            215  *INSERT STRING
            216  *
            217  *       $A[-]=/$B[-]
            218  *       (R7)=DESTINATION
            219  *
0102 0420   220  LET12   BLWP @EVSDZ     ;LOOK AT NEXT STRING
0104 0074'
0106 100A   221            JMP LET13A
0108 1009   222            JMP LET13A
010A 2EC1   223          EVFIX R1        ;GET #
            224  *
            225  *DELETE CHARACTERS
            226  *
            227  *       $A[-]=/N
            228  *       (R2)=(R7)=STRING
            229  *       R1=COUNT
            230  *
010C 0601   231  LET12A  DEC R1          ;MOVE BY HOLE
010E 1103   232            JLT LET12B    ;DONE
0110 D032   233          MOVB *R2+,R0    ;SKIP 1 CHARACTER
0112 16FC   234            JNE LET12A    ;CONTINUE
0114 0602   235          DEC R2          ;EOL
            236  *

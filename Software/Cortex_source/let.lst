             98  *BYTE ASSIGNMENT
             99  *
            100  *       $A[-]=%N...
            101  *
0046 2EC1   102  LET11   EVFIX R1        ;GET BYTE
0048 06C1   103          SWPB R1
            104  *
004A DDC1   105  LET11A  MOVB R1,*R7+    ;SAVE #
004C 0280   106          CI R0,>4200     ;%?
004E 4200 

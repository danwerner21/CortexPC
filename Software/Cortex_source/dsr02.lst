             29  ************************************************************
             30  *                                                          *
             31  *            LEVEL 4 INTERRUPT SERVICE ROUTINE             *
             32  *                                                          *
             33  ************************************************************
             34  *
             35  *  THIS ROUTINE CHECKS FOR :-
             36  *      1.   KEYBOARD INTERRUPT.
             37  *      2.   FDC INTERRUPT
             38  *      3.   ALL 9902 INTERRUPTS
             39  *      4.   USER LEVEL 4 INTERRUPT TRAP
             40  *
0000 020C    41  INT4PC LI   R12,2*KEYBRD      SET CRUBASE TO KEYBOARD DATA
0002 0010 
             42  ************************************************************
             43  *                                                          *
             44  *            CHECK FOR KEYBOARD INTERRUPT                  *
             45  *                                                          *
             46  ************************************************************
0004 1DF9    47         SBO  KBDACK-KEYBRD     MAKE SURE IT IS ENABLED !!!
0006 1FFD    48         TB   KBDINT-KEYBRD     KEYBOARD?
0008 1313    49         JEQ  FDC1              N, CHECK THE FDC
000A 04CB    50         CLR  R11               Y, READY HOLDING REGISTER
000C 360B    51         STCR R11,8             GET THE KEYBOARD DATA
000E 1EF9    52         SBZ  KBDACK-KEYBRD     ACKNOWLEDGE IT
0010 1DF9    53         SBO  KBDACK-KEYBRD
0012 028B    54         CI   R11,>FF00         GRAPHIC RUBOUT
0014 FF00 
0016 1605    55         JNE  KBDIN             N, NORMAL KEYBOARD INPUT
0018 0707    56         SETO R7                Y, KILL DSRCNT FLAG
001A C820    57         MOV  @C1,@UNIT         AND RESET UNIT FLAG TO 1
001C 0000 
001E 0000 
0020 0380    58         RTWP                   AND EXIT 
             59  *
0022 C320    60  KBDIN  MOV  @PLF,R12          LOAD/SAVE?
0024 0000 
0026 132A    61         JEQ  CHKESC            N, DECODE AS NORMAL
0028 980B    62         CB   R11,@B1B          Y, ESCAPE?
002A 0000 
002C 1339    63         JEQ  ABRTIO            Y, ABORT
002E 0380    64         RTWP                   N, THROW IT AWAY
             65  ************************************************************
             66  *                                                          *
             67  *            CHECK FOR FDC INTERRUPT                       *
             68  *                                                          *
             69  ************************************************************
0030 1FFC    70  FDC1   TB   FDCINT-KEYBRD     WAS IT THE FDC?
0032 1306    71         JEQ  POLL02            N, POLL 9902'S
0034 D820    72         MOVB @B00,@FDC         Y, RESET FDC
0036 0000 
0038 F140 
003A 0720    73         SETO @FDCDON           SET FDC DONE FLAG
003C 0000 
003E 0380    74         RTWP

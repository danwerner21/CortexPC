006C 1639   104         JNE  TRYTIM            N, TRY NEXT INTERRUPT SOURCE
006E 360B   105         STCR R11,8             Y, GET CHARACTER
0070 1D12   106         SBO  18                RESET RBRL
0072 1F09   107         TB   9                 WAS THERE AN ERROR ?
0074 1340   108         JEQ  QUIT              Y, IGNORE IT !
0076 C2A0   109         MOV  @PLF,R10          N, TEST LOAD/SAVE ?
0078 0024'
007A 1626   110         JNE  LOADIN            Y, DO SPECIAL CHECKS
            111  *

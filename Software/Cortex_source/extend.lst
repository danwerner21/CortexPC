             27  *
             28  *   TRANSFER PHYSICAL MEMORY
             29  *
             30  *     BLWP @XFRPM
             31  *
             32  *   IN:  R1   PAGE #
             33  *        R2   PAGE INDEX (WORD ALIGNED)
             34  *        R3   TRANSFER LENGTH
             35  *        R4   LOAD POINT (WORD ALIGNED)
             36  *
0000 0000    37  XFRPM  DATA WPR2,$+2
0004 C320    38         MOV  @CONFIG,R12       GET CONFIGURATION FLAG
0006 0000 
0008 091C    39         SRL  R12,1             MAPPER PRESENT ?
000A 1722    40         JNC  ERR47             N, ERROR
000C 03A0    41         CKON                   Y, ENABLE MAPPER
000E 020C    42         LI   R12,M$REG2        POINT TO MAP REG 2
0010 F104 
0012 C01C    43         MOV  *R12,R0           SAVE IT
0014 C72D    44         MOV  @2*R1(R13),*R12   SET NEW PAGE
0016 0002 
0018 C0AD    45         MOV  @2*R2(R13),R2     GET INDEX PAGE
001A 0004 
001C C0ED    46         MOV  @2*R3(R13),R3     GET # BYTES TO XFER
001E 0006 
0020 C12D    47         MOV  @2*R4(R13),R4     GET LOAD ADDRESS
0022 0008 
0024 0242    48         ANDI R2,>0FFF          ENSURE INDEX IS VALID
0026 0FFF 
0028 0583    49         INC  R3                FORCE TRANSFER LENGTH TO WORDS
002A 0913    50         SRL  R3,1    
             51  *

              2         IDT 'IF'
              3  *
              4  *       IFY             ;IF COMMAND
              5  *
              6          REF EVERZ       ;EVALUATE EXPRESSION
              7          REF EVSDZ       ;EVALUATE STRING
              8          REF LINE,NLIN   ;MULTIPLEXOR ENTRY POINTS
              9          REF ELSF        ;ELSE FLAG
             10          DEF IFY
             11  *
             12          DXOP EVFIX,11   ;EVALUATE AND FIX
     2F80    13  ERROR   EQU >2F80       ;XOP XX,14  (ERROR CALL)
     2FA0    14  ERROR2  EQU ERROR+>20
             15  *
             16  *       EXECUTE THE IF COMMAND.  THE FORM IS:
             17  *
             18  *       IF <EXP> THEN <STATEMENT>
             19  *       IF <STRING> THEN <STATEMENT>
             20  *       IF <STRING> <RELATION> <STRING> THEN <STATEMENT>
             21  *       IF <STING> <RELATION> <STRING> , <EXP>
             22  *               THEN <STATEMENT>
             23  *
             24  * CALLING SEQUENCE:
             25  *
             26  *       B @IFY
             27  *
             28  *       EXIT TO LINE OR NLIN
             29  *
             30  * EXCEPTIONS AND CONDITIONS:
             31  *
             32  *       ILLEGAL DELIMITER, SYNTAX ERROR
             33  *

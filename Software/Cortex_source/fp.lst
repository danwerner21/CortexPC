            671  *
            672  *       FPAC WILL BE SHIFTED LEFT OR RIGHT IN
            673  *       ORDER TO MAKE THE EXPONENT AGREE WITH THE
            674  *       SCALE FACTOR POINTED TO BY R11.  THIS
            675  *       OPERATION IS ESSENTIALLY THE OPPOSITE
            676  *       OF NORMALIZATION.
            677  *       SCALING TO >4600 PLACES THE DECIMAL POINT
            678  *       BETWEEN THE SECOND AND THIRD WORD OF THE FLOATING
            679  *       POINT NUMBER.  SCALING TO >4A00 PLACES THE DECIMAL
            680  *       POINT AFTER THE THIRD WORD.
            681  *       HENCE, TO INTEGERIZE A FLOATING POINT NUMBER IN FPAC,
            682  *       ONE SCALES TO >4A00 AND THEN NORMALIZES.
            683  *
            684  * CALLING SEQUENCE:
            685  *
            686  *       XOP XX,6
            687  *
            688  * EXCEPTIONS AND CONDITIONS:
            689  *
            690  *       ERROR 29 WILL RESULT FROM A LEFT SHIFT
            691  *
            692  * EXTERNAL ROUTINE LIST:
            693  *
            694  *       ERR29           ;ERROR 29
            695  *
            696  * ENTRY POINT:
            697  *
            698         DEF  FSCL
            699  *
031A C11B   700  FSCL   MOV  *R11,R4           GET SCALE FACTOR
031C 04C3   701         CLR  R3
031E C200   702         MOV  R0,R8             SAVE SIGN
0320 D1C8   703         MOVB R8,R7             GET EXPONENT
0322 0247   704         ANDI R7,>7F00          GET EXPONENT
0324 7F00 
0326 61C4   705         S    R4,R7             GET DIFFERENCE
0328 130B   706         JEQ  FSCL2             ALREADY SCALED
032A D003   707         MOVB R3,R0             ZERO EXPONENT
032C 0887   708         SRA  R7,8              RIGHT JUSTIFY
032E 15D0   709         JGT  ERR29             SHIFT LEFT, FP ERROR?
            710  *
0330 06A0   711  FSCL1  BL   @FARS             SHIFT RIGHT
0332 02D2'
0334 0587   712         INC  R7                DONE?
0336 16FC   713         JNE  FSCL1             N
0338 D008   714         MOVB R8,R0             RESTORE SIGN BIT
033A 0240   715         ANDI R0,>80FF          ;MASK EXPONENT
033C 80FF 
033E B004   716         AB   R4,R0
0340 0380   717  FSCL2  RTWP
            718  *
            719         END

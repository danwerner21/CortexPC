            482  *
            483  *       DIVIDE FPAC BY THE FLOATING POINT NUMBER POINTED
            484  *       TO BY R11.
            485  *
            486  *       FPFX REMOVES EXPONENTS FROM R0,R1,R2 AND
            487  *       R4,R5,R6, UNBIASES THEM, PERFORMS MULTIPLICATION
            488  *       OR DIVISION (ADD OR SUBTRACT) AND THEN
            489  *       RE-BIASES THEM.
            490  *
            491  * CALL SEQUENCE:
            492  *
            493  *       XOP XX,5
            494  *       BL @FPFX
            495  *
            496  * EXCEPTIONS AND CONDITIONS:
            497  *
            498  *       ERROR 28 WILL RESULT FROM DIVISION BY ZERO
            499  *       ERROR 29 WILL RESULT FROM OVERFLOW
            500  *
            501  * EXTERNAL ROUTINE LIST:
            502  *
            503  *       FCLR            ;CLEAR
            504  *       FMD7            ;FINISH BY NORMALIZING
ASM990 2.4.6     FP                         Sun Jul 20 19:28:51 2025 Page 0016
FLOATING POINT ROUTINES - CORTEX BASIC REV. 1.1

            506  *FIX EXPONENTS
            507  *
            508  *       BL @FPFX
            509  *         BIAS INSTRUCTION
            510  *         REBIAS #
            511  *
022A D0C0   512  FPFX   MOVB R0,R3             GET EXPONENTS
022C D1C4   513         MOVB R4,R7
022E 7000   514         SB   R0,R0             ;REMOVE FROM NUMBERS
0230 7104   515         SB   R4,R4
0232 C207   516         MOV  R7,R8             GET SIGN
0234 2A03   517         XOR  R3,R8             +-,-+ = NEG  ++,-- = POS
0236 06C3   518         SWPB R3                REMOV SIGN BITS
0238 0243   519         ANDI R3,>7F
023A 007F 
023C 06C7   520         SWPB R7
023E 0247   521         ANDI R7,>7F
0240 007F 
0242 04BB   522         X    *R11+             DO ADD FOR MUL, SUB FOR DIV
0244 A0FB   523         A    *R11+,R3          BIAS
0246 24E0   524         CZC  @CFF80,R3         CHECK FOR OVERFLOW
0248 0000 
024A 1642   525         JNE  ERR29             PROBLEM
024C 0A18   526         SLA  R8,1              ADD SIGN
024E 1702   527         JNC  $+6
0250 0223   528         AI   R3,>80            NEGATIVE
0252 0080 
0254 045B   529         RT                     RETURN
            530  *
            531  *FLOATING POINT DIVIDE
            532  *
            533  * ENTRY POINT:
            534  *
            535         DEF  FDD
            536  *
0256 C000   537  FDD    MOV  R0,R0             ;FPAC=ZERO?
0258 13E4   538         JEQ  FCLR              ;Y
025A C13B   539         MOV  *R11+,R4          ;FPAC / 0?
025C 1338   540         JEQ  FDDER             ;Y, DIVISION BY ZERO
025E C17B   541         MOV  *R11+,R5          ;N, LOAD R4,R5,R6
0260 C19B   542         MOV  *R11,R6
0262 06A0   543         BL   @FPFX             FIX EXPONENTS
0264 022A'
0266 60C7   544         S    R7,R3             SUBTRACT EXPONENTS
0268 0040   545         DATA >40               ADD >40 TO BIAS
026A 8100   546         C    R0,R4             CHECK FOR PROPER FRACTION
026C 110A   547         JLT  FDD2              OK
026E 0583   548         INC  R3                IMPROPER, INCREMENT EXPONENT
0270 0A44   549         SLA  R4,4              SHIFT R4,R5,R6 LEFT 4 BITS
0272 C245   550         MOV  R5,R9
0274 09C9   551         SRL  R9,12
0276 A109   552         A    R9,R4             MOVE 1ST HEX DIGIT ACROSS
0278 0A45   553         SLA  R5,4
027A C246   554         MOV  R6,R9
027C 09C9   555         SRL  R9,12
027E A149   556         A    R9,R5             MOVE 2ND HEX DIGIT ACROSS
0280 0A46   557         SLA  R6,4
            558  *
0282 04C7   559  FDD2   CLR  R7                Y, CLEAR QUOTIENT

FLOATING POINT ROUTINES - CORTEX BASIC REV. 1.1

              2         IDT  'FP'
              3  *
              4  *       FAD             ;ADD TO FPAC
              5  *       FSD             ;SUBTRACT FROM FPAC
              6  *       FMD             ;MULTIPLY FPAC
              7  *       FDD             ;DIVIDE FPAC
              8  *       FLDD            ;LOAD FPAC
              9  *       FSRD            ;STORE FPAC
             10  *       FNEG            ;NEGATE FPAC
             11  *       FCLR            ;CLEAR FPAC
             12  *       FNRM            ;NORMALIZE FPAC
             13  *       FSCL            ;SCALE FPAC
             14  *       FLOAT           ;FLOAT FPAC
             15  *       FADDI           ;3 WRD ADDITION
             16  *       FSUBI           ;3 WRD SUBTRACTION
             17  *
             18  *       THE FLOATING POINT ACCUMULATOR IS THE FIRST 3
             19  *       WORDS OF THE FLOATING POINT REGISTERS  (R0,R1,R2).
             20  *
             21  *       ALL FLOATING POINT OPERATIONS ASSUME NORMALIZED
             22  *       NUMBERS AS INPUTS AND ALL RESULTS ARE NORMALIZED.
             23  *
             24  *       THE FORM OF A FLOATING POINT NUMBER IS AS FOLLOWS:
             25  *
             26  *       1ST WORD        SCCC CCCC MMMM MMMM
             27  *       2ND WORD        MMMM MMMM MMMM MMMM
             28  *       3RD WORD        MMMM MMMM MMMM MMMM
             29  *
             30  *       WHERE  S = SIGN BIT
             31  *              C = 7 BIT, EXCESS >40 CHARACTERISTIC
             32  *              M = 40 BIT UNSIGNED MAGNITUDE MANTISSA
             33  *                  0 <= M < 1
             34  *
             35  *       A NUMBER IS NORMALIZED WHEN THE 1ST HEX DIGIT
             36  *       OF THE MANTISSA IS NON-ZERO.
             37  *
             38  *       A TRUE ZERO (ALL ZERO'S) IS USED FOR ZERO.
             39  *
     2F80    40  ERROR  EQU  >2F80             ;XOP XX,14  (ERROR CALL)
     2FA0    41  ERROR2 EQU  ERROR+>20
             42  *
             43         DEF  FSRD
             44         DEF  FLDD
             45         DEF  FSD               ;SUBTRACT FROM FPAC
             46         DEF  FAD
             47         DEF  FNEG
             48         DEF  FLOAT
             49         DEF  FNRM
             50  *
             51         REF  C7F,CF0,CFF80
ASM990 2.4.6     FP                         Sun Jul 20 19:28:51 2025 Page 0002
FLOATING POINT ROUTINES - CORTEX BASIC REV. 1.1

             53  *
             54  *       LOAD INTO FPAC A 3 WRD FLOATING POINT #.
             55  *
             56  * CALLING SEQUENCE:
             57  *
             58  *       XOP XX,1
             59  *
0000 CEC0    60  FSRD   MOV  R0,*R11+
0002 CEC1    61         MOV  R1,*R11+
0004 C6C2    62         MOV  R2,*R11
0006 0380    63         RTWP
ASM990 2.4.6     FP                         Sun Jul 20 19:28:51 2025 Page 0003

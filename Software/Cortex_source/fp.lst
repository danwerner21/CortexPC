            198  *
            199  *       GET ABSOLUTE VALUE OF FPAC.
            200  *       NEGATE FPAC.
            201  *
            202  * CALL SEQUENCE:
            203  *
            204  *       XOP XX,9        ;NEGATE FPAC
            205  *
            206  *       DEF FABS
            207  *
            208  *FABS   ANDI R0,>7FFF   CLEAR SIGN BIT
            209  *       RTWP            RETURN
00CA C000   210  FNEG   MOV  R0,R0             ZERO?
00CC 1302   211         JEQ  FNEG1             Y, LEAVE TRUE ZERO
00CE 0220   212         AI   R0,>8000          N, COMPLEMENT SIGN BIT
00D0 8000 
00D2 0380   213  FNEG1  RTWP RETURN
ASM990 2.4.6     FP                         Sun Jul 20 19:28:51 2025 Page 0008
FLOATING POINT ROUTINES - CORTEX BASIC REV. 1.1

            215  *
            216  *       IF FPAC IS NOT NORMALIZED, AN ATTEMPT WILL BE
            217  *       MADE TO NORMALIZE.  IN GENERAL, FLOAT WORKS ON
            218  *       R0,R1,R2 AND HENCE IT CAN BE USED TO FLOAT
            219  *       OTHER SETS OF NUMBERS THAN FPAC.
            220  *
            221  * CALLING SEQUENCE:
            222  *
            223  *       XOP XX,10       WHERE XX IS NOT USED
            224  *
            225  * EXCEPTIONS AND CONDITIONS:
            226  *
            227  *       IF R0 IS NON-ZERO, THE ROUTINE WILL ABORT.
            228  *
            229  * EXTERNAL ROUTING LIST:
            230  *
            231  *       FNRM            ;NORMALIZE
            232  *       FCLR            ;CLEAR FPAC
            233  *
00D4 C000   234  FLOAT  MOV  R0,R0             ALREADY FLOATING?
00D6 162E   235         JNE  FNRM4             Y, RTWP
00D8 0203   236         LI   R3,>44            N, GET EXPONENT
00DA 0044 
00DC 04C2   237         CLR  R2                CLEAR LOW
00DE C041   238         MOV  R1,R1             CHECK SIGN
00E0 1504   239         JGT  FLOAT1            POSITIVE
00E2 132C   240         JEQ  FCLRP             ZERO
00E4 0501   241         NEG  R1                NEGATIVE
00E6 0203   242         LI   R3,>C4            NEGATE EXPONENT
00E8 00C4 
            243  *
00EA D001   244  FLOAT1 MOVB R1,R0             SHIFT 1 BYTE LEFT
00EC 1303   245         JEQ  FLOAT2            SHIFT 2 BYTES
00EE 06C0   246         SWPB R0
00F0 0A81   247         SLA  R1,8
00F2 100D   248         JMP  FNRM2
            249  *
00F4 C001   250  FLOAT2 MOV  R1,R0             SHIFT 2 BYTES
00F6 04C1   251         CLR  R1
00F8 0643   252         DECT R3                ADJUST EXPONENT
00FA 1009   253         JMP  FNRM2
ASM990 2.4.6     FP                         Sun Jul 20 19:28:51 2025 Page 0009
FLOATING POINT ROUTINES - CORTEX BASIC REV. 1.1

            255  *
            256  *       FPAC IS NORMALIZED SUCH THAT THERE EXISTS
            257  *       A NON-ZERO HEX DIGIT IN BITS 8-11 OF THE 1ST
            258  *       WORD OF FPAC.
            259  *
            260  * CALL SEQUENCE:
            261  *
            262  *       XOP XX,7        WHERE XX IS NOT USED
            263  *
            264  * EXTERNAL ROUTINE LIST:
            265  *
            266  *       FCLR            ;CLEAR FPAC
00FC 04C3   267  FNRM   CLR  R3                CLEAR R3
00FE D0C0   268         MOVB R0,R3             GET EXPONENT & SIGN
0100 6003   269         S    R3,R0             REMOVE FROM NUMBER
0102 1604   270         JNE  FNRM1             LOOK FOR ZERO
0104 C041   271         MOV  R1,R1
0106 1602   272         JNE  FNRM1
0108 C082   273         MOV  R2,R2
010A 1314   274         JEQ  FNRM4             ZERO, RETURN
            275  *
010C 06C3   276  FNRM1  SWPB R3                READY FOR DECREMENTING
            277  *
010E 2420   278  FNRM2  CZC  @CF0,R0           NORMALIZED?
0110 0000 
0112 160E   279         JNE  FNRM3             Y
0114 24E0   280         CZC  @C7F,R3           N, EXPONENT=ZERO?
0116 0000 
0118 1311   281         JEQ  FCLRP             Y, CANNOT NORMALIZE
011A 0603   282         DEC  R3                N, OK TO DECREMENT
011C 0A40   283         SLA  R0,4              SHIFT R0,R1,R2 4 BITS LEFT
011E C241   284         MOV  R1,R9
0120 09C9   285         SRL  R9,12
0122 A009   286         A    R9,R0             MOVE 1ST HEX DIGIT ACROSS
0124 0A41   287         SLA  R1,4
0126 C242   288         MOV  R2,R9
0128 09C9   289         SRL  R9,12
012A A049   290         A    R9,R1             MOVE 2ND HEX DIGIT ACROSS
012C 0A42   291         SLA  R2,4
012E 10EF   292         JMP  FNRM2
            293  *
0130 06C3   294  FNRM3  SWPB R3                READY EXPONENT
0132 D003   295         MOVB R3,R0             MOVE INTO FPAC
0134 0380   296  FNRM4  RTWP                   RETURN

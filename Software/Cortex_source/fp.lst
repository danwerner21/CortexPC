01F0 0116'
01F2 1317   439         JEQ  FCLR              Y, CANNOT NORMALIZE
01F4 0603   440         DEC  R3                N, OK TO DECREMENT
01F6 0A40   441         SLA  R0,4              SHIFT R0,R1,R2,R10 LEFT 4 BITS
01F8 C241   442         MOV  R1,R9
01FA 09C9   443         SRL  R9,12

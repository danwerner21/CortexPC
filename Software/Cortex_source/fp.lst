            298  *
            299  *       MULTIPLY FPAC BY FLOATING POINT NUMBER
            300  *       POINTED TO BY R11.
            301  *
            302  * CALL SEQUENCE:
            303  *
            304  *       XOP XX,4
            305  *
            306  * EXCEPTIONS AND CONDITIONS:
            307  *
            308  *       ERROR 29 CAN RESULT FROM OVERFLOW
            309  *
            310  * EXTERNAL ROUTINE LIST:
            311  *
            312  *       FCLR            ;CLEAR FPAC
            313  *       FPFX            ;FIX EXPONENTS
            314  *       FAD6            ;ADD AND NORMALIZE
            315  *
            316  * ENTRY POINT:
            317  *
            318         DEF  FMD
            319  *
0136 C000   320  FMD    MOV  R0,R0             ;FPAC=0?
0138 1374   321         JEQ  FCLR              ;Y
013A C13B   322         MOV  *R11+,R4          ;FPAC X 0?
013C 1372   323  FCLRP  JEQ  FCLR              ;Y
013E C17B   324         MOV  *R11+,R5          ;N, LOAD R4,R5,R6
0140 C19B   325         MOV  *R11,R6
0142 06A0   326         BL   @FPFX             FIX EXPONENTS
0144 022A'
0146 A0C7   327         A    R7,R3
0148 FFC0   328         DATA >FFC0
            329  *
            330  *DO MULTIPLICATION
            331  *
            332  *                       R4,R5,R6
            333  *                       R0,R1,R2
            334  *                       ========
            335  *                          XX XX        A       R2 X R6
            336  *                       XX XX           B       R2 X R5
            337  *                    XX XX              C       R2 X R4
            338  *                       XX XX           D       R1 X R6
            339  *                    XX XX              E       R1 X R5
            340  *                 XX XX                 F       R1 X R4
            341  *                    XX XX              G       R0 X R6
            342  *                 XX XX                 H       R0 X R5
            343  *              XX XX                    I       R0 X R4
            344  *              -----------------
            345  *              R7,R8,R9,R10
            346  *
014A C286   347         MOV  R6,R10
014C 3A82   348         MPY  R2,R10            R10,R11 (A)
014E C206   349         MOV  R6,R8
0150 3A01   350         MPY  R1,R8             R8,R9 (D)
0152 3980   351         MPY  R0,R6             R6,R7 (G)
            352  *
0154 A289   353         A    R9,R10            SUM PARTIAL PRODUCTS (A,D,G)
0156 1701   354         JNC  $+4
0158 0588   355         INC  R8
015A A207   356         A    R7,R8

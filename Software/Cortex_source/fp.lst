             65  *
             66  *       LOAD FLOATING POINT ACCUMULATOR WITH 3RD FLOATING
             67  *       POINT NUMBER.
             68  *
             69  * CALL SEQUENCE:
             70  *
             71  *       XOP XX,0
             72  *
0008 C03B    73  FLDD   MOV  *R11+,R0          ;LOAD FPAC
000A C07B    74  FLDD1  MOV  *R11+,R1
000C C09B    75         MOV  *R11,R2
000E 0380    76  FLDD2  RTWP

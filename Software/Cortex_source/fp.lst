             78  *
             79  *       ADD OR SUBTRACT FROM FPAC A 3 WORD FLOATING
             80  *       POINT NUMBER.
             81  *
             82  * CALL SEQUENCE:
             83  *
             84  *       XOP XX,2        ;ADD TO FPAC
             85  *
             86  *       XOP XX,3        ;SUBTRACT FROM FPAC
             87  *
             88  * EXCEPTIONS AND CONDITIONS:
             89  *
             90  *       ERROR 29 CAN RESULT FROM OVERFLOW
             91  *
             92  * EXTERNAL ROUTINE LIST:
             93  *
             94  *       FLDD            ;LOAD FPAC
             95  *       FARS            ;SHIFT FPAC RIGHT 1 HEX DIGIT
             96  *       FADDI           ;ADD R4,R5,R6 TO R0,R1,R2
             97  *
             98  *
             99  *       SUBTRACTION IS MADE SIMPLY BY TOGGLING SIGN BIT
            100  *
0010 C13B   101  FSD    MOV  *R11+,R4          ;GET FIRST WORD, ZERO?
0012 13FD   102         JEQ  FLDD2             ;Y, ZERO, RETURN
0014 0224   103         AI   R4,>8000          ;N, TOGGLE SIGN BIT
0016 8000 
0018 1002   104         JMP  FAD0
            105  *
            106  *
001A C13B   107  FAD    MOV  *R11+,R4          ;GET FIRST WORD, ZERO?
001C 13F8   108         JEQ  FLDD2             ;Y, RETURN
001E C000   109  FAD0   MOV  R0,R0             ;N, FPAC ZERO?
0020 1602   110         JNE  FAD0A             ;N
0022 C004   111         MOV  R4,R0             ;Y, MOVE TEMP TO FPAC
0024 10F2   112         JMP  FLDD1
            113  *
0026 C17B   114  FAD0A  MOV  *R11+,R5          ;LOAD R4,R5,R6
0028 C19B   115         MOV  *R11,R6
002A D0C0   116         MOVB R0,R3             GET EXPONENTS
002C D1C4   117         MOVB R4,R7
002E 7000   118         SB   R0,R0             ISOLATE
0030 7104   119         SB   R4,R4
0032 0A13   120         SLA  R3,1              REMOVE SIGN
0034 1702   121         JNC  FAD1              NEGATIVE?
0036 06A0   122         BL   @FADN             Y, NEGATE
0038 00B8'
            123  *
003A 0993   124  FAD1   SRL  R3,9
003C 0A17   125         SLA  R7,1              REMOVE SIGN
003E 1708   126         JNC  FAD2              NEGATIVE?
0040 0506   127         NEG  R6                Y, NEGATE
0042 1604   128         JNE  FAD1A
0044 0505   129         NEG  R5
0046 1603   130         JNE  FAD1B
0048 0504   131         NEG  R4
004A 1002   132         JMP  FAD2
004C 0545   133  FAD1A  INV  R5
004E 0544   134  FAD1B  INV  R4
            135  *
ASM990 2.4.6     FP                         Sun Jul 20 19:28:51 2025 Page 0005
FLOATING POINT ROUTINES - CORTEX BASIC REV. 1.1

0050 020A   136  FAD2   LI   R10,10            10 SHIFTS GIVE ZERO RESULT
0052 000A 
0054 0997   137         SRL  R7,9              POSITION EXPONENT
            138  *
0056 81C3   139  FAD2A  C    R3,R7             COMPARE EXPONENTS
0058 131D   140         JEQ  FAD4              SAME, DO ADD
005A 1509   141         JGT  FAD3              SHIFT TEMP (IS R3>R7?)
005C 06A0   142         BL   @FARS             N, R3<R7, SHIFT FPAC
005E 02D2'
0060 060A   143         DEC  R10               COUNT SHIFTS
0062 16F9   144         JNE  FAD2A             OK
0064 C004   145         MOV  R4,R0             FPAC=0, MOVE TEMP TO FPAC
0066 C045   146         MOV  R5,R1
0068 C086   147         MOV  R6,R2
006A C0C7   148         MOV  R7,R3             MOVE EXPONENT
006C 100C   149         JMP  FAD3A
            150  *
006E 0946   151  FAD3   SRL  R6,4              SHIFT TEMP 1 HEX DIGIT RIGHT
0070 C245   152         MOV  R5,R9
0072 0AC9   153         SLA  R9,12
0074 A189   154         A    R9,R6             MOVE HEX DIGIT ACROSS
0076 0945   155         SRL  R5,4
0078 C244   156         MOV  R4,R9
007A 0AC9   157         SLA  R9,12
007C A149   158         A    R9,R5             MOVE HEX DIGIT ACROSS
007E 0844   159         SRA  R4,4
0080 0587   160         INC  R7                DONE, INCREMENT EXPONENT
0082 060A   161         DEC  R10               COUNT SHIFTS
0084 16E8   162         JNE  FAD2A             OK
            163  *
0086 C000   164  FAD3A  MOV  R0,R0             TEMP=0, NEED NEGATION?
0088 1553   165         JGT  FNRM3             N, FPAC OK
008A 06A0   166         BL   @FADN             Y, NEGATE FPAC
008C 00B8'
008E 0223   167         AI   R3,>80            ADD SIGN TO EXPONENT
0090 0080 
0092 104E   168         JMP  FNRM3
            169  *
0094 06A0   170  FAD4   BL   @FADDI            ADD
0096 02F2'
0098 1106   171         JLT  FAD5              NEGATIVE
009A 1509   172         JGT  FAD6              POSITIVE
009C C041   173         MOV  R1,R1
009E 1607   174         JNE  FAD6              NON-ZERO
00A0 C082   175         MOV  R2,R2
00A2 1605   176         JNE  FAD6              NON-ZERO
00A4 1047   177         JMP  FNRM4             ZERO, RTWP
            178  *
00A6 06A0   179  FAD5   BL   @FADN             NEGATE FPAC
00A8 00B8'
00AA 0263   180         ORI  R3,>80            ADD SIGN BIT
00AC 0080 
            181  *

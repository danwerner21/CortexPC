            125  ************************************************************
            126  *                                                          *
            127  *               VDP OUTPUT ROUTINES                        *
            128  *                                                          *
            129  ************************************************************
009A 0000   130  VDPDSR DATA WP9928,$+2        9928DSR ENTRY VECTOR
009E 020C   131         LI   R12,>1EE0         REF INTERNAL FLAGS
00A0 1EE0 
00A2 0204   132         LI   R4,SENDAD         REF 'SENDAD'
00A4 0000 
00A6 C020   133         MOV  @VMODE,R0         WHAT MODE ?
00A8 0000 
00AA 16AA   134         JNE  GMODE             GRAPH MODE
00AC 1030   135         JMP  TMODE             TEXT MODE
            136  ************************************************************
            137  *                                                          *
            138  *              HANDLE GRAPHIC CONTROL CHARACTERS           *
            139  *                                                          *
            140  ************************************************************
00AE 06A0   141  GCNTRL BL   @JMPR0            ;DO JUMP ON R0 (USES R1,R2)
00B0 0000 
00B2 0D     142  GJUMP  BYTE GHT-GJUMP/2,>09   HT - CURSOR RIGHT
00B4 11     143         BYTE GBS-GJUMP/2,>08   BS - CURSOR LEFT
00B6 1A     144         BYTE GLF-GJUMP/2,>0A   LF - CURSOR DOWN
00B8 1D     145         BYTE GVT-GJUMP/2,>0B   VT - CURSOR UP
00BA 22     146         BYTE GFF-GJUMP/2,>0C   FF - CLEAR SCREEN & HOME
00BC 27     147         BYTE GCR-GJUMP/2,>0D   CR - CURSOR BEGINING OF LINE
00BE E5     148         BYTE GFS-GJUMP/2,>1C   FS - CURSOR ON
00C0 E8     149         BYTE GGS-GJUMP/2,>1D   GS - CURSOR OFF
00C2 24     150         BYTE GRS-GJUMP/2,>1E   RS - CURSOR HOME
00C4 0000   151         DATA 0
00C6 0720   152         SETO @BELCNT           ILLEGAL, SET BELL COUNTER
00C8 0000 
00CA 10B5   153         JMP  GDONE             AND LOOP
            154  ************************************************************
            155  *                                                          *
            156  *              CURSOR RIGHT (HT)                           *
            157  *                                                          *
            158  ************************************************************
00CC 0228   159  GHT    AI   R8,8              NEXT CHARACTER
00CE 0008 
00D0 0694   160  GHT1   BL   *R4               POINT VDP TO IT
00D2 10CE   161         JMP  CHKBOT            AND CHECK IT
            162  ************************************************************
            163  *                                                          *
            164  *              CURSOR LEFT  (BS)                           *
            165  *                                                          *
            166  ************************************************************
00D4 0228   167  GBS    AI   R8,-8             BACKUP TO PRIOR CHARACTER
00D6 FFF8 
00D8 0694   168  GBS1   BL   *R4               SEND IT TO VDP
00DA 0288   169  CHKTOP CI   R8,PGTBA1+>4000   OFF TOP ?
00DC 4000 
00DE 14AB   170         JHE  GDONE             N, CONTINUE
00E0 0228   171         AI   R8,(32*24*8)      Y,ADD IN A SCREEN
00E2 1800 
00E4 10A7   172         JMP  GDONE1            & RESEND IT
            173  ************************************************************
            174  *                                                          *

              2         IDT  'VDPDSR'
              3         DEF  VDPDSR,D40
              4         REF  UNPACK,SENDAD,JMPR0,B20
              5         REF  FBCOL,STXT,B7F,XLOC,YLOC,VMODE
              6         REF  BITMAP,WP9928,CCSAVE,TMPBUF,BELCNT
              7         REF  CURFLG,CCNT,GCLEAR
              8  *
              9  *  SCREEN EQUATES
             10  *
     0027    11  TRHC   EQU  39                TOP RIGHT HAND CORNER
     0000    12  TLHC   EQU  0                 TOP LEFT HAND CORNER
     0398    13  BLHC   EQU  920               BOTTOM LEFT HAND CORNER
     03BF    14  BRHC   EQU  959               BOTTOM RIGHT HAND CORNER
     03C0    15  SCRSIZ EQU  BRHC-TLHC+1       SCREEN SIZE
             16  *
     2F80    17  ERROR  EQU  >2F80
     2FA0    18  ERROR2 EQU  ERROR+>20
             19  *
             20  *        INTERNAL 9995 FLAGS USED
             21  *
             22  *                                   WHEN BIT IS SET
             23  *
     0005    24  F$SHOW EQU  5                 SHOW ALL CONTROL CHARACTERS
     0006    25  F$ROLL EQU  6                 INHIBIT SCROLL
             26  *
             27         COPY 'IODEFS.INC'

            457  * CLOCK INTERRUPT ROUTINE
            458  *
            459  *      R0=FINE COUNTER
            460  *      R1=HOURS
            461  *      R2=MINUTES
            462  *      R3=SECONDS
            463  *      R4-R5=TOTAL TIC COUNTS
            464  *
     00B6'  465  CLKI   EQU  $
00B6 020C   466         LI   R12,>1EE0         REF ONCHIP DECREMENTER
00B8 1EE0
00BA 1D01   467         SBO  1                 RE-ENABLE CLOCK INTERRUPT
00BC 0620   468         DEC  @CNTDWN           COUNTDOWN
00BE ED38
00C0 C320   469         MOV  @BELCNT,R12       GET BELL COUNTER
00C2 ED42
00C4 091C   470         SRL  R12,1             COUNT
00C6 C80C   471         MOV  R12,@BELCNT       RESTORE IT
00C8 ED42
            472X        ASMIF CLKLED
            473X        LI   R12,2*CLKLED      POINT TO CLOCK LED
            474         ASMELS
00CA 04CC   475         CLR  R12
            476         ASMEND
            477  *  TEST SHIFT FROM A COUPLE OF LINES AGO
00CC 1702   478         JNC  NOBELL            NOT IN USE, LEAVE BELL ALONE
00CE 1D06   479         SBO  BELLON-CLKLED     IN USE, TURN BELL ON
00D0 1001   480         JMP  DOTIC
00D2 1E06   481  NOBELL SBZ  BELLON-CLKLED     BELL OFF
00D4 1E00   482  DOTIC  SBZ  CLKLED-CLKLED     LED ON
00D6 0280   483         CI   R0,100/2          TIME FOR LED OFF?
00D8 0032
00DA 1A01   484         JL   DOTIC1            N, LEAVE IT ON
00DC 1D00   485         SBO  CLKLED-CLKLED     Y, TURN IT OFF
00DE 0585   486  DOTIC1 INC  R5                COUNT TICS
            487  *
            488  * IF R5 = 0 THEN LEAST SIG WORD OF TIC COUNTER HAS
            489  * 'OVERFLOWED'  - UPDATE R4
            490  *
00E0 1601   491         JNE  $+4
00E2 0584   492         INC  R4
00E4 0280   493         CI   R0,99             100 TICS?
00E6 0063
00E8 1402   494         JHE  CLKI1             Y, 1 SECOND
00EA 0580   495         INC  R0                N, COUNT
00EC 1010   496         JMP  CLKI2             EXIT
            497  *
            498  * 100 TICKS HAVE OCCURED - UPDATE REAL TIME CLOCK
            499  *
00EE 04C0   500  CLKI1  CLR  R0                CLEAR FINE COUNTER
00F0 0583   501         INC  R3                COUNT SECONDS
00F2 0283   502         CI   R3,60             <60?
00F4 003C
00F6 110B   503         JLT  CLKI2             Y, RETURN
00F8 04C3   504         CLR  R3                N
00FA 0582   505         INC  R2                INCREMENT MINUTE
00FC 0282   506         CI   R2,60             <60?
00FE 003C
0100 1106   507         JLT  CLKI2             Y, RETURN
0102 04C2   508         CLR  R2                N,
ASM990 2.4.6     START                      Sun Jul 20 19:28:47 2025 Page 0016

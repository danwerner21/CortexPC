              2C *
              3C *  THIS MODULE IS INCLUDED IN SOURCE MODULES
              4C *  BY USING A 'COPY' DIRECTIVE.
              5C *
              6C *
              7C ***************
              8C *
              9C *  CRU DEFINITIONS
             10C *
             11C ***************
     0000    12C PIO    EQU  >0000             PARALLEL I/O
             13C *  PARALLEL I/O - READ BITS
     0000    14C KDS    EQU  PIO+0             KEYBOARD DATA STROBE
             15C *      EQU  PIO+1             UNUSED
     0002    16C D1$SIZ EQU  PIO+2             DS01 SIZE (1=8",0=5.25")
     0003    17C D1$DEN EQU  PIO+3             DS01 DENSITY (0=SD,1=DD)
     0004    18C FDCINT EQU  PIO+4             FDC INTERRUPT-
     0005    19C KBDINT EQU  PIO+5             KBD INTERRUPT-
     0006    20C VDPINT EQU  PIO+6             VDP INTERRUPT-
     0007    21C BUSINT EQU  PIO+7             BUS INTERRUPT-
     0008    22C KEYBRD EQU  PIO+8             KEYBOARD  DATA (8 BITS)
             23C *  PARALLEL I/O - WRITE BITS
     0000    24C CLKLED EQU  PIO+0             CLOCK LED
     0001    25C KBDACK EQU  PIO+1             KEYBOARD ACKNOLEDGE-
     0002    26C BUSACK EQU  PIO+2             BUS INTERRUPT RESET-
     0003    27C BTENBL EQU  PIO+3             BUS TIMEOUT FLAG ENABLE
     0004    28C DRVSIZ EQU  PIO+4             DRIVE SIZE (1=8",0=5.25")
     0005    29C ROMON  EQU  PIO+5             0=ROM ON,1=ROM OFF
     0006    30C BELLON EQU  PIO+6             BELL ENABLE BIT
             31C *      EQU  PIO+7             UNUSED
             32C *
             33C *      EQU  >0020             UNUSED
     0040    34C EIA02  EQU  >0040             PRINTER HARDWARE BASE ADDRESS
             35C *      EQU  >0060             UNUSED
             36C *      EQU  >0080             UNUSED
             37C *      EQU  >00A0             UNUSED
     00C0    38C CASS02 EQU  >00C0             CASSETTE HARDWARE BASE ADDRESS
     00E0    39C DMAC   EQU  >00E0             DMAC HARDWARE BASE ADDRESS
             40C *
             41C *  RESERVED OFF-BOARD CRU LOCATIONS
     0200    42C PRMPOP EQU  >200              PROM PROGRAMMER BOARD
             43C * READ BITS
             44C *      EQU  PRMPOP+0
             45C *      EQU  PRMPOP+1
             46C *      EQU  PRMPOP+2
             47C *      EQU  PRMPOP+3
     0204    48C PRORDY EQU  PRMPOP+4
     0205    49C PGM    EQU  PRMPOP+5
     0206    50C PGMPUL EQU  PRMPOP+6          * TEST
     0207    51C V30    EQU  PRMPOP+7
     0208    52C EDATA  EQU  PRMPOP+8
             53C * WRITE BITS
     0200    54C PRORST EQU  PRMPOP+0
     0201    55C EPTYPE EQU  PRMPOP+1
     0204    56C VCCON  EQU  PRMPOP+4
             57C *PGM   EQU  PRMPOP+5
     0206    58C PROERR EQU  PRMPOP+6
             59C *      EQU  PRMPOP+7
             60C *EDATA EQU  PRMPOP+8
     0210    61C EPADR  EQU  PRMPOP+16

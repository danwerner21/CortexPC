0088 0181   419         DATA (2*CASS02)+>0001  3-CASS. 9902, NO CR DELAY
008A 0000   420         DATA CENTRO            4-CENTRONICS PRINTER
008C 0000   421         DATA 0                 5-UNUSED DEVICE
008E 0000   422         DATA 0                 6-UNUSED DEVICE
0090 0000   423         DATA 0                 7-UNUSED DEVICE
0092 0000   424         DATA 0                 8-UNUSED DEVICE
0094 0000   425         DATA 0                 9-UNUSED DEVICE
0096 0000   426         DATA 0                 10-UNUSED DEVICE
0098 0000   427         DATA 0                 11-UNUSED DEVICE
009A 0000   428         DATA 0                 12-UNUSED DEVICE
009C 0000   429         DATA 0                 13-UNUSED DEVICE
009E 0000   430         DATA 0                 14-UNUSED DEVICE

ASM990 2.4.6     POLY                       Sun Aug 10 23:07:36 2025 Page 0001
POLYNOMIAL ROUTINES - CORTEX BASIC REV. 1.1

              2         IDT  'POLY'
              3  *
              4  * ROUTINE LIST:
              5  *
              6  *       FUNBK           ;BREAK FPAC INTO INTEGER & FRACTION
              7  *       FUNFX           ;FIX FPAC INTO EXPONENT AND ABSOLUTE VA
              8  *       PLYX            ;EVALUATE P(X) WITH X IN TEMP
              9  *       PLYXX           ;EVALUATE P(X*X) WITH X IN FPAC
             10  *
             11         DXOP LOADF,0           ;LOAD FPAC
             12         DXOP STORE,1           ;STORE FPAC
             13         DXOP FADD,2            ;ADD TO FPAC
             14         DXOP FSUB,3            ;SUBTRACT FROM FPAC
             15         DXOP FMUL,4            ;MULTIPLY FPAC
             16         DXOP FDIV,5            ;DIVIDE FPAC
             17         DXOP SCALE,6           ;SCALE FPAC
             18         DXOP NORMAL,7          ;NORMALIZE FPAC
             19         DXOP CLEAR,8           ;CLEAR FPAC
             20         DXOP NEGATE,9          ;NEGATE FPAC
             21         DXOP FLOATF,10         ;FLOAT FPAC
     2F80    22  ERROR  EQU  >2F80             ;XOP XX,14  (ERROR CALL)
             23  *
             24         REF  FPAC,FPAC4        ;FLOATING POINT ACCUMULATOR
             25         REF  TEMP              ;3 WRD TEMPORARY STORAGE
             26         REF  C4A00             ;>4A00
             27         DEF  FUNBK,FUNFX
             28         DEF  PLYX,PLYXX
ASM990 2.4.6     POLY                       Sun Aug 10 23:07:36 2025 Page 0002

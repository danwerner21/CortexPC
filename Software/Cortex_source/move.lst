MOVE ROUTINES - CORTEX BASIC REV. 1.1

              2          IDT  'MOVE'
              3  *
              4  *       BMVE            ;BYTE MOVE
              5  *
              6  *       MOVE BYTES FROM (R2) TO (R7) WATCHING FOR
              7  *       BACKSPACES AND HEX CHARACTERS IN
              8  *       ANGLE BRACKETS.  ALSO WATCH FOR
              9  *       BUFFER OVERFLOW.
             10  *
             11  * CALLING SEQUENCE:
             12  *
             13  *       BL @BMVE
             14  *         MOVE OK
             15  *       OVERFLOW
             16  *
             17  *       IN  R2 = SOURCE
             18  *           R5 = MAX COUNT
             19  *           R7 = DESTINATION
             20  *       OUT R3 = -(# OF <10>)*2
             21  *
             22         DEF BMVE
             23         REF  IOB,B08,B3C
             24  *
0000 04C3    25  BMVE    CLR R3          ;RESET BS COUNT
             26  *
0002 D5F2    27  BMVE0   MOVB *R2+,*R7   ;MOVE BYTE
0004 130D    28            JEQ BMVE2     ;DONE
0006 9817    29          CB *R7,@B3C     ;"<?
0008 0000 
000A 130B    30            JEQ BMVE3     ;Y
000C 0587    31  BMVE1   INC R7          ;N
000E C2A0    32          MOV @IOB,R10     ;GET IOB
0010 0000 
0012 060A    33          DEC R10         ;BACKUP TO LAST BYTE
0014 8287    34          C R7,R10        ;ABOUT TO STORE IN LAST BYTE?
0016 1303    35            JEQ BMVE6     ;Y, QUIT
0018 0605    36          DEC R5          ;MORE ROOM?
001A 15F3    37            JGT BMVE0     ;Y
001C 05CB    38          INCT R11        ;N, RETURN 2(11)
             39  *
001E 75D7    40  BMVE6   SB *R7,*R7      ;MARK
             41  *
0020 045B    42  BMVE2  B    *R11
             43  *
0022 04C1    44  BMVE3   CLR R1          ;BUILD # IN R1
0024 C282    45          MOV R2,R10      ;SAVE R2
             46  *
0026 04C0    47  BMVE4   CLR R0
0028 D03A    48          MOVB *R10+,R0   ;GET NEXT CHARACTER
002A 0220    49          AI R0,->3000
002C D000 
002E 110E    50            JLT GHEX2
0030 0280    51          CI R0,>0900
0032 0900 
0034 1208    52            JLE GHEX1
0036 0220    53          AI R0,->0700
0038 F900 
003A 0280    54          CI R0,>0A00
003C 0A00 
003E 1106    55            JLT GHEX2
ASM990 2.4.6     MOVE                       Sun Aug 10 23:07:34 2025 Page 0002

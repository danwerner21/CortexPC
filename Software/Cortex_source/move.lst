0040 0280    56          CI R0,>0F00
0042 0F00 
0044 1B03    57            JH GHEX2
0046 0A41    58  GHEX1   SLA R1,4        ;SHIFT R1
0048 B040    59          AB R0,R1        ;ADD NEW DIGIT
004A 10ED    60          JMP BMVE4
             61  *
     004C'   62  GHEX2   EQU $
004C 0280    63  BMVE5   CI R0,>3E00->3700       ;">?
004E 0700 
0050 16DD    64            JNE BMVE1     ;N, DISREGUARD #
0052 D041    65         MOVB R1,R1        ;ARE WE GOING TO MOVE IN A NULL?
0054 13DB    66         JEQ  BMVE1        Y, IGNORE
0056 C08A    67          MOV R10,R2      ;Y, SET R2
0058 D5C1    68          MOVB R1,*R7     ;MOVE INTO STRING
005A 9801    69          CB R1,@B08      ;BS?
005C 0000 
005E 16D6    70            JNE BMVE1     ;N
0060 0643    71          DECT R3         ;Y, COUNT
0062 10D4    72          JMP BMVE1
             73         END

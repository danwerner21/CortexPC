            153  *      NOW DUMP TO TAPE
            154  *
0096 006A'  155  SAV6   DATA TYPSN$,CASRDY     CASSETTE READY PROMPT
009A 06A0   156         BL   @YORN             GET RESPONSE
009C 026E'
009E 10FB   157         JMP  SAV6              NEITHER
00A0 1001   158         JMP  SAV7              Y
00A2 10F9   159         JMP  SAV6              N, LOOP
            160  *
00A4 0720   161  SAV7   SETO @PLF              FLAG AS SAVING (-VE)
00A6 0000 
00A8 06A0   162         BL   @SET02            GO SET UP 9902
00AA 028E'
00AC 0000   163         DATA CMON$             TURN TAPE MOTOR ON
00AE C0E0   164         MOV  @UNIT,R3          SAVE UNIT FLAGS
00B0 0000 
00B2 C820   165         MOV  @C0004,@UNIT      SET UNIT FOR CASSETTE ONLY
00B4 0000 
00B6 00B0'
00B8 C820   166         MOV  @D200,@CNTDWN     SET FOR 2 SEC. START UP
00BA 010C'
00BC 0000 
00BE 0000   167  SNDSYN DATA TYP11$,SYN        SEND SYNC CHARACTER
00C2 C020   168         MOV  @CNTDWN,R0        DONE STARTUP ?
00C4 00BC'
00C6 15FB   169         JGT  SNDSYN            LOOP TILL ENOUGH SENT
00C8 00BE'  170         DATA TYP11$,STX        SEND STX
00CC 0201   171         LI   R1,DMYHDR         POINT TO HEADER BLOCK
00CE 0060'
00D0 D035   172  DUMP   MOVB *R5+,R0           GET BYTE
00D2 0000   173         DATA TYP0$             SEND IT
00D4 0285   174         CI   R5,DH$END         DONE HEADER?
00D6 0000 
00D8 16FB   175         JNE  DUMP              N, LOOP
            176  *
            177  * NOW DUMP THE PROGRAM
            178  *
00DA C060   179         MOV  @DH$PLL,R1        GET LENGTH
00DC 0000 
00DE 04C7   180         CLR  R7                RESET CHECK COUNTER
00E0 D039   181  DUMP1  MOVB *R9+,R0           GET BYTE
00E2 00D2'  182         DATA TYP0$             SEND IT
00E4 0980   183         SRL  R0,8              PUT IN LSB
00E6 A1C0   184         A    R0,R7             ADD IN TO CHECKSUM
00E8 0601   185         DEC  R1                DONE?
00EA 16FA   186         JNE  DUMP1             N, LOOP
            187  *

00F4 06C0   191         SWPB R0                POSITION LSB
00F6 00F2'  192         DATA TYP0$             SEND LSB
            193  *
00F8 C820   194         MOV  @D100,@CNTDWN     SET FOR 1 SECOND DELAY
00FA 0000 
00FC 00C4'

            107  *
            108  *
            109  *     ENTRY POINT FOR BASIC 'SAVE' COMMAND
            110  *
0032 06A0   111  SAVY   BL   @MODEOK           CHECK NOT RUNNING
0034 0000 
0036 0201   112         LI   R1,DH$SLT         OK, REF THE SLT ENTRY
0038 000C'
003A 020A   113         LI   R10,PRDY          RETURN TO 'READY*'
003C 0000 
003E C260   114         MOV  @BUS,R9           GET BUS
0040 0000 
0042 C460   115         MOV  @SLT,*R1          COPY IN THE SLT
0044 0000 
0046 6C49   116         S    R9,*R1+           SUBTRACT BUS
0048 C460   117         MOV  @VNT,*R1          COPY IN THE VNT
004A 0000 
004C 6C49   118         S    R9,*R1+           SUBTRACT BUS
004E C460   119         MOV  @NVD,*R1          COPY IN THE NVD
0050 0000 
0052 6C60   120         S    @VDT,*R1+         CALCULATE NVD-VDT (VAR NAMES)
0054 0000 
0056 C460   121         MOV  @NVD,*R1          CALCULATE LOAD LENGTH FROM
0058 0050'
005A 6449   122         S    R9,*R1                  NVD-BUS
005C 0588   123         INC  R8                SKIP THE QUOTE ON "NAME"
            124  *
            125  *      SET UP DUMMY HEADER
            126  *
005E 0201   127  SAV0   LI   R1,DMYHDR         POINT TO DUMMY HEADER
0060 0000 
0062 C101   128         MOV  R1,R4             SAVE FOR LATER
0064 C141   129         MOV  R1,R5             SAVE FOR LATER
0066 0202   130         LI   R2,IDRUN          SET FOR AUTO-RUN
0068 0000 
006A 001C'  131  SAV1   DATA TYPSN$,AUTORN     AUTO-RUN PROMPT
006E 06A0   132         BL   @YORN             GET REPLY
0070 026E'
0072 10FB   133         JMP  SAV1              LOOP IF NOT A 'Y' OR 'N'
0074 1001   134         JMP  SAV2              Y, R2 SET UP OK
0076 0542   135         INV  R2                N, SET FOR NO AUTORUN
0078 CC42   136  SAV2   MOV  R2,*R1+           STORE AUTO-RUN FLAG
007A 0202   137         LI   R2,8              MAX OF 8 CHARACTERS
007C 0008 
007E D018   138  SAV3   MOVB *R8,R0            GET CHARACTER
0080 1301   139         JEQ  SAV4              0, END OF NAME
0082 0588   140         INC  R8                MOVE TO NEXT CHARACTER
0084 DC40   141  SAV4   MOVB R0,*R1+           COPY NAME
0086 0602   142         DEC  R2                LIMIT?
0088 16FA   143         JNE  SAV3              N, LOOP
            144  *
            145  * NOW WORK OUT THE CHECKSUM
            146  *
008A 0201   147         LI   R1,DH$HCS         REF HEADER CHECKSUM WORD
008C 0000 
008E 04D1   148         CLR  *R1               CLEAR CHECKSUM
0090 A474   149  SAV5   A    *R4+,*R1          ADD IN HEADER WORD
0092 8044   150         C    R4,R1             DONE
0094 1AFD   151         JL   SAV5              N, LOOP
            152  *

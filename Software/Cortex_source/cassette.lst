0148 028E'
014A 00AC'  254         DATA CMON$             TURN MOTOR ON
            255  *
            256  *  LOOK FOR SOME 'SYN' CHARACTERS
            257  *
014C 04C7   258  NOSYN  CLR  R7                RESET 'SYN' COUNT
014E 0000   259  FNDSYN DATA GETCR$            GET A CHARACTER
0150 0280   260         CI   R0,STX            'STX' CHARACTER
0152 0200 
0154 1305   261         JEQ  SYN$1             Y, CHECK IF THIS IS OK
0156 0280   262         CI   R0,SYN            N, IS IT A 'SYN'
0158 1600 
015A 16F8   263         JNE  NOSYN             N, RESET COUNTER
015C 0587   264         INC  R7                Y, COUNT IT
015E 10F7   265         JMP  FNDSYN            LOOK FOR SOME MORE
            266  *
            267  * 'STX' FOUND - IS THIS OK ?
            268  *
0160 0287   269  SYN$1  CI   R7,6              HAVE WE FOUND ENOUGH ?
0162 0006 
0164 1AF3   270         JL   NOSYN             N, KEEP LOOKING
            271  *                             Y, IS THE NEXT WORD THE HEADER
0166 014E'  272         DATA GETCR$            GET BYTE
0168 D1C0   273         MOVB R0,R7             SAVE IT
016A 0987   274         SRL  R7,8              POSITION
016C 0166'  275         DATA GETCR$            GET 2ND BYTE
016E D1C0   276         MOVB R0,R7             ADD IT IN
0170 0287   277         CI   R7,IDRUN          IS IT A RUNID?
0172 0068'
0174 1305   278         JEQ  SYN$2             Y, FOUND HEADER
0176 0547   279         INV  R7                N, MAYBE NOT AUTO-RUN
0178 0287   280         CI   R7,IDRUN          IS IT OK?
017A 0172'
017C 16E7   281         JNE  NOSYN             N, NOT THE HEADER BLOCK
017E 0547   282         INV  R7                Y, RESTORE ID WORD
            283  *
            284  *   HEADER BLOCK FOUND, R7 CONTAINS THE AUTO-RUN FLAG
            285  *

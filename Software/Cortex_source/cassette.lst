              5         REF  B43,CMON$,CMOF$,DH$HCS,DH$END,DH$PLL,ERR3$M
              6         REF  UNIT,C0004,D100,CNTDWN,TYP11$,TYP0$,DELAY$
              7         REF  MODEOK,IDRUN,AUTORN,TYPSN$,CASRDY,PLF,GETC$
              8         REF  MODE,GTLN,IOB,BUS,GETCR$
              9         REF  NEWP,NVD,RUNP,SLT,STRTC,TAPERR,VDT,VNT
             10         REF  TYPS$,DH$SIZ,DH$ARF,PGMFND,CALLWP
             11         REF  ESCFLG,EFIX$E,IDTEQ,WPR1
             12  *
     2F80    13  ERROR  EQU  >2F80
     2FA0    14  ERROR2 EQU  ERROR+>20
             15  *
             16         DXOP EVFIX,11
     1600    17  SYN    EQU  >1600             TAPE SYNC CHARACTER
     0200    18  STX    EQU  >0200             TAPE START OF TEXT CHARACTER
     0300    19  ETX    EQU  >0300             TAPE END OF TEXT CHARACTER
             20  ************************************************************
             21  *
             22  *          TAPE/EPROM HEADER BLOCKS
             23  *
             24  *          BASIC               MACHINE CODE
             25  *   ********************   ******************** RUN  =>A5A5
             26  *   *  AUTO RUN FLAG   *   *  AUTO RUN FLAG   * NORUN=>5A5A
             27  *   ********************   ********************
             28  *   *   8 BYTE NAME    *   *   8 BYTE NAME    * NULL FILLED
             29  *   ********************   ********************
             30  *   *   DISP TO SLT    *   *       >0000      *
             31  *   ********************   ********************
             32  *   *   DISP TO VNT    *   *   LOAD ADDRESS   *
             33  *   ********************   ********************
             34  *   *     NVD - VDT    *   *   ENTRY POINT    * (OFFSET)
             35  *   ********************   ********************
             36  *   *   LOAD LENGTH    *   *   LOAD LENGTH    * (BYTES)
             37  *   ********************   ********************
             38  *   *     CHECKSUM     *   *     CHECKSUM     * HEADER ONLY
             39  *   ********************   ********************
             40  *
             41  *DMYHDR EQU  $
             42  *DH$ARF BSS  2            RUN/NORUN
             43  *DH$PGN BSS  8            PROGRAM NAME
             44  *DH$SLT BSS  2            DISP TO SLT
             45  *DH$VNT BSS  2            DISP TO VNT
             46  *DH$SIZ BSS  2            NVD-VDT
             47  *DH$PLL BSS  2            LENGTH
             48  *DH$HCS BSS  2            HEADER CHECKSUM
             49  *HDRSIZ EQU  $-DMYHDR     HEADER BLOCK SIZE
             50  *DH$END EQU  $            END OF DUMMY HEADER
             51  ****************
             52         COPY 'IODEFS.INC'

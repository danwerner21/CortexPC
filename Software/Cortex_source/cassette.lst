             76  *
             77  ************************************************************
             78  *                                                          *
             79  * MONITOR DUMP ROUTINE -- 'D' COMMAND                      *
             80  *                                                          *
             81  * DUMP RAM IMAGE TO CASSETTE TAPE IN IMAGE FORMAT          *
             82  *     R0 = START   R1=STOP    R2=ENTRY POINT               *
             83  *                                                          *
             84  ************************************************************
0000 4088    85  MC$SAV SZC  R8,R2             WORD ALIGN ENTRY POINT
             86  *
             87  * START ADDRESS > STOP ADDRESS--ERROR
             88  *
0002 8040    89         C    R0,R1             START <= STOP ?
0004 1202    90         JLE  ADDROK            YES
0006 0460    91         B    @ERR3$M           ERROR EXIT TO MONITOR
0008 0000 
000A 0204    92  ADDROK LI   R4,DH$SLT         REF HDR SLT ENTRY
000C 0000 
000E 04F4    93         CLR  *R4+              CLEAR IT (FLAGS AS M/C)
0010 CD00    94         MOV  R0,*R4+           SAVE LOAD ADDRESS
0012 C240    95         MOV  R0,R9             SAVE IT FOR SAV0
0014 CD02    96         MOV  R2,*R4+           SAVE ENTRY POINT
0016 6040    97         S    R0,R1             GET LENGTH
0018 C501    98         MOV  R1,*R4            SAVE LENGTH
001A C28B    99         MOV  R11,R10           SAVE RETURN ADDRESS
001C 0000   100         DATA TYPSN$,IDTEQ      PROMPT FOR IDT
0020 0720   101         SETO @MODE             STOP GETLIN USING ^E
0022 0000 
0024 04E0   102         CLR  @ESCFLG           MAKE SURE HE CAN BOM OUT
0026 0000 
0028 06A0   103         BL   @GTLN             GET A LINE
002A 0000 
002C C220   104         MOV  @IOB,R8           GET ITS START
002E 0000 
0030 1016   105         JMP  SAV0              DO SAVE

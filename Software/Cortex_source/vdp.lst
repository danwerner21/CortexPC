            199  *
            200  *             CHAR STATEMENT
            201  *            ================
            202  *
            203  *      FORMAT :
            204  *           CHAR EXP1,EXP2,EXP3,EXP4
            205  *      OR
            206  *           CHAR
            207  *
            208  *      THIS STATEMENT RE-DEFINES A CHARACTER.
            209  *           EXP1 - CHARACTER NUMBER   0..255
            210  *           EXP2 - FIRST 16 BITS OF DEFINITION
            211  *           EXP3 - SECOND 16 BITS OF DEFINITION
            212  *           EXP4 - THIRD 16 BITS OF DEFINITION
            213  *
            214  *      IF THE STATEMENT IS ENTERED WITHOUT PARAMETERS
            215  *      THEN THE CHARACTERS 0..127 ARE RE-LOADED WITH
            216  *      THEIR INITIAL PATTERNS.
            217  *
00F6 06A0   218  LDCSY  BL   @CKEX             EXPRESSIONS ?
00F8 0000 
00FA 1017   219         JMP  RELOAD            N, RELOAD CHARACTERS 0..127
00FC 2EC5   220         EVFIX R5               Y, GET CHARACTER #
00FE 0285   221         CI   R5,255            VALID CHARACTER ?
0100 00FF 
0102 1B5B   222         JH   ERR35             N, ERROR IT
0104 0204   223         LI   R4,3              DO 3 PARAMETERS
0106 0003 
0108 02A6   224         STWP R6
010A 05C6   225         INCT R6                AND SAVE IN R1-R3
            226  *
010C 0280   227  GETBIT CI   R0,>3F00          ',' ?
010E 3F00 
0110 1656   228         JNE  ERR37             N, ERROR IT
0112 2EF6   229         EVFIX *R6+             GET BIT PATTERN
0114 0604   230         DEC  R4                COUNT IT
0116 16FA   231         JNE  GETBIT
            232  *
0118 3960   233         MPY  @C0006,R5         FORM INDEX INTO TABLE
011A 02EE'
011C 0226   234         AI   R6,PCHTB          ADD IN TABLE START
011E 0000 
0120 CD81   235         MOV  R1,*R6+           UPDATE TABLE ENTRY
0122 CD82   236         MOV  R2,*R6+
0124 CD83   237         MOV  R3,*R6+
     0126'  238  EFIX$E EQU  $            <<< EXIT FOR AN EVFIX ROUTINE >>>
0126 0608   239  FNLIN0 DEC  R8                BACKUP TO DELIM
0128 10E2   240         JMP  TGEXIT            EXIT
            241  *
            242  *   RELOAD CHARACTERS 0..USERCS
            243  *
     012A'  244  RELOAD EQU  $
            245X        ASMIF PIO
            246X        LI   R12,2*PIO
            247         ASMELS
012A 04CC   248         CLR  R12
            249         ASMEND
012C 0201   250         LI   R1,PCHTB          POINT TO START OF C. SET
012E 011E'
            251  *

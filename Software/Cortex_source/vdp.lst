            483  *      THESE ROUTINES UNPACK ENTRIES FROM THE
            484  *      CHARACTER GENERATOR TABLE AND EITHER LOAD THEM
            485  *      INTO THE VDP OR SAVE THEM IN A 8 BYTE STORAGE
            486  *      AREA CALLED 'BITMAP'. LDCS ALSO SETS UP THE PNT
            487  *
            488  * CALLING SEQUENCE:
            489  *      BLWP @UNPACK
            490  *
            491  * IN : R0   MSB=CHARACTER CODE TO BE UNPACKED
            492  * OUT:      BIT PATTERN IN 'BITMAP'
            493  *
            494  *
            495  * CALLING SEQUENCE:
            496  *      BLWP @LDCS
            497  * OUT:  CHARACTERS WRITTEN TO PGT
            498  *       PNT INITIALIZED
            499  *
            500  *   WORKSPACE       :    VDPWP1
            501  *   ROUTINE(S)      :    UNPACK,LDCS
            502  *   REGISTER USAGE  :
            503  *                                              GLOBAL DATA
            504  *           ___________________________________   LABELS
            505  *   R0      !                                 !
            506  *   R1      !                                 !
            507  *   R2      !                                 !
            508  *   R3      !         BIT COUNTER             !
            509  *   R4      !            ADDER                !
            510  *   R5      !  2     UNPACKED DATA            !
            511  *   R6      !         PACKED DATA             !
            512  *   R7      !       COMPARE BIT MASK          !
            513  *   R8      !      VRAM/STORAGE ADDRESS       !
            514  *   R9      !      STORAGE INCREMENT          !
            515  *   R10     !         BYTE COUNT              !
            516  *   R11     !        BL RETURN ADDRESS        !
            517  *   R12     !        TABLE POINTER            !
            518  *   R13     !          RETURN WP              !
            519  *   R14     !          RETURN PC              !
            520  *   R15     !          RETURN ST              !
            521  *           -----------------------------------
ASM990 2.4.6     VDP                        Sun Jul 20 19:28:48 2025 Page 0019
VDP ROUTINES - CORTEX BASIC REV. 1.1

028E 0000   523  UNPACK DATA VDPWP1,$+2
0292 0208   524         LI   R8,BITMAP         STORE IN 'BITMAP'
0294 00AC'
0296 0209   525         LI   R9,1              STORAGE INCREMENT = 1
0298 0001 
029A C2DD   526         MOV  *R13,R11          CHARACTER # FROM CALLERS R0
029C 098B   527         SRL  R11,8             PUT IN LSB
029E 3AE0   528         MPY  @C0006,R11        CALCULATE INDEX INTO TABLE
02A0 02EE'
02A2 022C   529         AI   R12,PCHTB         ADD IN TABLE START
02A4 012E'
02A6 020A   530         LI   R10,8             UNPACK 8 BYTES WORTH
02A8 0008 
02AA 101A   531         JMP  MOD0              UNPACK
            532  *
02AC 028E'  533  LDCS   DATA VDPWP1,$+2
            534  * WRITE PATTERN NAMES TO PNT
02B0 0208   535         LI   R8,NTBA+>4000     REFERENCE PNT
02B2 4400 
02B4 06A0   536         BL   @SENDAD           SEND ADDRESS TO VDP
02B6 0238'
02B8 0709   537         SETO R9                RESET COUNT
02BA 0589   538  LDCS1  INC  R9                NEXT NAME
02BC 06C9   539         SWPB R9                POSITION LSB
02BE D809   540         MOVB R9,@VRAM          WRITE IT
02C0 F120 
02C2 06C9   541         SWPB R9                RESTORE R9
02C4 0289   542         CI   R9,40*24          PNT FULL?
02C6 03C0 
02C8 1AF8   543         JL   LDCS1             N, LOOP
            544  * WRITE CHARACTER SET TO PGT
02CA 0208   545         LI   R8,PGBA+>4000     REFERENCE PGT
02CC 4800 
02CE 06A0   546         BL   @SENDAD           SEND ADDRESS TO VDP
02D0 02B6'
02D2 0208   547         LI   R8,VRAM           STORE IN VRAM
02D4 F120 
02D6 04C9   548         CLR  R9                STORAGE INCREMENT = 0
02D8 020C   549         LI   R12,PCHTB         START AT BEGINNING OF TABLE
02DA 02A4'
02DC 020A   550         LI   R10,256*8         CALCULATE UNPACKED SIZE
02DE 0800 
            551  *
            552  *  FALL THROUGH TO 'MOD0'
            553  *
            554  *
            555  * UNPACK CHARACTER GENERATOR TABLE
            556  *
02E0 0207   557  MOD0   LI   R7,>0101          SET SHIFT MASK
02E2 0101 
02E4 0706   558         SETO R6                INIT. HOLDING REGISTER
02E6 04C5   559  MOD1   CLR  R5                INIT. DATA REGISTER
02E8 0204   560         LI   R4,>0001          INIT. ADDER
02EA 0001 
02EC 0203   561         LI   R3,6              DO 6 BITS
02EE 0006 
     02EE'  562  C0006  EQU  $-2
02F0 0B14   563  MOD2   SRC  R4,1              POSITION ADDER
02F2 0B17   564         SRC  R7,1              POSITION MASK, NEW BYTE?
02F4 1701   565         JNC  MOD3              N, SKIP
ASM990 2.4.6     VDP                        Sun Jul 20 19:28:48 2025 Page 0020
VDP ROUTINES - CORTEX BASIC REV. 1.1

02F6 D1BC   566         MOVB *R12+,R6          Y, GET NEW BYTE
02F8 2187   567  MOD3   COC  R7,R6             HAVE WE A '1' HERE ?
02FA 1601   568         JNE  MOD4              N, VALUE OK
02FC B144   569         AB   R4,R5             Y, ADD IN ADDER
02FE 0603   570  MOD4   DEC  R3                COUNT BIT
0300 15F7   571         JGT  MOD2              LOOP TILL 6 BITS DONE
0302 D605   572         MOVB R5,*R8            STORE UNPACKED BYTE
0304 A209   573         A    R9,R8             UPDATE STORAGE POINTER
0306 060A   574         DEC  R10               COUNT BYTE
0308 15EE   575         JGT  MOD1              LOOP TILL ALL BYTES DONE
030A 0380   576         RTWP                   DONE, RETURN TO CALLER
ASM990 2.4.6     VDP                        Sun Jul 20 19:28:48 2025 Page 0021
VDP ROUTINES - CORTEX BASIC REV. 1.1

            578  *      THIS ROUTINE SETS,RESETS OR TESTS A SPECIFIED
            579  *      PIXEL,DEPENDING ON ENTRY POINT. IF REFERENCE IS MADE
            580  *      TO A PIXEL OFF SCREEN THEN AN IMMEDIATE RETURN IS
            581  *      MADE.
            582  *
            583  * CALLING SEQUENCE:
            584  *      BLWP @PIXOFF           RESET PIXEL
            585  *           OR
            586  *      BLWP @PIXON            SET PIXEL
            587  *           OR
            588  *      BLWP @PIXTST           TEST PIXEL
            589  *      DATA <BYTE REPLY ADDRESS>
            590  *
            591  * IN : XLOC = X CO-ORDINATE
            592  *      YLOC = Y CO-ORDINATE
            593  *      FBCOL= FGND./BGND. COLOURS
            594  *
            595  * OUT  ST2  = BIT STATUS (PIXTST ONLY)
            596  *
            597  *   WORKSPACE       :    VDPWP0
            598  *   ROUTINE(S)      :    PIXON,PIXOFF,SENDAD
            599  *   REGISTER USAGE  :
            600  *                                              GLOBAL DATA
            601  *           ___________________________________   LABELS
            602  *   R0      ! TMP. STORAGE  !  SHIFT COUNT    !
            603  *   R1      !     X-LOC     !    Y-LOC        !  XLOC,YLOC
            604  *   R2      !                                 !
            605  *   R3      !                                 !
            606  *   R4      !      **** RESERVED ****         !  BITMAP 0,1
            607  *   R5      !      **** RESERVED ****         !         2,3
            608  *   R6      !      **** RESERVED ****         !         4,5
            609  *   R7      !      **** RESERVED ****         !         6,7
            610  *   R8      !  Y ORDINATE / VRAM ADDRESS      !
            611  *   R9      !  X ORDINATE / BIT MASK          !
            612  *   R10     !        CELL DOT ROW             !
            613  *   R11     !        BL RETURN ADDRESS        !
            614  *   R12     !   SOCB/SZCB/COC INSTRUCTION     !
            615  *   R13     !          RETURN WP              !
            616  *   R14     !          RETURN PC              !
            617  *   R15     !          RETURN ST              !
            618  *           -----------------------------------
            619  *
030C 0000   620  PIXTST DATA VDPWP0,$+2
0310 020C   621         LI   R12,>2009         R12='COC R9,R0'
0312 2009 
     0312'  622  TMASK  EQU  $-2
0314 1009   623         JMP  PIX1
            624  *
0316 030C'  625  PIXOFF DATA VDPWP0,$+2
031A 020C   626         LI   R12,>5009         R12='SZCB R9,R0'
031C 5009 
     031C'  627  RMASK  EQU  $-2
031E 1004   628         JMP  PIX1
            629  *
0320 0316'  630  PIXON  DATA VDPWP0,$+2
0324 020C   631         LI   R12,>F009         R12='SOCB R9,R0'
0326 F009 
            632  *
0328 D241   633  PIX1   MOVB R1,R9             GET X ORDINATE
032A 0989   634         SRL  R9,8              POSITION IT
ASM990 2.4.6     VDP                        Sun Jul 20 19:28:48 2025 Page 0022
VDP ROUTINES - CORTEX BASIC REV. 1.1

032C C201   635         MOV  R1,R8             GET CO-ORDINATES
            636  *  CALCULATE 32 x CELL ROW
032E 0A28   637         SLA  R8,2
0330 0248   638         ANDI R8,>03E0
0332 03E0 
            639  * CHECK TO SEE IF Y-ORDINATE IS LEGAL (X MUST BE!!)
0334 0288   640         CI   R8,192*4          VALID?
0336 0300 
0338 142C   641         JHE  NBUMP             N, EXIT
            642  *
033A C281   643         MOV  R1,R10            GET CO-ORDINATES
033C 024A   644         ANDI R10,>0007         CALCULATE CELL DOT ROW
033E 0007 
            645  *  CALCULATE CELL DOT COLUMN, KEEP AS SHIFT COUNT IN R0
0340 C009   646         MOV  R9,R0
0342 0240   647         ANDI R0,>0007
0344 0007 
            648  *
0346 0939   649         SRL  R9,3              CALCULATE CELL COLUMN
            650  *  CALCULATE CELL # ( =CELL COLUMN+[32xCELL ROW] )
0348 A209   651         A    R9,R8
034A 0A38   652         SLA  R8,3              FORM PGT INDEX
034C A20A   653         A    R10,R8            REFERENCE REQUIRED ROW
            654  *
            655  *  IF THE PGT IS NOT LOCATED AT 0 THEN THIS NEEDS TO BE
            656  *  ADDED TO R8 !!!
            657X        ASMIF PGTBA1
            658X        AI   R8,PGTBA1         ADD IN PGT BASE ADDRESS
            659         ASMEND
            660  *
034E 06A0   661         BL   @SENDAD           SEND ADDRESS TO VDP
0350 02D0'
0352 04C9   662         CLR  R9                READY MASK REGISTER
0354 0220   663         AI   R0,MASKTB         ADD IN MASK TABLE BASE
0356 03B0'
0358 D250   664         MOVB *R0,R9            FETCH MASK
035A D020   665         MOVB @VRAM,R0          GET CURRENT VRAM DATA
035C F120 
035E 0268   666         ORI  R8,>4000          SET WRITE BIT IN ADDRESS
0360 4000 
0362 06A0   667         BL   @SENDAD           SEND ADDRESS TO VDP
0364 0350'
0366 048C   668         X    R12               SET/RESET/TEST BIT
0368 02C9   669         STST R9                SAVE STATUS
036A 880C   670         C    R12,@TMASK        TEST ?
036C 0312'
036E 1612   671         JNE  WVRAM             N, UPDATE VRAM
            672  *
            673  *  TEST BIT EXIT ROUTINE
            674  *
0370 0248   675         ANDI R8,>BFFF          SET READ BIT IN ADDRESS
0372 BFFF 
0374 0228   676         AI   R8,CTBA1-PGTBA1   GET ADDRESS OF PCT ENTRY
0376 2000 
0378 06A0   677         BL   @SENDAD           SEND ADDRESS TO VDP
037A 0364'
037C 8F3C   678         C    *R12+,*R12+       DUMMY DELAY FOR VDP
037E D220   679         MOVB @FBCOL,R8         GET COLOUR TABLE ENTRY
0380 0164'
0382 2260   680         COC  @C2000,R9         Y, 'EQ' SET?

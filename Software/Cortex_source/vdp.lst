              2         IDT  'VDP'
              3  *
              4  *  NOTE :
              5  *      ACCESSES TO THE VDP NOT REQUIRING VRAM ACCESS
              6  *      MUST BE AT LEAST 3uS APART, ACCESSES REQUIRING
              7  *      VRAM ACCESS MUST BE AT LEAST 8uS APART.
              8  *
              9         DEF  UNPACK,LDCS,PIXON,PIXOFF,COLF
             10         DEF  PIXTST,TEXTY,GRAPHY,WAITY,LDCSY
             11         DEF  S$SM,MAGY,COLORY,SHAPEY,SPRITY
             12         DEF  EFIX$E,SPUTY,SGETY
             13         REF  XLOC,VDPWP0,VDPWP1,BITMAP,C2000
             14         REF  WAIT$,DELAY$,CNTDWN,CKEX,FPAC3
             15         REF  FPAC2,NLIN0,FBCOL
             16         REF  EVSFR$,SETTXT,SETGRA,SENDAD,LOADER
             17         REF  FGM$,VMODE,USERCS,PCHTB
             18         REF  FIX,EVARZ
             19  *
             20         DXOP EVFIX,11
     2F80    21  ERROR  EQU  >2F80
     2FA0    22  ERROR2 EQU  ERROR+>20
             23         COPY 'IODEFS.INC'

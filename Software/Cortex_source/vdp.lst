            261  *
            262  *              COLOUR STATEMENT
            263  *             ==================
            264  *
            265  *      FORMAT :-
            266  *           COLOUR ARG1<, ARG 2 >
            267  *
            268  *      THE FOREGROUND COLOUR IS SET TO ARG1,
            269  *      THE BACKGROUND COLOUR IS SET TO ARG2 IF IT IS
            270  *      PRESENT, IF NOT THE CURRENT BACKGROUND COLOUR
            271  *      IS USED. IF THE STATEMENT IS ISSUED WITHOUT
            272  *      PARAMETERS A DEFAULT OF 4,7 IS USED
            273  *
0146 06A0   274  COLORY BL   @CKEX             EXPRESSION?
0148 00F8'
014A 1017   275         JMP  SET47             N, DEFAULT TO 4,7
014C D060   276         MOVB @FBCOL,R1         GET CURRENT COLOURS
014E 00DC'
0150 06C1   277         SWPB R1                PUT IT IN LSB
0152 2EC2   278         EVFIX R2               GET FOREGROUND COLOUR
0154 0280   279         CI   R0,>3F00          ',' FOLLOWING ?
0156 3F00 
0158 1601   280         JNE  COLR1             N, USE DEFAULT BGND. COLOUR
015A 2EC1   281         EVFIX R1               Y, GET BACKGROUND
015C 0B41   282  COLR1  SRC  R1,4              MS NIBBLE =  BACKGROUND
015E D081   283         MOVB R1,R2             PUT IT IN R2
0160 0B42   284         SRC  R2,4              POSITION FOREGROUND
0162 D802   285  COLR2  MOVB R2,@FBCOL         R2 MSB = FCOL/BCOL
0164 014E'
0166 C060   286         MOV  @VMODE,R1         WHAT MODE AM I IN ?
0168 0076'
016A 16DD   287         JNE  FNLIN0            GRAPHIC, ALL DONE THEN
016C D802   288         MOVB R2,@SFBCLR        TEXT, PUT IN CALL BLOCK
016E 0174'
0170 06A0   289         BL   @LOADER           CALL VDP LOADER
0172 0000 
0174 00     290  SFBCLR BYTE >00,>80+R7        LOAD R7 WITH FCOL/BCOL
0176 0000   291         DATA 0
0178 10D6   292         JMP  FNLIN0            EXIT
            293  *
017A 0202   294  SET47  LI   R2,>4700          SET COLOUR 4,7
017C 4700 
017E 0588   295         INC  R8                ADJUST R8
0180 10F0   296         JMP  COLR2             & EXIT
ASM990 2.4.6     VDP                        Sun Jul 20 19:28:48 2025 Page 0012
VDP ROUTINES - CORTEX BASIC REV. 1.1

            298  *
            299  *              COL FUNCTION
            300  *             ==============
            301  *
            302  *      FORMAT :-
            303  *           A = COL [ ARG 1 , ARG 2 ]
            304  *
            305  *      COL RETURNS THE COLOUR OF THE SPECIFIED PIXEL.
            306  *      TESTING AN OFF SCREEN PIXEL RETURNS -1.
            307  *         ARG 1 FORMS THE HORIZONTAL ORDINATE
            308  *         ARG 2 FORMS THE VERTICAL ORDINATE
            309  *
            310  *     R1 CONTAINS ARG 2, *R2 CONTAINS ARG 1
            311  *     R3 IS SPARE
            312  *     EXIT IS OT EVSFR$
            313  *
0182 0000   314  COLF   DATA FGM$              FORCE TO GRAPHIC
0184 C0E0   315         MOV  @XLOC,R3          SAVE CURRENT X,Y
0186 0000 
0188 C281   316         MOV  R1,R10            COPY
018A 06A0   317         BL   @FIX              FIX
018C 0000 
018E 028A   318         CI   R10,192           'Y' VALID ?
0190 00C0 
0192 140E   319         JHE  BADXY             N, RETURN INVALID COLOUR
0194 0281   320         CI   R1,256            'X' VALID ?
0196 0100 
0198 140B   321         JHE  BADXY             N, RETURN INVALID COLOUR
019A 06C1   322         SWPB R1                PUT 'X' IN MSB
019C D281   323         MOVB R1,R10            R10 MSB = X , LSB = Y
019E C80A   324         MOV  R10,@XLOC         SET CURSOR LOCATION
01A0 0186'
01A2 0420   325         BLWP @PIXTST           GET PIXEL COLOUR IN FPAC3
01A4 030C'
01A6 0000   326         DATA FPAC3
01A8 C803   327         MOV  R3,@XLOC          RESTORE CURSOR
01AA 01A0'
01AC 0460   328  COLXIT B    @EVSFR$           EXIT
01AE 0000 
01B0 0720   329  BADXY  SETO @FPAC2            RETURN COLOUR = -1
01B2 0000 
01B4 10FB   330         JMP  COLXIT
            331  *
01B6 2F8F   332  ERR15  DATA ERROR+15          ILLEGAL SCREEN COMMAND
01B8 2F9E   333  ERR30  DATA ERROR+30          RANGE ERROR
01BA 2FA0   334  ERR35  DATA ERROR2,35         PARAMETER ERROR
01BE 2FA0   335  ERR37  DATA ERROR2,37         ILLEGAL DELIMETER
01C2 2FA0   336  ERR48  DATA ERROR2,48         WRONG MODE !
ASM990 2.4.6     VDP                        Sun Jul 20 19:28:48 2025 Page 0013
VDP ROUTINES - CORTEX BASIC REV. 1.1

            338  ************************************************************
            339  *                                                          *
            340  *               WAIT STATEMENT                             *
            341  *                                                          *
            342  *     FORMAT :-                                            *
            343  *        WAIT  <ARG1>                                      *
            344  *                                                          *
            345  *                                                          *
            346  *    IF ARG 1 IS PRESENT THEN IT IS USED AS A DELAY        *
            347  *           COUNT AND THE ROUTINE WAITS FOR ARG 1 *10 MS   *
            348  *           BEFORE RETURNING TO THE USER.                  *
            349  *    IF ARG 1 IS NOT PRESENT THEN THE ROUTINE WAITS FOR    *
            350  *           OUTPUT COMPLETION.                             *
            351  *                                                          *
            352  ************************************************************
01C6 06A0   353  WAITY  BL   @CKEX             EXPRESSION ?
01C8 0148'
01CA 1004   354         JMP  WAITO             N, WAIT OUTPUT COMPLETION
01CC 2EE0   355         EVFIX @CNTDWN          Y, SET DELAY COUNT
01CE 0000 
01D0 0000   356         DATA DELAY$            WAIT FOR IT
01D2 10A9   357         JMP  FNLIN0            THEN EXIT
            358  *
01D4 0000   359  WAITO  DATA WAIT$             WAIT OUTPUT COMPLETION
01D6 108B   360         JMP  TGEXIT            EXIT
ASM990 2.4.6     VDP                        Sun Jul 20 19:28:48 2025 Page 0014
VDP ROUTINES - CORTEX BASIC REV. 1.1

            362  *
            363  *              SHAPE  STATEMENT
            364  *             ==================
            365  *
            366  *      FORMAT :-
            367  *           SHAPE SHAPE No.,WORD1,WORD2,WORD3,WORD4
            368  *
            369  *      THE SPRITE PATTERN REFERENCED BY THE SHAPE #
            370  *      IS SET TO THE BIT PATTERN AS DEFINED BY THE
            371  *      ARGUMENTS WORD1 TO WORD4.
            372  *
01D8 0182'  373  SHAPEY DATA FGM$              FORCE GRAPHIC MODE
01DA 2EC1   374         EVFIX R1               N, GET SHAPE #
01DC D041   375         MOVB R1,R1             VALID?
01DE 16EB   376         JNE  ERR15             N, ERROR IT
01E0 0A31   377         SLA  R1,3              R1=8* SHAPE#
01E2 0221   378         AI   R1,SPGBA1+>4000   POINT TO ITS STORAGE IN VRAM
01E4 7800 
01E6 C088   379         MOV  R8,R2             SAVE PBC
01E8 C201   380         MOV  R1,R8             SET R8 FOR SENDAD
01EA 06A0   381         BL   @SENDAD           SEND ADDRESS TO VDP
01EC 00D6'
01EE C202   382         MOV  R2,R8             RESTORE PBC
01F0 0203   383         LI   R3,4              DO 4 WORDS
01F2 0004 
            384  *
01F4 0280   385  GETPAT CI   R0,>3F00          ',' ?
01F6 3F00 
01F8 16E2   386         JNE  ERR37             N, ERROR
01FA 2EC1   387         EVFIX R1               Y, GET NEXT WORD
01FC D801   388         MOVB R1,@VRAM          WRITE MSB
01FE F120 
0200 06C1   389         SWPB R1                POSITION LSB
0202 D801   390         MOVB R1,@VRAM          SEND IT
0204 F120 
0206 0603   391         DEC  R3                DONE?
0208 16F5   392         JNE  GETPAT            N, LOOP
020A 108D   393  FNLIN  JMP  FNLIN0            Y, EXIT TO NLIN0
ASM990 2.4.6     VDP                        Sun Jul 20 19:28:48 2025 Page 0015
VDP ROUTINES - CORTEX BASIC REV. 1.1

            395  *
            396  *              SPRITE STATEMENT
            397  *             ==================
            398  *
            399  *      FORMAT :-
            400  *           SPRITE PLANE,X,Y<,SHAPE#,COLOUR>
            401  *
            402  *      THE SPRITE ON THE SPECIFIED PLANE IS POSITIONED
            403  *      AT X,Y. IF NO OTHER ARGUMENTS FOLLOW IT IS ASSUMED
            404  *      THAT THE SPRITE CURRENTLY ON THAT PLANE IS TO BE
            405  *      MOVED. IF OTHER ARGUMENTS ARE PRESENT THESE SPECIFY
            406  *      THE NEW SHAPE # AND ITS COLOUR.
            407  *
020C 01D8'  408  SPRITY DATA FGM$              FORCE GRAPHIC MODE
020E 2ECF   409         EVFIX R15              Y, GET PLANE #
0210 C388   410         MOV  R8,R14            SAVE PBC
0212 028F   411         CI   R15,31            VALID ?
0214 001F 
0216 1BCF   412         JH   ERR15             N, ERROR IT
0218 0A2F   413         SLA  R15,2             R15=4* PLANE#
021A 022F   414         AI   R15,SNTBA1+2      REF ENTRY (LAST 2 BYTES ONLY)
021C 1B02 
021E C20F   415         MOV  R15,R8            SET R8 FOR SENDAD
0220 06A0   416         BL   @SENDAD           SEND ADDRESS TO VDP
0222 01EC'
0224 C618   417         MOV  *R8,*R8      <<< SLOW THE BLOODY THING DOWN >>>
0226 D0A0   418         MOVB @VRAM,R2          GET SPRITE #
0228 F120 
022A 06C2   419         SWPB R2
022C 0228   420         AI   R8,>4000-2        REF START OF ENTRY (WRITE)
022E 3FFE 
0230 D0A0   421         MOVB @VRAM,R2          GET COLOUR
0232 F120 
            422  * R2 = COLOUR,SPRITE#
0234 C618   423         MOV  *R8,*R8      <<< SLOW THE BLOODY THING DOWN >>>
0236 06A0   424         BL   @SENDAD           POINT VDP AT IT
0238 0222'
023A C20E   425         MOV  R14,R8            RESTORE PBC
023C 2EC1   426         EVFIX R1               GET X
023E 2EC3   427         EVFIX R3               GET Y
0240 06C3   428         SWPB R3                POSITION Y
0242 D043   429         MOVB R3,R1             FORM R1=X,Y
0244 0280   430         CI   R0,>3F00          ',' FOLLOWING ?
0246 3F00 
0248 1604   431         JNE  PUTSAT            N, UPDATE ENTRY
            432  *
024A 2EC2   433         EVFIX R2               Y, GET SPRITE #
024C 2EC3   434         EVFIX R3               GET COLOUR
024E 06C3   435         SWPB R3                N, POSITION IT
0250 D083   436         MOVB R3,R2             FORM R2=COLOUR,SPRITE#
0252 06C2   437  PUTSAT SWPB R2                POSITION COLOUR & SPRITE #
            438  *
            439  *            +-------------+
            440  *    R1   =  |      Y      |    MSB
            441  *            +-------------+
            442  *            |      X      |    LSB
            443  *            +-------------+
            444  *    R2   =  |  SPRITE #   |    MSB
            445  *            +-------------+
            446  *            |   COLOUR    |    LSB
ASM990 2.4.6     VDP                        Sun Jul 20 19:28:48 2025 Page 0016
VDP ROUTINES - CORTEX BASIC REV. 1.1

            447  *            +-------------+
            448  *
0254 02A3   449         STWP R3                GET WP
0256 05C3   450         INCT R3                POINT TO R1
0258 0204   451         LI   R4,4              DO 4 BYTES
025A 0004 
            452  *
025C D833   453  WRTIT  MOVB *R3+,@VRAM        WRITE IT BACK TO VRAM
025E F120 
0260 C618   454         MOV  *R8,*R8      <<< SLOW THE BLOODY THING DOWN >>>
0262 0604   455         DEC  R4                DONE ?
0264 16FB   456         JNE  WRTIT             N, LOOP
0266 10D1   457         JMP  FNLIN             Y, EXIT
ASM990 2.4.6     VDP                        Sun Jul 20 19:28:48 2025 Page 0017
VDP ROUTINES - CORTEX BASIC REV. 1.1

            459  *
            460  *              MAG STATEMENT
            461  *             ===============
            462  *
            463  *      FORMAT :-
            464  *           MAG   SPRITE MAG,SPRITE SIZE
            465  *
0268 020C'  466  MAGY   DATA FGM$              FORCE GRAPHIC MODE
026A 2EC2   467         EVFIX R2               GET SPRITE MAG
026C 2EC1   468         EVFIX R1               GET SPRITE SIZE
026E 0203   469         LI   R3,>00C0          DEFAULT TO SIZE=0,MAG=0
0270 00C0 
0272 C041   470         MOV  R1,R1             BIG SPRITES ?
0274 1301   471         JEQ  MAGY1             N, LEAVE R3
0276 05C3   472         INCT R3                Y, SET BIT
0278 C082   473  MAGY1  MOV  R2,R2             MAG THEM ?
027A 1301   474         JEQ  MAGY2             N, LEAVE R3
027C 0583   475         INC  R3                Y, SET BIT
027E 06C3   476  MAGY2  SWPB R3                POSITION BYTE
0280 D803   477         MOVB R3,@S$SM          SET UP LOADER TABLE
0282 0288'
0284 06A0   478         BL   @LOADER           RE-ENABLE DISPLAY
0286 0172'
0288 C0     479  S$SM   BYTE >C0,>80+R1        RELOAD VDP R1
028A 0000   480         DATA 0
028C 10BE   481         JMP  FNLIN             EXIT

            157  *
            158  *  CODE FOR BASIC COMMANDS "TEXT" AND "GRAPH"
            159  *
            160  *   WORKSPACE       :    WPR1
            161  *   ROUTINE(S)      :    LOADER,TEXTY,GRAPHY
            162  *   REGISTER USAGE  :
            163  *                                              GLOBAL DATA
            164  *           ___________________________________   LABELS
            165  *   R0      !                                 !
            166  *   R1      !                                 !
            167  *   R2      !                                 !
            168  *   R3      !                                 !
            169  *   R4      !                                 !
            170  *   R5      !                                 !
            171  *   R6      !                                 !
            172  *   R7      !                                 !
            173  *   R8      !         VRAM ADDRESS            !
            174  *   R9      !                                 !
            175  *   R10     !        PBC  STORE               !
            176  *   R11     !        BL RETURN ADDRESS        !
            177  *   R12     !    SAVED BL RETURN ADDRESS      !
            178  *   R13     !          RETURN WP              !
            179  *   R14     !          RETURN PC              !
            180  *   R15     !          RETURN ST              !
            181  *           -----------------------------------
            182  *
            183  *
            184  * THIS ROUTINE SETS THE VDP INTO TEXT MODE AND
            185  * LOADS THE CHARACTER SET. A CLEAR SCREEN IS THEN
            186  * PERFORMED AND THE X & Y COUNTERS RESET.
            187  *
            188  *
00EC 0000   189  TEXTY  DATA SETTXT            SET TEXT MODE
00EE 0460   190  TGEXIT B    @NLIN0            NEXT LINE
00F0 0000 
            191  *
            192  *      THIS ROUTINE SETS UP THE VDP FOR GRAPHICS II MODE,
            193  *      THE PNT AND PGT ARE INITIALIZED. THE X & Y COUNTERS
            194  *      ARE RESET.
            195  *
00F2 0000   196  GRAPHY DATA SETGRA            SET GRAPHIC 2 MODE
00F4 10FC   197         JMP  TGEXIT

             87  *
             88  *              SPUT STATEMENT
             89  *             ================
             90  *
             91  *      FORMAT :-
             92  *           SPUT  ARG1 , ARG 2
             93  *
             94  *      TEXT MODE :-
             95  *      THE CHARACTER AT THE LINEAR CURSOR ADDRESS
             96  *      SPECIFIED BY ARG1 IS SET TO THE ASCII CHARACTER
             97  *      GIVEN BY ARG2.
             98  *
             99  *      GRAPHIC MODE :-
            100  *      THE CHARACTER AT THE LINEAR CURSOR ADDRESS
            101  *      SPECIFIED BY ARG1 IS SET TO THE SHAPE SPECIFIED
            102  *      BY ARG2.
            103  *
006A 2EC1   104  SPUTY  EVFIX R1          GET ARG 1
006C 2EC2   105         EVFIX R2          GET ARG 2
006E D082   106         MOVB R2,R2        ARG 2 VALID ?  0..255
0070 163C   107         JNE  ERR15A       N, ERROR IT
0072 C3C8   108         MOV  R8,R15       SAVE PBC
0074 C020   109         MOV  @VMODE,R0    TEXT MODE ?
0076 0004'
0078 160C   110         JNE  GPUT         N, DO GRAPHICS 'SPUT'
            111  *
007A 0281   112         CI   R1,24*40     VALID CURSOR ADDRESS ?
007C 03C0 
007E 1435   113         JHE  ERR15A       N, ERROR
0080 C201   114         MOV  R1,R8        Y, SET UP R8
0082 0228   115         AI   R8,NTBA+>4000   ADD TABLE START
0084 4400 
0086 06A0   116         BL   @SENDAD      GIVE IT TO VDP
0088 005A'
008A 06C2   117         SWPB R2           POSITION CHARACTER
008C D802   118         MOVB R2,@VRAM     WRITE IT TO VRAM
008E F120 
0090 102A   119         JMP  PUTXIT       EXIT
            120  *
0092 0281   121  GPUT   CI   R1,24*32     VALID CURSOR ADDRESS ?
0094 0300 
0096 1429   122         JHE  ERR15A       N, ERROR
0098 C202   123         MOV  R2,R8        GET SHAPE #
009A 0A38   124         SLA  R8,3         FORM INDEX INTO SPRITE PAT. GEN TBL
009C 0228   125         AI   R8,SPGBA1    ADD IN TABLE START
009E 3800 
00A0 06A0   126         BL   @SENDAD      POINT VDP AT IT
00A2 0088'
00A4 0208   127         LI   R8,8         READ 8 BYTES
00A6 0008 
00A8 C0C8   128         MOV  R8,R3        SAVE FOR LATER
00AA 0200   129         LI   R0,BITMAP    INTO 'BITMAP'
00AC 0040'
00AE C100   130         MOV  R0,R4        SAVE FOR LATER
00B0 DC20   131  RSHAPE MOVB @VRAM,*R0+   READ SHAPE BYTE
00B2 F120 
00B4 C618   132         MOV  *R8,*R8      <<< SLOW THE BLOODY THINH DOWN >>>
00B6 0608   133         DEC  R8           DONE?
00B8 16FB   134         JNE  RSHAPE       N, LOOP
            135  *

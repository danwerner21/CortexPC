             25  *
             26  *              SGET STATEMENT
             27  *             ================
             28  *
             29  *      FORMAT :-
             30  *           SGET  ARG1 , ARG 2
             31  *
             32  *      TEXT MODE :-
             33  *      THE VARIABLE SPECIFIED BY ARG 2 IS GIVEN THE ASCII
             34  *      VALUE OF THE CHARACTER AT THE LINEAR CURSOR ADDRESS
             35  *      SPECIFIED BY ARG1.
             36  *
             37  *      GRAPHIC MODE :-
             38  *      THE SHAPE SPECIFIED BY ARG 2 IS SET TO THE PATTERN
             39  *      AT THE LINEAR CURSOR ADDRESS SPECIFIED BY ARG1.
             40  *
0000 2EC1    41  SGETY  EVFIX R1          GET ARG 1
0002 C020    42         MOV  @VMODE,R0    TEXT MODE?
0004 0000 
0006 1612    43         JNE  GGET         N, DO GRAPHIC 'SGET'
             44  *
0008 0281    45         CI   R1,40*24     VALID CURSOR ADDRESS ?
000A 03C0 
000C 146E    46         JHE  ERR15A       N, ERROR
000E 0420    47         BLWP @EVARZ       GET VARIABLE ADDRESS IN R2
0010 0000 
0012 C3C8    48         MOV  R8,R15       SAVE PBC
0014 C201    49         MOV  R1,R8        GET CURSOR ADDRESS IN R8
0016 0228    50         AI   R8,NTBA      ADD IN NAME TABLE START
0018 0400 
001A 06A0    51         BL   @SENDAD      POINT VDP AT IT
001C 0000 
001E 04F2    52         CLR  *R2+         CLEAR 1ST WORD OF VAR
0020 04F2    53         CLR  *R2+         CLEAR 2ND WORD OF VAR
0022 04D2    54         CLR  *R2          CLEAR 3RD WORD OF VAR
0024 D8A0    55         MOVB @VRAM,@-1(R2) READ CHARACTER CODE INTO VARIABLE
0026 F120 
0028 FFFF 
002A 105D    56         JMP  PUTXIT       EXIT
             57  *
002C 0281    58  GGET   CI   R1,32*24     VALID CURSOR ADDRESS ?
002E 0300 
0030 145C    59         JHE  ERR15A       N, ERROR
0032 2EC2    60         EVFIX R2          Y, GET ARG 2
0034 C3C8    61         MOV  R8,R15       SAVE PBC
0036 C201    62         MOV  R1,R8        SET UP R8
0038 0A38    63         SLA  R8,3         FORM TABLE INDEX
             64X        ASMIF PGTBA1
             65X        AI   R8,PGTBA1    ADD IN PGT BASE IF NEEDED
             66         ASMEND
003A 06A0    67         BL   @SENDAD
003C 001C'
003E 0203    68         LI   R3,BITMAP    REF BITMAP
0040 0000 
0042 C103    69         MOV  R3,R4        SAVE FOR LATER
0044 0700    70         SETO R0           DO 8 BYTES  (SLOWLY)
0046 DCE0    71  GREAD  MOVB @VRAM,*R3+   READ BYTE
0048 F120 
004A C618    72         MOV  *R8,*R8      <<< SLOW THE BLOODY THING DOWN >>>
004C 0A20    73         SLA  R0,2         DONE?

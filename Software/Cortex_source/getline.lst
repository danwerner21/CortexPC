0156 1382   202         JEQ  GTLLP             ;N, DO MAIN LOOP
0158 0126'  203         DATA TYP11$,>0800      ;Y, OUT A BS
015C 10FB   204         JMP  INS2              ;LOOP TILL CURSOR POSITIONED

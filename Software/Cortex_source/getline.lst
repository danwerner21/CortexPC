0146 FFFF 
0148 0607   195         DEC  R7                ;BACKUP
014A 8047   196         C    R7,R1             ;ARE WE BACK WHERE WE STARTED?
014C 1BFB   197         JH   INS1              ;N, CONTINUE MOVEING BUFFER
014E DDC0   198         MOVB R0,*R7+           ;Y, INSERT THE CHARACTER
0150 011E'  199         DATA TYPE$             ;OUTPUT THE UPDATED BUFFER

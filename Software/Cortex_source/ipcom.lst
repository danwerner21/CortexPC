              2         IDT  'IPCOM'
              3  *
              4  * ROUTINE LIST:
              5  *
              6  *       OUTL1           ;LIST LINE
              7  *       INPEND          ;END INPUT
              8  *       PRTEND          ;END PRINT
              9  *       UCCNT           ;UPDATE CCNT
             10  *
             11  * EXTERNAL ROUTINES:
             12  *
             13         REF  TYPBE$
             14         REF  TYPC$             ;OUTPUT CRLF
             15         REF  NLIN              ;EXIT TO MULTIPLEXOR
             16         REF  IOB               ;I/O BUFFER
             17  *
             18  * EXTERNAL DATA:
             19  *
             20         REF  CCNT              ;COLUMN COUNTER
             21         REF  FFLG              ;FORMATTING FLAG
ASM990 2.4.6     IPCOM                      Sun Jul 20 19:28:49 2025 Page 0002
I/O UTILITIES - CORTEX BASIC REV. 1.1

             23  * ABSTRACT:
             24  *
             25  *       OUTL1 - UPDATES CCNT AND PRINTS BUFFER.
             26  *
             27  *       PRTEND - UPDATES CCNT, PRINTS BUFFER, AND
             28  *               AND ENDS WITH A CRLF IF R15=0
             29  *               BEFORE EXITING TO NLIN.
             30  *
             31  *       INPEND - PRINTS A CRLF IF R15=0 AND
             32  *               EXITS TO NLIN.
             33  *
             34  *       UCCNT - UPDATES CCNT SUCH THAT IF REFLECTS
             35  *               WHAT HAS BEEN PRINTED PLUS WHAT
             36  *               IS IN THE BUFFER AND TERMINATES
             37  *               BUFFER WITH NULL.
             38  *
             39  * CALLING SEQUENCE:
             40  *
             41  *       BL @OUTL1
             42  *
             43  *       IN  R7 = BUFFER PTR
             44  *       OUT R7 = BUFFER ADR
             45  *
             46  *
             47  *       B @PRTEND
             48  *
             49  *       IN  R7 = BUFFER PTR
             50  *          R15 = CRLF FLAG
             51  *       EXITS TO NLIN
             52  *
             53  *
             54  *       B @INPEND
             55  *
             56  *       IN R15 = CRLF FLAG
             57  *       EXITS TO NLIN
             58  *
             59  *
             60  *       BL @UCCNT
             61  *
             62  *       IN R7 = BUFFER PTR
             63  *
             64  * EXCEPTIONS AND CONDITIONS:  (NONE)
             65  *
             66         DEF  OUTL1,PRTEND,INPEND,UCCNT

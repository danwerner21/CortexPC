00B8 1101   171         JLT  $+4               N
00BA 0586   172         INC  R6                Y, COUNT
00BC C000   173         MOV  R0,R0             '0'?
00BE 1602   174         JNE  CVDB1A
00C0 C104   175         MOV  R4,R4             Y - LEADING '0'?
00C2 13F6   176         JEQ  CVDB1
00C4 0584   177  CVDB1A INC  R4                Y - INCREMENT SIG DIGITS COUNT
00C6 0284   178         CI   R4,11             11 SIG DIGITS?

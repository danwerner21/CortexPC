              2         IDT  'CVDB'
              3  *
              4  *       CVDIZ   ;CONVERT DECIMAL TO BINARY INTEGER
              5  *       CVDIFZ  ;CONVERT DECIMAL TO FLOATING POINT
              6  *       CVDB20  ;GET NEXT DIGIT
              7  *
              8         REF  CVGCN1            ;GET FLOATING POINT CONSTANT
              9         REF  CVCH              ;CONVERSION HOLDING AREA
             10         REF  WPR2              ;SECONDARY WORKSPACE
             11         REF  CVC10             ;FLOATING POINT CONSTANTS
             12         REF  FPAC              FLOATING POINT ACCUMULATOR
             13         REF  B20               ;SPACE CHARACTER
             14         REF  C000A
             15  *
             16         DEF  CVDIZ,CVDIFZ      ENTRY POINTS
             17         DEF  CVDB20
             18  *
             19         DXOP LOADF,0           ;LOAD FPAC
             20         DXOP STORE,1           ;STORE FPAC
             21         DXOP FADD,2            ;ADD TO FPAC
             22         DXOP FSUB,3            ;SUBTRACT FROM FPAC
             23         DXOP FMUL,4            ;MULTIPLY FPAC
             24         DXOP FDIV,5            ;DIVIDE FPAC
             25         DXOP SCALE,6           ;SCALE FPAC
             26         DXOP NORMAL,7          ;NORMALIZE FPAC
             27         DXOP CLEAR,8           ;CLEAR FPAC
             28         DXOP NEGATE,9          ;NEGATE FPAC
             29         DXOP FLOATF,10         ;FLOAT FPAC
     2F80    30  ERROR  EQU  >2F80             ;XOP XX,14  (ERROR CALL)
     2FA0    31  ERROR2 EQU  ERROR+>20
ASM990 2.4.6     CVDB                       Sun Aug 10 23:07:35 2025 Page 0002
DECIMAL/BINARY CONVERSION - CORTEX BASIC REV. 1.1

             33  *       CVDIZ AND CVDIFZ CONVERT A STRING OF
             34  *       ASCII DECIMAL DIGITS TO A BINARY NUMBER.
             35  *       CVDIZ IS CALLED IF ONLY AN INTEGER WILL
             36  *       BE ACCEPTED.  CVDIFZ IS CALLED IF A
             37  *       FLOATING POINT NUMBER CAN BE ALLOWED.
             38  *       CVDI IS FIRST EXECUTED TO GET AN
             39  *       INTEGER.  IF IT FAILS, THEN A RETURN
             40  *       IS MADE OR CVDIFZ IS EXECUTED DEPENDING
             41  *       ON WHICH ROUTINE WAS INITIALLY CALLED.
             42  *
             43  *
             44  * CALLING SEQUENCE:
             45  *
             46  *       BLWP @CVDIZ
             47  *         OR
             48  *       BLWP @CVDIFZ
             49  *
             50  *      IN - R7 =PTR
             51  *
             52  *      OUT -    R0 = DELIMITER
             53  *               R1 = 16-BIT 2'S COMPLEMENT INTEGER
             54  *               FPAC = FLOATING POINT NUMBER
             55  *               R7 = NEW PTR
             56  *
             57  *      NORMAL EXIT - RTWP
             58  *      ERROR EXIT
ASM990 2.4.6     CVDB                       Sun Aug 10 23:07:35 2025 Page 0003

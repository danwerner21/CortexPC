MID HANDLER - CORTEX BASIC REV. 1.1

              2         IDT  'MID'
              3  ************************************************************
              4  * THIS MODULE HANDLES THE LEVEL 2 INTERRUPT
              5  * DECIDING WETHER IT IS AN ARITHMETIC OVERFLOW
              6  * OR A MID. FOR A MID THE OPCODE IS CHECKED
              7  * TO SEE IF IT IS A SYSTEM MID, IF SO THE
              8  * REQUIRED HANDLER IS EXECUTED.
              9  *
             10  *  MID0      ADDRESS FOR A MID OPCODE >0000 HANDLER
             11  *  OVINT     ADDRESS FOR AN ARITHMETIC OVERFLOW HANDLER
             12  *  ILLMID    ADDRESS FOR AN ILLEGAL MID HANDLER
             13  *
             14  * IF NO HANDLER IS AVAILIABLE FOR AN ARITHMETIC OVERFLOW
             15  * OR NON SYSTEM MID AN 'INTERRUPT WITHOUT TRAP' ERROR OCCURS
             16  *
             17  * HANDLERS ARE ENTERED WITH ALL INTERRUPTS DISABLED AND EXIT
             18  * IS VIA AN 'RTWP'
             19  *
             20  *  REGISTER USAGE ( ~ = RESERVED REGISTER )
             21  *    R0-3   NOT USED
             22  *    R4     GENERAL FLAG, CLEARED ON ENTRY
             23  *    R5-11  NOT USED
             24  *    R12    TEMP. REGISTER
             25  *  ~ R13-15 RETURN VECTORS
             26  *
             27         DEF  MIDPC,TYP0$,TYPC$,TYPB$,TYPE$,LOOK$
             28         DEF  TYP11$,TYPBE$,GETC$,GETCR$,TYPS$
             29         DEF  GCLEAR,TYPSN$,TYPEN$,DELAY$,WAIT$
             30         DEF  SETTXT,SETGRA,LOADER,SENDAD,STXT,SGRA
             31         DEF  CMON$,CMOF$,FLUSH$,FTM$,FGM$
             32  *
             33         REF  FBCOL,LDCS,XLOC,VMODE,CCSAVE
             34         REF  OVINT,ERROR2,MID0,ILLMID
             35         REF  S$SM,B00,B20,OUTDSR,C1
             36         REF  MCRLF,TY0,UNIT,OUTBUF,BUFEND
             37         REF  DSRCNT,LOADPT
             38         REF  RECPTR,INPTR,RBUF
             39         REF  CNTDWN,B1B,IOB,IOSTOR,DEVTBL
             40         REF  B62,XREGS,WHXETY,RHENTY,WHENTY
             41         REF  EREGS,ECHOEN,IREGS,WENTRY,RENTRY
             42         REF  MREGS,MENTRY,XOPENT
             43         COPY 'IODEFS.INC'

0130 1309   241         JEQ  ENDX1             NULL, EXIT
0132 150F   242         JGT  FILB1             +VE, CONTINUE COPY
0134 C104   243         MOV  R4,R4             -VE, LOOKING FOR -VE TERM. ?
0136 130D   244         JEQ  FILB1             N, CONTINUE COPY
0138 04CB   245         CLR  R11               Y, READY HOLDING REGISTER
013A 0608   246         DEC  R8                BACKUP TO -VE CHARACTER
013C D2D8   247         MOVB *R8,R11           GET BYTE BACK
013E 050B   248         NEG  R11               CORRECT IT
0140 D60B   249         MOVB R11,*R8           PUT IT BACK
0142 1001   250         JMP  ENDXFR            AND EXIT
0144 0648   251  ENDX1  DECT R8                BACKUP TO LAST CHARACTER
0146 81C8   252  ENDXFR C    R8,R7             WAS IT A SINGLE NULL?
0148 1401   253         JHE  ENDX2             N, OUT AS NORMAL
014A 0588   254         INC  R8                Y, BUMP END POINTER
014C 06A0   255  ENDX2  BL   @DSRGO            START DSR'S
014E 0182'
0150 0380   256         RTWP

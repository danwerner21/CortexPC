            181  *
            182  * THIS SECTION PROVIDES THE OUTPUT ROUTINES
            183  * FOR BASIC I/O.
            184  *
            185  * TYP11$  - OUT INLINE CHARACTER
            186  * TYP0$   - OUT R0
            187  * TYPC$   - OUT 'CRLF'
            188  * TYPBE$  - TERMINATE & OUTPUT I/O BUFFER
            189  * TYPB$   - OUT I/O BUFFER(0)
            190  * TYPE$   - OUT *R1 STRING(0)
            191  * TYPEN$  - OUT *R1 STRING(-)
            192  * TYPS$   - OUT <INLINE ADR> STRING(0)
            193  * TYPSN$  - OUT <INLINE ADR> STRING(-)
            194  * WAIT$   - WAIT FOR OUTPUT TO COMPLETE
            195  * DELAY$  - DELAY FOR CNTDWN * 40mS
            196  *
            197  *     REGISTER USAGE
            198  *   R0      UNUSED
            199  *   R1      UNUSED
            200  *   R2      SCRATCH
            201  *   R3      SCRATCH
            202  *   R4      TERMINATOR TYPE FLAG
            203  *   R5      UNIT FLAGS
            204  *   R6      SAVED RETURN ADDRESS
            205  *   R7      BUFFER START POINTER
            206  *   R8      BUFFER LOAD POINTER
            207  *   R9      SYSTEM POINTER
            208  *   R10     TEXT POINTER
            209  *   R11     RETURN ADDRESS
            210  *   R12     TEMP. REGISTER
            211  *   R13     )
            212  *   R14     ) RTWP VECTORS
            213  *   R15     )
            214  *
00F4 C33E   215  ETYP11 MOV  *R14+,R12         GET INLINE CHARACTER
00F6 1001   216         JMP  FORTY0            SKIP R0 FETCH
00F8 C31D   217  ETYP0  MOV  *R13,R12          GET R0
00FA 020A   218  FORTY0 LI   R10,TY0           GET CHARACTER BUFFER
00FC 0000 
00FE 024C   219         ANDI R12,>FF00         ZERO LSB
0100 FF00 
0102 C68C   220         MOV  R12,*R10          SAVE CHARACTER IN BUFFER
0104 100F   221         JMP  TYPE0             & OUTPUT
0106 020A   222  ETYPC  LI   R10,MCRLF         POINT TO 'CRLF'
0108 0000 
010A 100C   223         JMP  TYPE0             & OUTPUT

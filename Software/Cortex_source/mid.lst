            346  *
            347  *   THIS MODULE HANDLES THE CHARACTER INPUT FOR BASIC.
            348  * THE INPUT BUFFER IS FILLED BY THE 9902 DSR WHEN A
            349  * RECEIVE INTERRUPT IS ENCOUNTERED. THESE ROUTINES UNLOAD
            350  * THIS BUFFER AND RETURN THE CHARACTERS TO BASIC.
            351  *
            352  *
            353  *   WAIT FOR CHARACTER ROUTINE
            354  *
            355  * CALLING SEQUENCE :
            356  *      DATA GETCR$            CALL GET CHARACTER MID
            357  *
            358  * CHARACTER RETURNED IN R0 EXCEPT WHEN AN ESCAPE IS
            359  * ENCOUNTERED WHILE ESCAPE IS ENABLED. IN THIS CASE
            360  * PROGRAM EXECUTION IS RETURNED TO PRDY IN KEYBOARD MODE
            361  * OR STPY IN RUN MODE.
            362  * IF AN ESCAPE IS ENCOUNTERED AN HAS BEEN DISABLED VIA
            363  * A 'NOESC' STATEMENT THE ESCAPE CHARACTER IS RETURNED
            364  * IN THE MSB OF R0 AS WITH ANY OTHER CHARACTER.
            365  *
            366  *****************
            367  *
            368  *        TEST FOR CHARACTER INPUT
            369  *
            370  * CALLING SEQUENCE :
            371  *      DATA GETC$             CALL TEST INPUT MID
            372  *      <NO CHARACTER>         )
            373  *      < CHARACTER  >         )RETURN POINTS
            374  *      <   ESCAPE   >         )
            375  *
            376  *   THIS ROUTINE TESTS THE INPUT BUFFER FOR A CHARACTER AND
            377  * RETURNS TO ONE OF THE FOLLOWING THREE WORDS DEPENDING ON
            378  * THE RESULTS OF THE TEST.
            379  *
            380  * NO CHARACTER    EXECUTION RESUMES AT THE WORD FOLLOWING
            381  *                 THE CALL.
            382  * CHARACTER       EXECUTION RETURNS TWO WORDS AFTER THE
            383  *                 CALL WITH THE CHARACTER IN THE MSB OF R7.
            384  * ESCAPE          IF THE ESCAPE HAS BEEN DISABLED VIA THE
            385  *                 'NOESC' COMMAND THE RETURN IS AS FOR A
            386  *                 NORMAL CHARACTER. OTHERWISE EXECUTION
            387  *                 RESUMES THREE WORDS AFTER THE CALL.
            388  *
01EE 0300   389  GETC1  LIMI 15                ALLOW INTERRUPTS
01F0 000F 
01F2 0340   390         IDLE                   WAIT FOR ONE
            391  *
01F4 0704   392  EGETCR SETO R4                SET WAIT FLAG
            393  *
01F6 0300   394  EGETC  LIMI 0                 DISABLE INTERRUPTS
01F8 0000 
01FA C220   395         MOV  @RECPTR,R8        GET UNLOAD PTR
01FC 0000 
01FE 8808   396         C    R8,@INPTR         BUFFER EMPTY?
0200 0000 
0202 1A09   397         JL   GETC2             N, UNLOAD
            398  *
            399  *      FLUSH THE INPUT BUFFER ( R4 IS CLEARED )
            400  *
0204 0208   401  EFLUSH LI   R8,RBUF           Y, GET START OF BUFFER
ASM990 2.4.6     MID                        Sun Jul 20 19:28:47 2025 Page 0013
MID HANDLER - CORTEX BASIC REV. 1.1

0206 0000 
0208 C808   402         MOV  R8,@INPTR         RESET LOAD PTR
020A 0200'
020C C808   403         MOV  R8,@RECPTR        RESET UNLOAD PTR
020E 01FC'
0210 C104   404         MOV  R4,R4             WAIT ?
0212 16ED   405         JNE  GETC1             Y, LOOP
0214 0380   406         RTWP                   N, EXIT
            407  *
0216 04DD   408  GETC2  CLR  *R13              READY CALLERS R0
0218 D778   409         MOVB *R8+,*R13         COPY OVER BYTE
021A C808   410         MOV  R8,@RECPTR        UPDATE UNLOAD POINTER
021C 020E'
021E C104   411         MOV  R4,R4             WAS IT A WAIT CALL?
0220 1605   412         JNE  GETC5             Y, EXIT WITH CHARACTER
0222 981D   413         CB   *R13,@B1B         N, WAS IT AN ESCAPE CHARACTER?
0224 0000 
0226 1601   414         JNE  GETC4             N, EXIT 2(14) - NORMAL CHAR.
0228 05CE   415         INCT R14               4(14) - ESCAPE
022A 05CE   416  GETC4  INCT R14               2(14) - CHARACTER IN R0
022C 0380   417  GETC5  RTWP                   0(14) - NO CHARACTER
            418  *
            419  *      CASSETTE SUPPORT ROUTINES
            420  *
022E 020C   421  ECMON  LI   R12,2*CASS02      SET CRUBASE
0230 0180 
0232 1D10   422         SBO  16                TURN MOTOR ON
0234 1D12   423         SBO  18                ENABLE IT'S RECEIVE INTERRUPTS
0236 10E6   424         JMP  EFLUSH            FLUSH BUFFER & EXIT
            425  *
0238 020C   426  ECMOF  LI   R12,2*CASS02      SET CRUBASE
023A 0180 
023C 1E12   427         SBZ  18                KILL IT'S RECEIVE INTERRUPTS
023E 1E10   428         SBZ  16                TURN MOTOR OFF
0240 1D0E   429         SBO  14                SET TO LOAD CONTROL REG.
0242 3220   430         LDCR @B62,8            2 STOP,EV PAR,7 BITS,/3 CLOCK
0244 0000 
0246 10DE   431         JMP  EFLUSH            FLUSH BUFFER & EXIT
ASM990 2.4.6     MID                        Sun Jul 20 19:28:47 2025 Page 0014

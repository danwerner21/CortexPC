            433  ************************************************************
            434  *                                                          *
            435  *           TEST THE INPUT BUFFER ROUTINE                  *
            436  *                                                          *
            437  *      THIS ROUTINE TESTS TO SEE IF THERE IS ANYTHING      *
            438  *      IN THE INPUT BUFFER, IF NOT AN IMMEDIATE RETURN     *
            439  *      IS MADE. IF THERE IS A CHARACTER IN THE BUFFER      *
            440  *      THEN IT IS RETURNED IN THE CALLERS R0(MSB) WITH     *
            441  *      THE LSB CLEARED.                                    *
            442  *      NB.  THE CHARACTER IS NOT REMOVED FROM THE BUFFER.  *
            443  *                                                          *
            444  *      CALLING SEQUENCE :                                  *
            445  *           DATA LOOK$                                     *
            446  *           <EMPTY RETURN>                                 *
            447  *           <CHARACTER RETURN>                             *
            448  *                                                          *
            449  ************************************************************
0248 0300   450  E$LOOK LIMI 0                 MASK INTERRUPTS
024A 0000 
024C C220   451         MOV  @RECPTR,R8        FETCH RECEIVE POINTER
024E 021C'
0250 8808   452         C    R8,@INPTR         UPTO THE LOADING POINTER ?
0252 020A'
0254 14D7   453         JHE  EFLUSH            Y, NOTHING THERE - EXIT
0256 04DD   454         CLR  *R13              N, CLEAR CALLERS R0
0258 D758   455         MOVB *R8,*R13          COPY THE CHARACTER OVER
025A 10E7   456         JMP  GETC4             AND EXIT @2(R14)
ASM990 2.4.6     MID                        Sun Jul 20 19:28:47 2025 Page 0015
MID HANDLER - CORTEX BASIC REV. 1.1


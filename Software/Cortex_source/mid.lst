            290  *
            291  * THIS ROUTINE HANDS THE OUTPUT BUFFER TO A PRE-PROCESSOR
            292  * IF REQUIRED AND THEN STARTS THE OUTPUT TRANSFER
            293  * ON 9902'S SELECTED BY 'UNIT' AND ANY NON-STANDARD DEVICE
            294  * HANDLERS ARE BID VIA THE BLWP VECTOR IN THE DEVICE TABLE
            295  * R7 POINTS TO THE 1ST BYTE OF THE MESSAGE
            296  * R8 POINTS TO THE LAST BYTE OF THE MESSAGE
            297  *
0182 C18B   298  DSRGO  MOV  R11,R6            SAVE RETURN
0184 0300   299         LIMI 15                RE-ENABLE INTERRUPTS
0186 000F 
0188 C808   300         MOV  R8,@LOADPT        SAVE MSG END FOR DSR'S
018A 0000 
018C C160   301         MOV  @UNIT,R5          GET UNIT FLAGS
018E 0000 
0190 C2E0   302         MOV  @OUTDSR,R11       PRE-PROCESSOR ?
0192 0000 
0194 1301   303         JEQ  OUTIT             N, SKIP
0196 041B   304         BLWP *R11              Y, EXECUTE IT
0198 04E0   305  OUTIT  CLR  @DSRCNT           RESET DSR COUNT
019A 0162'
019C 020B   306         LI   R11,DEVTBL        POINT TO DEVICE TABLE
019E 0000 
01A0 0202   307         LI   R2,IOSTOR         REF I/O STOREAGE AREA
01A2 0000 
01A4 0203   308         LI   R3,16             DO 16 DEVICES
01A6 0010 
            309  *
01A8 C33B   310  DSRGO0 MOV  *R11+,R12         GET DEVICE ENTRY
01AA 130E   311         JEQ  DSRGO1            0, NO DEVICE INSTALLED
01AC 2320   312         COC  @C1,R12           IS IT A 9902?
01AE 0000 
01B0 1611   313         JNE  DSRGO2            N, CALL IT'S HANDLER
01B2 024C   314         ANDI R12,>7FFE         Y, ISOLATE CRUBASE
01B4 7FFE 
01B6 C487   315         MOV  R7,*R2            SET UNLOAD POINTER
01B8 0722   316         SETO @2(2)             RESET CR DELAY
01BA 0002 
01BC 2160   317         COC  @C1,R5            DEVICE SELECTED?
01BE 01AE'
01C0 1603   318         JNE  DSRGO1            N, SKIP IT
01C2 05A0   319         INC  @DSRCNT           Y, COUNT IT
01C4 019A'
01C6 1D13   320         SBO  19                ENABLE XMIT INTERRUPTS
01C8 0B15   321  DSRGO1 SRC  R5,1              SHIFT UNIT BIT
01CA 1303   322         JEQ  DGOXIT            0, NO MORE UNITS
01CC 8CB2   323         C    *R2+,*R2+         STEP TO NEXT STORAGE AREA
01CE 0603   324         DEC  R3                DONE ALL DEVICES?
01D0 16EB   325         JNE  DSRGO0            N, LOOP
01D2 0456   326  DGOXIT B    *R6               Y, RETURN
            327  *
01D4 2160   328  DSRGO2 COC  @C1,R5            IS THE DEVICE SELECTED?
01D6 01BE'
01D8 16F7   329         JNE  DSRGO1            N, NEXT ENTRY
            330  *
            331  *      DEVICE HANDLER INSTALLED, PASS OVER POINTERS
            332  *     HANDLER WP:
            333  *         R9   = OUTPUT BUFFER START
            334  *         R10  = OUTPUT BUFFER END 
            335  *         R11  = POINTER TO LOCAL STORAGE 
ASM990 2.4.6     MID                        Sun Jul 20 19:28:47 2025 Page 0011
MID HANDLER - CORTEX BASIC REV. 1.1

            336  *         R13-15 RETURN CONTEXT
            337  *
01DA C00C   338         MOV  R12,R0            SAVE HANDLER ADDRESS
01DC C31C   339         MOV  *R12,R12          GET ITS WP
01DE CB07   340         MOV  R7,@2*R9(12)      SET BUFFER START 
01E0 0012 
01E2 CB08   341         MOV  R8,@2*R10(12)     SET BUFFER END 
01E4 0014 
01E6 CB02   342         MOV  R2,@2*R11(12)     SET LOCAL STORAGE PTR
01E8 0016 
01EA 0410   343         BLWP *R0               CALL HANDLER
01EC 10ED   344         JMP  DSRGO1            NEXT ENTRY

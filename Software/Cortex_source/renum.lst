ASM990 2.4.6     RENUM                      Sun Aug 10 23:07:34 2025 Page 0001
RENUMBER COMMAND - CORTEX BASIC REV. 1.1

              2         IDT  'RENUM'
              3  *
              4  *
              5  *
              6         DEF  RENUMS,NINE
              7  *
              8         REF  MOVEB,MOVEL,TYPB$,CRLF,EDIT1,LSTL
              9         REF  MOVEBN,MOVELN
             10         REF  NVD,NVS,BUS,VNT,SLT,DCNT,IOB
             11         REF  ESCFLG,RENCMP,RENLNE,RENRET
             12         REF  RNGOTO,RNGSUB,RNRSTR,RNON,CKEX
             13         REF  RNINP,RNIF,RNELSE,RNERR,RNREM
             14  *
             15         REF  RENSTA,RENINC         START & INCREMENT HOLDERS
             16         REF  MODEOK
             17  *
             18         DXOP OUTINT,13
             19         DXOP EVFIX,11
             20  *
     2F80    21  ERROR  EQU  >2F80
             22  *
             23  * RENUMBER COMMAND
             24  *   FORM :                       NEW LINES :-
             25  *
             26  *     RENUM                     FROM 10 IN STEPS OF 10
             27  *     RENUM <ARG1>              FROM ARG1 IN STEPS OF 10
             28  *     RENUM STEP <ARG1>         FROM 10 IN ARG1 STEPS
             29  *     RENUM <ARG1> STEP <ARG2>  FROM ARG1 IN ARG2 STEPS
             30  *
             31  *
             32  * REPLACES ALL REFERENCES TO STATEMENTS IN
             33  *           GOTO
             34  *           GOSUB
             35  *           RESTOR
             36  *           ON
             37  *           INPUT
             38  *           ERROR
             39  * WITH THE NEW STATEMENT NUMBER
             40  *
             41  * METHOD:
             42  *  1. GO THROUGH PROGRAM AND BUILD UP A TABLE OF ALL
             43  *     STATEMENTS CONTAINING REFERENCES TO OTHER STATEMENTS.
             44  *     TABLE CONTAINS STATEMENT NUMBER REFERENCED AND ADDRESS
             45  *     IN PSEUDO CODE OF THIS REFERENCE.
             46  *  2. GO THROUGH PROGRAM AGAIN AND CHANGE OLD STATEMENT
             47  *     NUMBERS TO NEW. CHECK EACH OLD STATEMENT NUMBER
             48  *     AGAINST ALL NUMBERS IN THE TABLE BUILT UP IN STEP 1.
             49  *     IF A MATCH IS FOUND, CHANGE THE STATEMENT REFERENCE
             50  *     AT THE ADDRESS GIVEN IN THE TABLE FROM OLD TO NEW
             51  *     STATEMENT NUMBER. THERE MAY BE MORE THAN ONE
             52  *     ENTRY IN THE TABLE FOR EACH OLD STATEMENT NUMBER.
             53  *
             54  * DESIGN CONSIDERATIONS:
             55  *    THIS PROGRAM IS NOT OPTIMISED FOR SPEED, AS IT IS NOT
             56  *    AN EXECUTION TIME ROUTINE. IT IS DESIGNED TO USE THE
             57  *    MINIMUM DATA STORAGE CONSISTENT WITH GOOD PROGRAM
             58  *    STRUCTURE.
             59  *    DATA AREA FOR THE TABLE IS TAKEN FROM THE TOP OF THE
             60  *    VARIABLE DEFINITION TABLE (@NVD+2) TO (MAXIMALLY)
             61  *    THE BOTTOM OF THE VARIABLE STORAGE AREA (@NVS-2).
ASM990 2.4.6     RENUM                      Sun Aug 10 23:07:34 2025 Page 0002
RENUMBER COMMAND - CORTEX BASIC REV. 1.1

             62  *
             63  * ERRORS:
             64  *    IF THE PROGRAM RUNS OUT OF MEMORY WHILE TRYING TO
             65  *    BUILD THE TABLE (STEP 1), THE POWER BASIC SYSTEM
             66  *    RETURNS AN ERROR 10 - STORAGE OVERFLOW
             67  *
             68  * NOTE:
             69  *    BEFORE RUNNING THE RENUM ROUTINE IT IS FIRST NECESSARY
             70  *    TO MODIFY THE WAY VALUES 1 TO 9 ARE STORED INTERNALLY
             71  *    (>64 - >6C) - THEY NEED TO BE STORED AS >6D >0001 TO
             72  *    >6D >0009.  WHEN RENUMBERING IS COMPLETE THE REVERSE
             73  *    OPERATION MUST BE PERFORMED.
             74  *    IT IS NOT NECESSARY TO DO THIS FOR VALUES -1 AND 0
             75  *    (>62 AND >63) AS THEY ARE NOT VALID LINE NUMBERS.
             76  *    THIS REQUIRES EACH LINE IN THE PROGRAM TO BE 'LISTED
             77  *    TO THE IOB' AND THE EDITOR INVOKED ON THE IOB (WITH
             78  *    THE APPROPRIATE COMPRESSION/UNCOMPRESSION FLAG SET).
             79  *
             80  * CALLING SEQUENCE:
             81  *
             82  *      B    @RENUM
             83  *
             84  * DATA:
             85  *
             86  *      R0-R2     GENERAL
             87  *      R3        CURRENT OPCODE
             88  *      R4        TABLE POINTER
             89  *      R5        SLT POINTER
             90  *      R6        END OF AVAILABLE STORAGE
             91  *      R7        NEW STATEMENT NUMBER
             92  *      R8        PSEUDO CODE BYTE POINTER (PBC)
             93  *
             94  * STORE REF'D OPCODES (DEF'D IN EDIT)
             95  *
     0001'   96  GOTO   EQU  $+1
0000 0000    97         DATA RNGOTO
     0003'   98  GOSUB  EQU  $+1
0002 0000    99         DATA RNGSUB
     0005'  100  RSTR   EQU  $+1
0004 0000   101         DATA RNRSTR
     0007'  102  ON     EQU  $+1
0006 0000   103         DATA RNON
     0009'  104  INP    EQU  $+1
0008 0000   105         DATA RNINP
     000B'  106  ERR    EQU  $+1
000A 0000   107         DATA RNERR
     000D'  108  REM    EQU  $+1
000C 0000   109         DATA RNREM
     000F'  110  IF     EQU  $+1
000E 0000   111         DATA RNIF
     0011'  112  ELSE   EQU  $+1
0010 0000   113         DATA RNELSE
            114  *
0012 45     115  QUOTE  BYTE >45
0013 44     116  DQUOTE BYTE >44
0014 47     117  EXCLAM BYTE >47
0015 6D     118  INT2B  BYTE >6D
0016 6E     119  HINT2B BYTE >6E
0017 6F     120  FP6B   BYTE >6F
0018 3C     121  CONCAT BYTE >3C
ASM990 2.4.6     RENUM                      Sun Aug 10 23:07:34 2025 Page 0003
RENUMBER COMMAND - CORTEX BASIC REV. 1.1

0019 3E     122  HASH   BYTE >3E
001A 3F     123  COMMA  BYTE >3F
001B 41     124  QUEST  BYTE >41
001C 40     125  SEMCOL BYTE >40
001D 38     126  TO     BYTE >38
001E 3A     127  STEP   BYTE >3A
001F 3B     128  THEN   BYTE >3B
0020        129         EVEN
ASM990 2.4.6     RENUM                      Sun Aug 10 23:07:34 2025 Page 0004
RENUMBER COMMAND - CORTEX BASIC REV. 1.1

            131  *
            132  * BEFORE EXECUTING THE RENUMBERING ROUTINE, UNCOMPRESS
            133  * THE STORED PROGRAM FOR VALUES 1 TO 9.
            134  *
     0020'  135  RENUMS EQU  $
0020 06A0   136         BL   @MODEOK           ABORT IF RUNNING !
0022 0000 
0024 0201   137         LI   R1,10             DEFAULT INCREMENT = 10
0026 000A 
0028 C081   138         MOV  R1,R2             DEFAULT NEW START = 10
002A 9838   139         CB   *R8+,@STEP        ; 'STEP' ?
002C 001E'
002E 1308   140         JEQ  REN$1             ;Y, GET STEP
0030 0608   141         DEC  R8                ;N, BACKUP
0032 06A0   142         BL   @CKEX             ;EXPRESSION ?
0034 0000 
0036 1005   143         JMP  REN$2             ;N, TAKE DEFAULTS
0038 2EC2   144         EVFIX R2               ;Y, GET START LINE #
003A 9800   145         CB   R0,@STEP          ;'STEP' ?
003C 001E'
     003C'  146  B3A    EQU  $-2
003E 1601   147         JNE  REN$2             ;N, TAKE DEFAULT STEP
0040 2EC1   148  REN$1  EVFIX R1               ;Y, GET INCREMENT
0042 C801   149  REN$2  MOV  R1,@RENINC        ;SAVE STEP SIZE
0044 0000 
0046 6081   150         S    R1,R2             ;BACKUP START
0048 C802   151         MOV  R2,@RENSTA        ;SAVE START LINE
004A 0000 
            152  *
004C 0720   153         SETO @ESCFLG           NO ESCAPE DURING RENUMBER
004E 0000 
0050 06A0   154         BL   @UNCOMP           UNCOMPRESS PROGRAM
0052 02A0'
0054 0000   155         DATA 0
0056 C120   156         MOV  @NVD,R4           INITIALISE TABLE POINTER
0058 0000 
005A C1A0   157         MOV  @NVS,R6           SET R6 TO END OF AVAILABLE MEMORY
005C 0000 
005E 0226   158         AI   R6,-6             - 4 (FOR OVERFLOW TEST)
0060 FFFA 
0062 C0A0   159         MOV  @RENSTA,R2        INITIALISE STATEMENT #
0064 004A'
0066 C160   160         MOV  @VNT,R5           INITIALISE SLT PTR
0068 0000 
            161  *
            162  * END OF LINE ENCOUNTERED - GET PBC OF NEXT LINE
            163  *
006A 0645   164  ENDLIN DECT R5
006C 0645   165         DECT R5                TO NEXT LINE
006E 8160   166         C    @SLT,R5           END OF PROGRAM?
0070 0000 
0072 1A4E   167         JL   SETUP
            168  *
            169  * END OF PROGRAM - UPDATE ALL PBC ENTRIES IN THE TABLE THAT
            170  * CORRESPOND TO ACTUAL PROGRAM LINE #S; RENUMBER THE SLT
            171  * ENTRIES; CHECK FOR NON-EXISTENT LINE #S; CLEAR DOWN THE
            172  * TABLE AREA AND RETURN TO THE INTERPRETER
            173  *
0074 04D4   174         CLR  *R4               Y - PUT ZERO TO MARK END OF TABLE
0076 C1E0   175         MOV  @RENSTA,R7        INITIALISE NEW STATEMENT #
ASM990 2.4.6     RENUM                      Sun Aug 10 23:07:34 2025 Page 0005
RENUMBER COMMAND - CORTEX BASIC REV. 1.1

0078 0064'
007A C160   176         MOV  @VNT,R5           INITIALISE SLT POINTER
007C 0068'
007E 0645   177         DECT R5                POINT TO "FIRST LINE #"
     0080'  178  RENST  EQU  $                 RENUMBER STATEMENT
0080 A1E0   179         A    @RENINC,R7        INCREMENT STATEMENT #
0082 0044'
0084 0225   180         AI   R5,-4             POINT TO NEXT SLT ENTRY
0086 FFFC 
0088 8805   181         C    R5,@SLT           END OF PROGRAM?
008A 0070'
008C 1A11   182         JL   ENDRNS
008E C120   183         MOV  @NVD,R4           N - INITIALISE TABLE POINTER
0090 0058'
     0092'  184  SCHTAB EQU  $                 SEARCH TABLE FOR STMT # MATCH
0092 C514   185         MOV  *R4,*R4           END OF TABLE?
0094 130B   186         JEQ  ENDSTB
0096 8D15   187         C    *R5,*R4+          N - MATCH?
0098 1607   188         JNE  SCHINC
009A 0644   189         DECT R4                Y - BACK UP TO STATEMENT #
009C 0534   190         NEG  *R4+              MARK AS DONE
009E C014   191         MOV  *R4,R0            PUT NEW STMT NO IN STMT REF
00A0 DC07   192         MOVB R7,*R0+           (MAY CROSS WORD BOUNDARY)
00A2 06C7   193         SWPB R7
00A4 D407   194         MOVB R7,*R0
00A6 06C7   195         SWPB R7
00A8 05C4   196  SCHINC INCT R4                POINT TO NEXT TABLE ENTRY
00AA 10F3   197         JMP  SCHTAB            LOOP
            198  *
            199  * ALL TABLE ENTRIES CORRESPONDING TO THAT LINE # DONE.
            200  * NOW UPDATE THE SLT ENTRY
            201  *
     00AC'  202  ENDSTB EQU  $
00AC C547   203         MOV  R7,*R5            PUT NEW STMT NO IN SLT
00AE 10E8   204         JMP  RENST             LOOP
            205  *
            206  * ALL SLT ENTRIES DONE. NOW CHECK FOR NON-EXISTENT LINE #S
            207  * CLEAR DOWN TABLE AREA IN THE PROCESS
            208  *
     00B0'  209  ENDRNS EQU  $
00B0 C120   210         MOV  @NVD,R4           REF TABLE
00B2 0090'
00B4 C014   211  CHECK  MOV  *R4,R0            GET STATEMENT # ENTRY
00B6 1124   212         JLT  CHECKA            STATEMENT # = -VE
00B8 1326   213         JEQ  CHCKND            STATEMENT # = 0 (FINISHED)
00BA C064   214         MOV  @2(R4),R1         GET PBC ENTRY
00BC 0002 
00BE C160   215         MOV  @SLT,R5           GET END OF SLT
00C0 008A'
00C2 C0B5   216  CHECKB MOV  *R5+,R2           GET STATEMENT #
00C4 C235   217         MOV  *R5+,R8           GET DISPLACEMENT INTO BUS
00C6 A220   218         A    @BUS,R8           REF START OF STMT IN BUS
00C8 0000 
00CA 8201   219         C    R1,R8             PBC ENTRY IN THIS LINE?
00CC 1AFA   220         JL   CHECKB            N - TRY NEXT LINE
00CE 06A0   221         BL   @MOVEBN           Y - OUTPUT MSG TO IOB
00D0 0000 
00D2 0D0A   222         DATA >0D0A             CR LF
00D4 42     223         TEXT -'Bad line No.('

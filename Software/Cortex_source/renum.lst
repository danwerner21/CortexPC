            443  *
            444  * THIS ROUTINE PERFORMS THE NECESSARY COMPRESSION/
            445  * UNCOMPRESSION OF THE STORED PROGRAM
            446  *
            447  *      BL   @UNCOMP
            448  *      DATA [FLAG]
            449  *
            450  *  FLAG = 0 THEN UNCOMPRESS
            451  *       = 9 THEN COMPRESS
            452  *       ANYTHING ELSE WILL CAUSE PROBLEMS!    (BIG ONES !!!)
            453  *
            454  *  RENLNE - LAST STATEMENT LINE NUMBER THAT WAS LISTED
            455  *  RENCMP - COMPRESSION/UNCOMPRESSION FLAG (USED IN EDIT)
            456  *
02A0 C83B   457  UNCOMP MOV  *R11+,@RENCMP     GET COMPRESSION FLAG
02A2 0000 
02A4 C80B   458         MOV  R11,@RENRET       SAVE RETURN ADDRESS
02A6 0000 
02A8 04E0   459         CLR  @RENLNE           START AT THE FIRST LINE #
02AA 0000 
02AC 0720   460         SETO @DCNT             CLEAR INDENTATION COUNTER
02AE 0000 
02B0 C220   461  UNCMP1 MOV  @VNT,R8
02B2 007C'
02B4 0648   462         DECT R8                BACK UP TO SLT TERMINATOR
02B6 8808   463  UNCMP2 C    R8,@SLT           REACHED END OF SLT?
02B8 00C0'
02BA 120F   464         JLE  UNCMP3            Y - RETURN TO CALLER
02BC 0228   465         AI   R8,-4             N - GET NEXT LINE #
02BE FFFC 
02C0 8620   466         C    @RENLNE,*R8       RENLNE => LINE #?
02C2 02AA'
02C4 14F8   467         JHE  UNCMP2            Y - GOTO NEXT LINE
02C6 C818   468         MOV  *R8,@RENLNE       N - SAVE CURRENT LINE #
02C8 02C2'
            469  *
            470  * FOUND NEXT LINE TO BE COMPRESSED/UNCOMPRESSED
            471  *
02CA C1E0   472         MOV  @IOB,R7            REF IOB
02CC 0000 
02CE C078   473         MOV  *R8+,R1           GET LINE #; R8 REFS PBC ENTRY
02D0 06A0   474         BL   @LSTL             LIST THIS LINE TO IOB
02D2 0000 
02D4 06A0   475         BL   @EDIT1            EDIT LINE IN IOB
02D6 0000 
            476  *
            477  * SLT/VNT/ ETC MAY HAVE CHANGED - FIND THE NEXT LINE TO
            478  * BE OPERATED ON (WHEN STATEMENT # ENTRY IN SLT > RENLNE)
            479  *
02D8 10EB   480         JMP  UNCMP1
02DA C2E0   481  UNCMP3 MOV  @RENRET,R11       RESTORE RETURN ADDRESS
02DC 02A6'
02DE 045B   482         B    *R11              RETURN TO CALLING ROUTINE
            483         END

            421  *
            422  * STORE STATEMENT NUMBER AND PBC ADDRESS IN TABLE
            423  *
0282 8106   424  STORE  C    R6,R4             STORAGE OVERFLOW?
0284 1A06   425         JL   STOVFL
0286 DD38   426         MOVB *R8+,*R4+         N - STORE STMT NO
0288 DD18   427         MOVB *R8,*R4+          (CAN BE ODD BOUNDARY)
028A 0608   428         DEC  R8
028C CD08   429         MOV  R8,*R4+           STORE CURRENT PBC
028E 05C8   430         INCT R8                POINT TO NEXT BYTE IN P-CODE
0290 045B   431         B    *R11              RETURN
            432  *
            433  * OVERFLOW - CLEAR TABLE AREA THEN OUTPUT OVERFLOW MESSAGE.
            434  * (RETURNS TO INTERPRETER)
            435  *
0292 C120   436  STOVFL MOV  @NVD,R4           INITIALISE TABLE POINTER
0294 00B2'
0296 05C6   437         INCT R6                SET R6 TO LAST WORD TO BE CLEARED
0298 04F4   438  CLRLP  CLR  *R4+

0012 1031    81          JMP  GOS2A
             82  *
             83  * INTERRUPT ENTRY POINT (RUN)
             84  *
0014 C160    85  GOS1    MOV  @PLC,R5          GET ADDRESS OF CURRENT LINE
0016 0010'
0018 1024    86          JMP  GOS1A
             87  *
             88  * GOTO ENTRY - CHECK SYNTAX (VALID TERMINATOR?)
             89  *
001A 04C3    90  GOTY    CLR  R3         INDICATE A GOTO             JG 12/1/82
001C 1001    91          JMP  GOSYA
             92  *
             93  * GOSUB ENTRY - CHECK SYNTAX (VALID TERMINATOR?)
             94  *
001E 0703    95  GOSY    SETO R3         INDICATE A GOSUB            JG 12/1/82
0020 C188    96  GOSYA   MOV R8,R6             ;SET TO SAVE PBC
0022 05C6    97          INCT R6
0024 04C0    98          CLR R0
0026 D036    99          MOVB *R6+,R0          ;GET DELIMITER
0028 1306   100            JEQ GOSY1           ;EOL
002A 0280   101          CI R0,>3C00           ;::?
002C 3C00 
002E 1313   102            JEQ GOSON1    ;Y                          JG 02/3/82
0030 0280   103          CI R0,>4700           ;!?
0032 4700 
0034 1628   104          JNE  GOSYE            ;N - ERROR

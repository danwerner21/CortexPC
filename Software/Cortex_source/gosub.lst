             62  *
             63  * ENTRY POINT:
             64  *
             65          DEF GOSY        ;GOSUB COMMAND
             66          DEF GOS1,GOS2
             67          DEF GOSB1       ;SYSTEM ENTRY
             68          DEF GOSON       ;ON COMMAND ENTRY
             69          DEF GOTY        ;GOTO ENTRY
             70  *
             71  * ENTRY FOR INPUT ERROR HANDLER/ERRECOVY
             72  *
0000 C160    73  GOSB1   MOV  @PLC,R5          GET ADDRESS OF CURRENT LINE

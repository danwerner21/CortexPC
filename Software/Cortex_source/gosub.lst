            145  *
            146  * ABSTRACT:
            147  *
            148  * POPS THE RETURN ADDRESS FROM THE GOSUB STACK (GSS) AND
            149  * EFFECTS A TRANSFER TO THAT POPPED ADDRESS. IF THE
            150  * UNSTACKED PLC = 0 THEN IT INDICATES THAT THE GOSUB WAS
            151  * ENTERED DIRECTLY FROM KEYBOARD MODE.  IF THE PBC <> 0
            152  * THEN AN EXIT IS MADE TO THE LINE DEMULTIPLEXER; OTHERWISE
            153  * A NEW STATMENT LINE IS INTERPRETED.
            154  *
            155  * CALLING SEQUENCE:
            156  *
            157  *       B @RTNY
            158  *
            159  *       EXIT TO MULTIPLEXOR
            160  *
            161  * EXCEPTIONS AND CONDITIONS:
            162  *
            163  *       STACK UNDERFLOW
            164  *
            165  * ENTRY POINT:
            166  *
            167          DEF RTNY
            168  *
008A C0E0   169  RTNY    MOV  @GSC,R3  ;SEE IF STACK EMPTY
008C 0074'
008E 8803   170          C    R3,@GSS  ;EMPTY?
0090 0000 
0092 12F8   171          JLE  ERR12        Y
0094 0643   172          DECT R3           N, POP PLC
0096 C153   173          MOV  *R3,R5     
0098 0643   174          DECT R3           POP PBC
009A C803   175          MOV  R3,@GSC      UPDATE GSC
009C 008C'
009E C805   176          MOV  R5,@PLC      UPDATE THE PLC
00A0 0070'
00A2 1309   177          JEQ  RTRN3        0 - KEYBOARD MODE WHEN STACKED 
00A4 C825   178          MOV  @-2(R5),@SLN UPDATE SLN
00A6 FFFE 
00A8 0000 
00AA C213   179          MOV  *R3,R8       ;GET PBC
00AC 1302   180          JEQ  RTRN2        ;0, GOTO NEXT LINE (ON)
00AE 0460   181          B    @LINE2
00B0 0000 
            182  *
00B2 0460   183  RTRN2   B    @LINE5
00B4 0000 
            184  *
00B6 0460   185  RTRN3   B    @CRLF       RETURN TO INTERPRETER LOOP 
00B8 0000 

COMMAND SEARCH AND ERROR HANDLER

            276  ************************************************************
            277  *                                                          *
            278  * TRANSFER (XFER) COMMAND -- 'X'                           *
            279  *                                                          *
            280  *  CALLING SEQUENCE:          BL   X                       *
            281  *                       R0=START BYTE ADDRESS              *
            282  *                       R1=STOP BYTE ADDRESS               *
            283  *                       R2=DESTINATION START ADDR          *
            284  *                                                          *
            285  *  RETURN                     RT                           *
            286  *                                                          *
            287  * IF THE DESTINATION ADDRESS IS BETWEEN THE START AND STOP *
            288  *  ADDRESS, THE TRANSFER IS BOTTOM UP TO AVOID COPYING     *
            289  *  OVER THE ORIGINAL BEFORE IT IS TRANSFERED.              *
            290  *                                                          *
            291  ************************************************************
            292  *
011A 8040   293  X      C    R0,R1             START < STOP
011C 1BE2   294  XERR   JH   ERR3               N, EXIT
011E 8002   295         C    R2,R0             DEST. LESS THAN START?
0120 120B   296         JLE  TOPDN              Y, TOP DOWN
0122 8042   297         C    R2,R1             DEST. GREATER THEN STOP?
0124 1B09   298         JH   TOPDN              Y, TOP DOWN
0126 C0C1   299         MOV  R1,R3              N, BOTTOM UP
0128 60C0   300         S    R0,R3
012A A083   301         A    R3,R2             DEST BOT= DEST+(START-STOP)
012C D491   302  BOTUP  MOVB *R1,*R2
012E 0601   303         DEC  R1                BUMP POINTERS
0130 0602   304         DEC  R2
0132 8001   305         C    R1,R0             PAST START?
0134 14FB   306         JHE  BOTUP              N, CONTINUE
0136 045B   307         RT                      Y, EXIT TO MONITOR
0138 DCB0   308  TOPDN  MOVB *R0+,*R2+
013A 8040   309         C    R0,R1             PAST STOP?
013C 12FD   310         JLE  TOPDN              N, CONTINUE
013E 045B   311         RT                      Y, EXIT TO MONITOR
            312  *
ASM990 2.4.6     MONITOR                    Sun Jul 20 19:28:48 2025 Page 0010
*** INITIALIZE COMMAND ***

            315  ************************************************************
            316  * INITILIZE MEMORY COMMAND -- 'I'                          *
            317  *                                                          *
            318  * FILL MEMORY WITH THE KEY FROM 'START' TO 'STOP' BY WORDS *
            319  *                                                          *
            320  * CALLING SEQUENCE:           BL    I                      *
            321  *                        R0=START                          *
            322  *                        R1=STOP                           *
            323  *                        R2=KEY                            *
            324  *                                                          *
            325  * RETURN                      B     *R11                   *
            326  *                                                          *
            327  ************************************************************
            328  *
0140 8040   329  I      C    R0,R1             TEST FOR VALID START/STOP
0142 1BEC   330         JH   XERR
0144 CC02   331  I11    MOV  R2,*R0+           DATA TO MEMORY
0146 8040   332         C    R0,R1             DONE?
0148 16FD   333         JNE  I11               NO, LOOP
014A CC02   334         MOV  R2,*R0+
014C 045B   335         RT                     EXIT
            336  *
ASM990 2.4.6     MONITOR                    Sun Jul 20 19:28:48 2025 Page 0011
*** FIND COMMAND ***

            339  ************************************************************
            340  *                                                          *
            341  * FIND COMMAND -- 'F'                                      *
            342  *                                                          *
            343  * LOOK FROM START ADDRESS TO STOP ADDRESS FOR              *
            344  * THE SPECIFIED DATA PATTERN.                              *
            345  *      R0-START ADDRESS                                    *
            346  *      R1-STOP ADDRESS                                     *
            347  *      R2-PATTERN                                          *
            348  * THE TERMINATION CHARACTER DETERMINES THE SEARCH          *
            349  * INCREMENT.                                               *
            350  *      CARRAIGE RETURN - WORD                              *
            351  *      MINUS SIGN      - BYTE                              *
            352  *                                                          *
            353  ************************************************************
            354  *
014E 0206   355  F      LI   R6,SKIP2-SKIP11/2-1+>1600  JUMP NOT EQUAL
0150 1603 
0152 0203   356  FIND   LI   R3,>8402          LOAD COMPARE- C  R2,*R0
0154 8402 
0156 0204   357         LI   R4,>5C0           LOAD - INCT  R0
0158 05C0 
015A 9685   358         CB   R5,*R10           TCHAR='CR'?
015C 1306   359         JEQ  SKIP0             YES,LEAVE AS C, INCT
015E 0223   360         AI   R3,>1000          CHANGE TO- CB
0160 1000 
0162 0224   361         AI   R4,->40           CHANGE TO- INC
0164 FFC0 
0166 0A82   362         SLA  R2,8              ALIGN PATTERN
0168 1005   363         JMP  SKIP1
016A 4008   364  SKIP0  SZC  R8,R0
016C 4048   365         SZC  R8,R1
016E 1002   366         JMP  SKIP1
0170 C1C7   367  NXTBLK MOV  R7,R7             DONE 4 ADDRESSES?
0172 1603   368         JNE  NOCRTN            NO - JUMP

             23  *
             24         COPY 'MACRO.INC'            
              1C *
              2C *  DEFINE A MACRO TO GO THE 'READ Gs' ETC. INSTRUCTIONS
              3C *  WHERE THE RESULTING OPCODE WILL BE OF THE FORM
              4C *
              5C *        0 0 0 0   1 1 1 X   X X X X   X X X X
              6C *                       |  N    | Ts |   Rs    |
              7C *
              8C *    WNBL      N=0
              9C *    RHXW      N=1
             10C *    WHXW      N=2
             11C *    EKO       N=3
             12C *    WRIT      N=4
             13C *    READ      N=5
             14C *    MSG       N=6
             15C *    BKPT      N=7
             16C *
             17C *
             18C *     NOTE : IF THE OPERAND IS INDEXED THEN THE CORRECT
             19C *            CODE IS GENERATED BUT SDSMAC WILL ALSO ERROR
             20C *            IT.
             21C *
             22C Z$$Z$$ $MACRO P1,O
             23C *     DEFINE THE REQUIRED DATA PASSED THE BASE OPCODE
             24C *     AND THE OPERAND.
             25C        $VAR T
             26C        $ASG P1 TO T
             27C *   IS IT INDEXED
             28C    $IF  P1.A&$PNDX
             29C        $ASG O.V+>20 TO O.V
             30C        $ASG :O.V:'+R':P1.V:',':P1.S: TO T.S
             31C        DATA :T.S:              INDEX
             32C        $EXIT
             33C    $ENDIF
             34C *   NO , IS IT SYMBOLIC ?
             35C    $IF  P1.A&$PSYM
             36C        $ASG O.V+>20 TO O.V
             37C        $ASG :O.V:',':P1.S: TO T.S
ASM990 2.4.6     MONITOR                    Sun Jul 20 19:28:48 2025 Page 0002
DEBUG MONITOR - CORTEX BASIC REV. 1.1

             38C        DATA :T.S:              SYMBOLIC
             39C        $EXIT
             40C    $ENDIF
             41C *   NO , IS IT INDIRECT
             42C    $IF  P1.A&$PIND
             43C        $ASG O.V+>10 TO O.V
             44C        $ASG :O.V:'+R':P1.V: TO T.S
             45C        DATA :T.S:             INDIRECT
             46C        $EXIT
             47C    $ENDIF
             48C *   NO , IS IT INDIRECT AUTOINCREMENT
             49C    $IF P1.A&$PATO
             50C        $ASG O.V+>30 TO O.V
             51C        $ASG :O.V:'+R':P1.V: TO T.S
             52C        DATA :T.S:             AUTOINC
             53C        $EXIT
             54C    $ENDIF   
             55C *   NO IT MUST BE REGISTER THEN
             56C        $ASG :O.V:'+R':P1.V: TO T.S
             57C        DATA :T.S:             REGISTER
             58C    $END            END OF INTERNAL MACRO 'Z$$Z$$'
             59C *
             60C *    DEFINE UTILITY MACRO'S
             61C *
             62C WNBL   $MACRO P2
             63C        Z$$Z$$ :P2.S:,>0E00        WRITE HEX NIBBLE
             64C        $END
             65C RHXW   $MACRO P2
             66C        Z$$Z$$ :P2.S:,>0E40        READ HEX WORD
             67C        $END
             68C WHXW   $MACRO P2
             69C        Z$$Z$$ :P2.S:,>0E80        WRITE HEX WORD
             70C        $END
             71C EKO    $MACRO P2
             72C        Z$$Z$$ :P2.S:,>0EC0        ECHO CHARACTER  
             73C        $END
             74C WRIT   $MACRO P2
             75C        Z$$Z$$ :P2.S:,>0F00        WRITE CHARACTER
             76C        $END
             77C READ   $MACRO P2
             78C        Z$$Z$$ :P2.S:,>0F40        READ CHARACTER
             79C        $END
             80C MSG    $MACRO P2
             81C        Z$$Z$$ :P2.S:,>0F80        OUT MESSAGE
             82C        $END
             83C BKPT   $MACRO P2
             84C        Z$$Z$$ :P2.S:,>0FC0        BREAKPOINT      
             85C        $END
             86C *
             87C *    END OF MACRO DEFINITIONS
             88C *

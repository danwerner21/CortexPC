           1642  *
           1643  * ROUTINE FOR PRINTING THE CRU BIT DISPLACEMENT AS
           1644  *      A SIGNED DECIMAL NUMBER (127 TO -128)
           1645  *
091A 0203  1646  BITFMT LI   R3,'-1'           ASCII DATA FOR MINUS AND ONE
091C 2D31 
091E 06C1  1647         SWPB R1                ISOLATE BIT DISPLACEMENT
0920 0881  1648         SRA  R1,8               AND SIGN EXTEND
0922 1315  1649         JEQ  BIT5              JUMP IF ZERO
0924 1502  1650         JGT  BIT1              JUMP IF POSITIVE
0926       1651         WRIT R3                OTHERWISE PRINT MINUS SIGN
0928 0501  1652         NEG  R1                AND MAKE POSITIVE
092A 0281  1653  BIT1   CI   R1,100            ONE HUNDRED OR GREATER?
092C 0064 
092E 1104  1654         JLT  BIT2              NO, JUMP
0930 0A83  1655         SLA  R3,8              MOVE OVER ASCII ONE
0932       1656         WRIT R3                PRINT A ONE
0934 0221  1657         AI   R1,-100           SUBTRACT 100 FROM DISPLACEMENT
0936 FF9C 
0938 0204  1658  BIT2   LI   R4,10             LOAD DIVISOR
093A 000A 
093C C081  1659         MOV  R1,R2             RIGHT JUSTIFY DISPLACEMENT
093E 04C1  1660         CLR  R1                 IN REG PAIR 1 AND 2
0940 3C44  1661         DIV  R4,R1             DIVIDE BY TEN
0942 0A83  1662         SLA  R3,8              WAS ONE HUNDRED PRINTED?
0944 1302  1663         JEQ  BIT3              YES, PRINT BOTH TENS AND ONES
0946 C041  1664         MOV  R1,R1             NO, THEN TEST TENS VALUE
0948 1301  1665         JEQ  BIT4              IF ZERO PRINT ONLY ONES
094A 0699  1666  BIT3   BL   *R9               PRINT TENS DIGIT
094C C042  1667  BIT4   MOV  R2,R1             LOAD ONES DIGIT
094E 0699  1668  BIT5   BL   *R9               PRINT ONES DIGIT
ASM990 2.4.6     MONITOR                    Sun Jul 20 19:28:48 2025 Page 0045
UNASSEMBLER FOR LOBUG. MJS & CRH

           1670  *
           1671  * COMMAND SCANNER: TWO MODES
           1672  *   1) DUMP MODE:  DISASSEMBLES FROM START TO END
           1673  *        ADDRESS.
           1674  *   2) SINGLE STEP MODE:  AT THE END OF EACH LINE,
           1675  *     A) ESCAPE CAUSES A RETURN TO LOBUG CMD SCANNER
           1676  *     B) ANY OTHER CHARACTER CONTINUES DIS-ASSEMBLY AT THE
           1677  *        NEXT INSTRUCTION
           1678  *
0950 C145  1679  CMDSCN MOV  R5,R5             TEST FOR DUMP MODE
0952 1608  1680         JNE  CMD5               Y,GO TO DUMP HANDLER
           1681  *
0954       1682         MSG  @SPACE2           OUTPUT TWO SPACES
0958       1683  CMD2   READ R12
095A 028C  1684         CI   R12,>1B00         ESCAPE?
095C 1B00 
095E 1304  1685         JEQ  CMD6               Y, EXIT DISASSEMBLER
0960 0460  1686  CMD4   B    @BEGIN            CONTINUE DISASSEMBLY
0962 0834'
           1687  *
0964 8140  1688  CMD5   C    R0,R5             TEST DUMP END ADDRESS
0966 12FC  1689         JLE  CMD4               N, CONTINUE DISASSEMBLY
0968 0380  1690  CMD6   RTWP                    Y, EXIT DISASSEMBLER
ASM990 2.4.6     MONITOR                    Sun Jul 20 19:28:48 2025 Page 0046
UNASSEMBLER FOR LOBUG. MJS & CRH

           1692  *
           1693  * SUBROUTINE WHICH PRINTS THE DECIMAL VALUE OF
           1694  *      THE LOWER FOUR BITS OF REGISTER 1
           1695  *
096A C0C1  1696  REGNO  MOV  R1,R3             MOVE DATA FROM R1 TO R3 AND
096C 0AC3  1697         SLA  R3,12              ISOLATE LOWER 4 BITS RIGHT
096E 0943  1698         SRL  R3,4               JUSTIFIED IN UPPER BYTE
0970 0283  1699         CI   R3,>900           COMPARE TO NINE
0972 0900 
0974 1203  1700         JLE  REG1              EQUAL OR LESS, SINGLE DIGIT
0976 06C3  1701         SWPB R3                OTHERWISE TWO DIGITS
0978 0223  1702         AI   R3,>0126          BCD CORRECT ONES, MAKE ASCII
097A 0126 
097C 0223  1703  REG1   AI   R3,>3000          MAKE UPPER BYTE ASCII
097E 3000 
0980       1704  REG2   WRIT R3                PRINT ASCII NUMBER
0982 0A83  1705         SLA  R3,8              CHECK FOR SECOND DIGIT
0984 16FD  1706         JNE  REG2              IF THERE, PRINT IT
0986 045B  1707  REGRTN RT                     RETURN
           1708  *
           1709  * SUBROUTINE TO HANDLE THE MULTIPLE ADDRESSING MODES:
           1710  *      WORKSPACE REGISTER
           1711  *      WORKSPACE REGISTER INDIRECT
           1712  *      SYMBOLIC AND INDEXED
           1713  *      WORKSPACE REG. INDIRECT AUTO INCREMENT
           1714  *
0988 0204  1715  AMODE  LI   R4,'*R'           ACSII DATA FOR REG FORMATS
098A 2A52 
098C C081  1716         MOV  R1,R2             GET OP CODE AND
098E 0AA2  1717         SLA  R2,10              ISOLATE ADDR MODE (T) FIELD
0990 09E2  1718         SRL  R2,14              RIGHT JUSTIFIED IN R2
           1719  *
           1720  *      WORKSPACE REGISTER
           1721  *
0992 1603  1722         JNE  AMD2              JUMP IF T FIELD NOT ZERO
0994 06C4  1723  AMD1   SWPB R4                PUT ASCII "R" IN UPPER BYTE
0996       1724         WRIT R4                PRINT "R"
0998 10E8  1725         JMP  REGNO             PRINT REG. NO. AND RETURN
           1726  *
           1727  *      WORKSPACE REGISTER INDIRECT
           1728  *
099A 0602  1729  AMD2   DEC  R2                WAS T FIELD = 1?
099C 1602  1730         JNE  AMD3              NO, JUMP
099E       1731         WRIT R4                PRINT "*"
09A0 10F9  1732         JMP  AMD1              GO HANDLE REG FORMAT
           1733  *
           1734  *      SYMBOLIC AND INDEXED
           1735  *
09A2 0602  1736  AMD3   DEC  R2                WAS T FIELD = 2?
09A4 1610  1737         JNE  AMD6              NO, JUMP
09A6       1738         MSG  @SYMBLC           ASCII DATA FOR SYMBOLIC
09AA       1739         WHXW *R0+              PRINT SYMBOLIC WORD
09AC C081  1740         MOV  R1,R2             GET OP CODE AGAIN AND
09AE 0AC2  1741         SLA  R2,12              CHECK IF REG. NO. IS ZERO
09B0 13EA  1742         JEQ  REGRTN            YES, RETURN
09B2 0202  1743         LI   R2,'()'           NO, INDEXED MODE
09B4 2829 
09B6       1744         WRIT R2                PRINT "("
09B8 06C4  1745  AMD4   SWPB R4                PUT ASCII R IN UPPER BYTE
09BA       1746         WRIT R4                PRINT "R"
ASM990 2.4.6     MONITOR                    Sun Jul 20 19:28:48 2025 Page 0047

SINGLE STEPPING, BKPT ZERO SUBROUTINE

            637  ************************************************************
            638  *                                                          *
            639  * SINGLE STEP COMMAND -- 'S'                               *
            640  *                                                          *
            641  *    THE SINGLE STEP ENTRY HAS BEEN MODIFIED TO ALLOW FOR  *
            642  * MULTIPLE STEPPING.  IT REQUIRES AN ENTRY WHILE IN THE    *
            643  * SCANNER.                                                 *
            644  *                                                          *
            645  ************************************************************
            646  *
02D2 0207   647  S      LI   R7,>9999          SET CODE
02D4 9999 
02D6 0603   648         DEC  R3                STEP TO VALUE?
02D8 1504   649         JGT  VALADR            YES, JUMP
            650  *
02DA 0647   651         DECT R7                NEXT CODE (>9997)
02DC 0280   652         CI   R0,>80            STEPS OR MEM ADR?
02DE 0080 
02E0 1A02   653         JL   SINGLE            STEPS - JUMP
            654  *
            655  * STEP UNTIL MEMORY ADDRESS CONTAINS VALUE
            656  *
02E2 4008   657  VALADR SZC  R8,R0             WORD ALIGN ADDRESS
02E4 1003   658         JMP  STEP              GO TO STEPPER
            659  *
            660  *  SINGLE/MULTIPLE STEPS
            661  *
02E6 0647   662  SINGLE DECT R7                NEXT CODE (>9995)
02E8        663  LDCNT  MSG  *R10              GO TO NEW LINE
02EA 0600   664  DECSTP DEC  R0                COUNTING REGISTER
02EC 03E0   665  STEP   LREX                   INITIATE THE LOAD VECTOR
02EE 0380   666  GO     RTWP                   GOTO USER PROGRAM
            667  *
02F0 C000   668  STPCHK MOV  R0,R0             DONE STEPPING?
02F2 15FB   669         JGT  DECSTP            NO, DECREMENT AND LREX AGAIN
02F4 1073   670         JMP  WPS10             YES, OUTPUT ONCE
            671  **********************************************************
            672  *        USER SUBROUTINE ON BREAKPOINT ZERO              *
            673  **********************************************************
02F6 0690   674  CONTIN BL   *R0               EXECUTE USER ROUTINE
02F8 C7A0   675         MOV  @BPTDTA,*R14      INSERT USER INSTRUCTION
02FA 0000 
02FC C00E   676         MOV  R14,R0            SAVE LOCATION
02FE 0202   677         LI   R2,BPTLOD         GET LOAD ADDRESS
0300 0304'
0302 1045   678         JMP  SETLOD            DO A SINGLE STEP
0304 C420   679  BPTLOD MOV  @COD15,*R0        BREAKPOINT TO RAM
0306 03AA'
0308 0380   680         RTWP

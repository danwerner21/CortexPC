***CRU INSPECT/CHANGE***

            541  ************************************************************
            542  *                                                          *
            543  * CRU INSPECT/CHANGE -- 'C' COMMAND                        *
            544  *                                                          *
            545  * INPUT THE CRU BASE ADDRESS FOLLOWED BY THE BIT COUNT.    *
            546  * ALL INPUT AND OUTPUT TO THE CRU IS RIGHT JUSTIFIED IN    *
            547  * THE 16 BIT INPUT/OUTPUT DATA FIELDS.                     *
            548  *                                                          *
            549  * INPUT OF A CARR. RET. AS A TERMINATION CHARACTER RETURNS *
            550  * CONTROL TO THE COMMAND SCANNER. A ' ' AS TERMINATION     *
            551  * CHARACTER CAUSES THE CRU INPUT BITS TO BE OUTPUT AGAIN   *
            552  * WELL AS THE CRU OUTPUT BITS TO BE CHANGED.               *
            553  *                                                          *
            554  ************************************************************
            555  *
0250 C300   556  C      MOV  R0,R12            UPDATE CRU BASE REGISTER
0252 04C7   557         CLR  R7                RESET WORD FLAG
0254 0AC1   558         SLA  R1,12             ISOLATE BIT COUNT
0256 1303   559         JEQ  SETFG             SET FLAG FOR 16-BIT TRANS.?
0258 0281   560         CI   R1,>9000          BYTE JUSTIFIED I/O?
025A 9000 
025C 1A01   561         JL   CSKIP1            YES, SKIP
025E 0587   562  SETFG  INC  R7                WORD JUSTIFIED I/O FLAG
            563  *
            564  * FORM 'STCR' COMMAND AND READ CRU
            565  *
0260 0961   566  CSKIP1 SRL  R1,6              POSITION BIT COUNT
0262 0208   567  CLOOP  LI   R8,>3404          'STCR R4' OP CODE
0264 3404 
0266 E201   568         SOC  R1,R8             COMBINE WITH BIT COUNT
0268 0488   569         X    R8                EXECUTE 'STCR'
            570  *
            571  * OUTPUT STATE OF CRU
            572  *
026A        573         MSG  *R10              NEXT LINE
026C        574         WHXW R12               PRINT BASE ADDRESS
026E        575         MSG  @EQUSGN           PRINT '='
0272 C1C7   576         MOV  R7,R7             WORD I/O?
0274 1601   577         JNE  CSKIP2            YES, SKIP ALIGN
0276 0984   578         SRL  R4,8              ALIGN BYTE INPUT TO WORD
0278        579  CSKIP2 WHXW R4                PRINT CRU DATA
027A        580         MSG  *R9               DOUBLE SPACE
            581  *
            582  * ACCEPT INPUT FOR ALTERATION OF CRU
            583  *
027C        584         RHXW R4                CRU OUTPUT?
027E 028E'  585         DATA CNULL,ERR2
0282 C1C7   586         MOV  R7,R7             WORD I/O?
0284 1601   587         JNE  CSKIP3            YES, SKIP ALIGN
0286 0A84   588         SLA  R4,8              ALIGN BYTE FOR OUTPUT
0288 0248   589  CSKIP3 ANDI R8,>F3FF          CHANGE 'STCR' TO 'LDCR'
028A F3FF 
028C 0488   590         X    R8                EXECUTE 'LDCR'
028E 9685   591  CNULL  CB   R5,*R10           EXIT?
0290 16E8   592         JNE  CLOOP             NO LOOP
0292 045B   593         RT                     EXIT TO MONITOR

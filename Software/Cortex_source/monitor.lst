            214  * ICOUNT SPECIFIES NUMBER OF HEX INPUT FIELDS
            215  *
009E 0986   216         SRL  R6,8              ALIGN ICOUNT
00A0 02A7   217         STWP R7                POINT TO R0
00A2 0916   218  INLOOP SRL  R6,1              DONE?
00A4 1707   219         JNC  CEXIT             YES, TO COMMAND PROCESSOR
00A6        220         RHXW R4                ACCEPT HEX ENTRY
00A8 00C4'  221         DATA NULL,ERR2
00AC CDC4   222         MOV  R4,*R7+           SAVE HEX INPUT VIA POINTER
00AE 0583   223  CNT    INC  R3                COUNT THE NUMBER OF ENTRIES
00B0 9685   224         CB   R5,*R10           END OF INPUT?
00B2 16F7   225         JNE  INLOOP            YES, TO COMMAND PROCESSOR

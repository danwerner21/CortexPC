***CHARACTER ECHO***

            855  ************************************************************
            856  *                                                          *
            857  * ECHO A CHARACTER TO THE TERMINAL (EKO)    **USES EREGS** *
            858  *                                                          *
            859  * --WARNING-- SYSTEM FLAGS ARE KEPT IN R0-R7 OF EREGS      *
            860  *                                                          *
            861  *      CALLING SEQUENCE:      EKO   Register               *
            862  *                                                          *
            863  *      RETURN                 RTWP                         *
            864  *                                                          *
            865  * THE CHARCTER IS RETURNED IN THE MOST SIGNIFICANT BYTE    *
            866  *  OF THE REGISTER WITH THE LOWER BYTE ZEROED.             *
            867  ************************************************************
            868  *
042A        869  ECHOEN READ *R11              READ CHARACTER
042C        870         WRIT *R11              ECHO THE CHARACTER
042E 0380   871         RTWP
            872  *
ASM990 2.4.6     MONITOR                    Sun Jul 20 19:28:48 2025 Page 0025
***READ CHARACTER***

            875  ************************************************************
            876  * READ CHARACTER  (READ)      ** USES IREGS **             *
            877  *                                                          *
            878  *   CALLING SEQUENCE:         READ   Register              *
            879  *                                                          *
            880  *   RETURN                    RTWP                         *
            881  *                                                          *
            882  * READ WAITS FOR A CHARACTER TO BE ASSEMBLED IN            *
            883  * THE UART. THE CHARACTER IS PLACED IN THE LEFT            *
            884  * BYTE OF USER REGISTER. THE RIGHT BYTE IS ZEROED          *
            885  *                                                          *
            886  ************************************************************
            887  *
0430 C300   888  RENTRY MOV  R0,R12            SAVE R0
0432 0000   889         DATA GETCR$            GET A CHARACTER
0434 C6C0   890         MOV  R0,*R11           RETURN CHARACTER TO CALLER
0436 C00C   891         MOV  R12,R0            RESTORE R0
0438 0380   892         RTWP                   EXIT
            893  *
ASM990 2.4.6     MONITOR                    Sun Jul 20 19:28:48 2025 Page 0026
WRITE

            896  ************************************************************
            897  * WRITE CHARACTER  (WRIT)     ** USES IREGS **             *
            898  *                                                          *
            899  *   CALLING SEQUENCE:         WRIT   Register              *
            900  *                                                          *
            901  *   RETURN:                   RTWP                         *
            902  *                                                          *
            903  * TRANSMIT THE CHARACTER IN THE LEFT BYTE OF THE USER      *
            904  * REGISTER.   IF THE CHARACTER IS A CARRIAGE RETURN, AND   *
            905  * THE BAUD RATE IS 1200 OR LESS, THE ROUTINE DELAYS 200MS  *
            906  * TO ALLOW THE CARRIAGE TO RETURN.                         *
            907  *     IF THE TERMINAL IS A 733 ASR, THEN EACH CHARACTER    *
            908  * IS PADDED WITH 25 MSEC TO REDUCE THE TRANSFER RATE TO    *
            909  * 300 BAUD.                                                *
            910  *    NOTE THAT EACH TIME A CARRIAGE RETURN IS OUTPUT, A    *
            911  * TEST IS MADE TO SEE IF AN 'ESCAPE' HAS BEEN RECEVIED.    *
            912  * IF IT HAS, THEN CONTROL IS RETURNED TO THE COMMAND       *
            913  * SCANNER.  USER PROGRAMMES REQUIRING AN 'ESCAPE' INPUT    *
            914  * INTO THEM SHOULD THEREFORE AVOID USING THIS XOP IF       *
            915  * INPUT IS REQUIRED WHILST OUTPUTTING.                     *
            916  ************************************************************
            917  *
043A C300   918  WENTRY MOV  R0,R12            SAVE R0
043C D01B   919         MOVB *R11,R0           FETCH BYTE TO BE SENT
043E 0000   920         DATA TYP0$             SEND IT
            921  *
0440 981B   922         CB   *R11,@B0D         'CR' ?
0442 0000 
0444 1602   923         JNE  W40               N, EXIT
0446 0420   924         BLWP @HALTO$           Y, CHECK FOR HALT OUTPUT
0448 0000 
044A C00C   925  W40    MOV  R12,R0            RESTORE R0
044C 0380   926         RTWP                   N, EXIT
ASM990 2.4.6     MONITOR                    Sun Jul 20 19:28:48 2025 Page 0027
***ASCII MESSAGE OUTPUT***

            929  ************************************************************
            930  *                                                          *
            931  * MESSAGE OUTPUT  (MSG)       ** USES XREGS **             *
            932  *                                                          *
            933  *    CALLING SEQUENCE:        MSG   @Message Address       *
            934  *                                                          *
            935  *    RETURN                   RTWP                         *
            936  *                                                          *
            937  * THE ASCII STRING POINTED TO BY MESSAGE ADDRESS IS        *
            938  * OUTPUT UNTIL A ZERO BYTE IS ENCOUNTERED.                 *
            939  *                                                          *
            940  ************************************************************
            941  *
044E        942  MLOOP  WRIT R12               O/P THE CHARACTER
0450 D33B   943  MENTRY MOVB *R11+,R12         GET CHARACTER
0452 16FD   944         JNE  MLOOP             IF NOT ZERO, LOOP BACK
0454 0380   945         RTWP                   RETURN
            946  *

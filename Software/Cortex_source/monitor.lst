            454  ************************************************************
            455  *                                                          *
            456  * INSPECT/CHANGE USER WORKSPACE REGISTER -- 'W' COMMAND    *
            457  *                                                          *
            458  * OPTIONS: 1) 'W' FOLLOWED BY CARRIAGE RETURN --           *
            459  *              DISPLAY THE CONTENTS OF ALL CURRENT USER    *
            460  *              WORKSPACE REGISTERS AND RETURN TO THE       *
            461  *              COMMAND SCANNER.                            *
            462  *                                                          *
            463  *          2) 'W', REGISTER NUMBER IN HEX, CARRIAGE        *
            464  *              RETURN -- DISPLAY THE CONTENTS OF THE       *
            465  *              DESIGNATED REGISTER. USER MAY ALTER         *
            466  *              THE CONTENTS FOLLOWED BY A TERMINATION      *
            467  *              CHARACTER OR MERELY ENTER A TERMINATION     *
            468  *              CHARACTER. THE TERMINATION CHARACTER        *
            469  *              SIGNIFIES WHAT IS TO BE DONE NEXT:          *
            470  *                                                          *
            471  *     SPACE -- DISPLAY THE CONTENTS OF THE NEXT REG.       *
            472  *     MINUS -- DISPLAY THE CONTENTS OF THE PREVIOUS REG.   *.
            473  *     CARRIAGE RETURN -- TO THE COMMAND SCANNER.           *
            474  *                                                          *
            475  * NOTE THAT THIS ROUTINE IS ALSO USED BY THE INSPECT/CHANGE*
            476  * BREAKPOINTS.                                             *
            477  ************************************************************
01DE 0207   478  B      LI   R7,BPTADD         SET UP POINTER
01E0 00D8'
01E2 0208   479         LI   R8,SPBP           SET UP BREAKPOINT INITIALS
01E4 0000 
01E6 1003   480         JMP  BPOINT            USE THE INS/CH WS REGR ROUTINE
            481  *
01E8 C1CD   482  W      MOV  R13,R7            GET WORKSPACE POINTER
01EA 0208   483         LI   R8,SPR            SET TO PRINT ' R'
01EC 0000 
01EE C0C3   484  BPOINT MOV  R3,R3             NULL INPUT?
01F0 1321   485         JEQ  WNULL1            YES, TO FORMATTED DUMP

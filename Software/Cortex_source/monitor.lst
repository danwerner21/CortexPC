***HEX INPUT***

            949  ************************************************************
            950  * HEX INPUT ROUTINE  (RHXW)                                *
            951  *                                                          *
            952  *     CALLING SEQUENCE:       RHXW    @Register no.        *
            953  *                             DATA    NULL                 *
            954  *                             DATA    ERROR                *
            955  *     RETURN                  RTWP                         *
            956  *                                                          *
            957  * RETURNS A 16-BIT NUMBER INPUT FROM TERMINAL. DIGITS      *
            958  * ARE ACCEPTED UNTIL A TERMINATION CHARACTER IS FOUND.     *
            959  *                                                          *
            960  * TERMINATION CHARACTERS: SPACE, COMMA, CAR. RETURN, MINUS *
            961  * THE TERMINATION CHARACTER IS RETURNED IN THE LEFT        *
            962  * BYTE OF THE REGISTER FOLLOWING 'R'.                      *
            963  *                                                          *
            964  * RETURN IS TO THE NULL RETURN ADDRESS IF INPUT IS         *
            965  * A TERMINATION CHARACTER ONLY. (Rn IS UNCHANGED)          *
            966  *                                                          *
            967  * IF A FAULTY TERMINATION CHARACTER IS FOUND,              *
            968  * RETURN IS TO THE ERROR ENTRY. (Rn,Rn+1 ARE UNCHANGED)    *
            969  ************************************************************
            970  *
0456 04C9   971  RHENTY CLR  R9                RESET NUMBER INPUT FLAG
0458 04CC   972         CLR  R12               CLEAR ACCUMULATOR
045A        973  LOOP   EKO  R10               GET A CHARACTER INPUT
            974  *
            975  * CHECK FOR VALID HEX INPUT
            976  *
045C 028A   977         CI   R10,'0'*256       MIN NUMERIC
045E 3000 
0460 1A11   978         JL   NOTHEX
0462 028A   979         CI   R10,'9'*256       MAX NUMERIC
0464 3900 
0466 1208   980         JLE  GOTONE
0468 028A   981         CI   R10,'A'*256       MIN ALPHA
046A 4100 
046C 1A0B   982         JL   NOTHEX
046E 028A   983         CI   R10,'F'*256       MAX ALPHA
0470 4600 
0472 1B08   984         JH   NOTHEX
0474 022A   985         AI   R10,>900          ALPHA ADJUST
0476 0900 
0478 0A4A   986  GOTONE SLA  R10,4             ISOLATE DIGIT
047A 09CA   987         SRL  R10,12            WORD ALIGN DIGIT
            988  *
            989  * DIGIT TO ACCUMULATOR
            990  *
047C 0A4C   991         SLA  R12,4
047E A30A   992         A    R10,R12
0480 0589   993         INC  R9                SET INPUT FLAG
0482 10EB   994         JMP  LOOP
            995  *
            996  * CHECK FOR TERMINATION CHARACTER
            997  *
0484 028A   998  NOTHEX CI   R10,' '*256       ' '?
0486 2000 
0488 130B   999         JEQ  SPCK
048A 028A  1000         CI   R10,'-'*256       '-'?
048C 2D00 
048E 1308  1001         JEQ  SPCK

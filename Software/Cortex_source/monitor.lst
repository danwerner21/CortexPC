01F8 0A10   491         SLA  R0,1
01FA A1C0   492         A    R0,R7             FORM R/BPT ADDRESS
01FC        493  ICLOOP MSG  *R10              NEXT LINE
01FE        494         MSG  *R8
0200        495         WNBL R6                OUTPUT R/BPT NUMBER
0202        496         MSG  @EQUSGN           PRINT '='
0206 C117   497         MOV  *R7,R4
0208        498         WHXW R4                PRINT RR/BPT CONTENTS
020A        499         WRIT *R9               DELIMITER
020C        500         RHXW R4                NEW CONTENTS?
020E 0214'  501         DATA WNULL2,ERR2
0212 C5C4   502         MOV  R4,*R7            UPDATE R/BPT
0214 9685   503  WNULL2 CB   R5,*R10           RETURN TO COMMAND SCANNER?

            202  *
            203  * COMMAND SEARCH ROUTINE
            204  *
008C 022B   205  SRCHLP AI   R11,3             UPDATE POINTER
008E 0003 
0090 C1DB   206  SRCH   MOV  *R11,R7           SEARCH FAIL?
0092 132C   207         JEQ  ERR4              YES, ERROR
0094 917B   208         CB   *R11+,R5          DOES INPUT MATCH A TABLE ENTRY
0096 16FA   209         JNE  SRCHLP            NO, TRY NEXT TABLE ENTRY
0098        210         WRIT R5
009A        211         WRIT *R9
009C D1BB   212         MOVB *R11+,R6          NUMBER OF HEX INPUTS TO ICOUNT
